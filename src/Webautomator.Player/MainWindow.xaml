<Window x:Class="Webautomator.Player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Style="{StaticResource DsWindow}"
        Title="Webautomator Player"
        Height="720" Width="1120" MinHeight="560" MinWidth="900"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/webautomator-icon.jpg">
  <WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" CornerRadius="12" GlassFrameThickness="0"
                        ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!--
      The app's own title bar, drawn on the gradient. WindowStyle is None (set by the DsWindowChrome
      style) so the system frame — and with it the default close button and grey border — is gone;
      this is what replaces it. CaptionHeight is 0 by design, so the bar itself has to be draggable:
      the MouseLeftButtonDown handler calls DragMove, which is also why the buttons inside it must
      handle their own clicks (a Button swallows the mouse-down, so a press on it does not drag).
    -->
    <Style x:Key="DsTitleBar" TargetType="Border">
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="CornerRadius" Value="12,12,0,0"/>
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7D71F5" Offset="0"/>
            <GradientStop Color="#5B4FD6" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource DsCanvasBrush}" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Title bar: identity on the start side, window controls on the end side. -->
      <Border Grid.Row="0" Style="{StaticResource DsTitleBar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/webautomator-icon.jpg" Width="26" Height="26"
                   Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="ProductNameText" FontFamily="{StaticResource DsFontBold}" FontSize="15"
                       Foreground="White" VerticalAlignment="Center" Text="Webautomator Player"/>
          </StackPanel>

          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Minimise is omitted deliberately; the close button is the only one the product needs. -->
            <Button x:Name="CloseButton" Style="{StaticResource DsCaptionCloseButton}"
                    Click="Close_Click" ToolTip="بستن" Foreground="White">
              <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Body -->
      <Grid Grid.Row="1" Margin="14,10,14,0">
        <!-- Login panel -->
        <Border x:Name="LoginPanel" Style="{StaticResource DsCard}" VerticalAlignment="Center"
                MaxWidth="400" HorizontalAlignment="Center" Padding="0">
        <Grid>
        <!--
          Split banner + form rather than one column: the identity block answers "what am I signing
          into" before the user commits, and the form below stays a single short column, which is
          what keeps the card compact on a minimised window.
        -->
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="14,14,0,0" Padding="24,20">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#7D71F5" Offset="0"/>
              <GradientStop Color="#5B4FD6" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <StackPanel HorizontalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/webautomator-icon.jpg" Width="52" Height="52"
                   RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,10"/>
            <TextBlock x:Name="LoginProductName" FontFamily="{StaticResource DsFontBold}" FontSize="18"
                       Foreground="White" HorizontalAlignment="Center" Text="Webautomator Player"/>
            <TextBlock Foreground="#E4E1FB" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"
                       Text="اجرای فرآیندها روی همین سیستم"/>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,22,24,24">
          <TextBlock Style="{StaticResource DsHint}" TextAlignment="Center" Margin="0,0,0,18"
                     Text="برای ورود، مرورگر باز می‌شود و پس از احراز هویت به این برنامه بازمی‌گردید."/>

          <Button x:Name="BrowserLoginButton" Style="{StaticResource DsBrandButton}"
                  Click="BrowserLogin_Click" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="ورود با مرورگر" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!-- The address is shown, never asked for: it comes from the licence or the download. -->
          <Border Style="{StaticResource DsSoftPanel}" Margin="0,0,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource DsHint}" FontSize="11" Text="آدرس سرور"/>
              <TextBlock x:Name="ServerLabel" FontSize="12.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                         Foreground="{StaticResource DsInkBrush}"/>
            </StackPanel>
          </Border>

          <TextBlock x:Name="LoginStatus" Style="{StaticResource DsHint}" Margin="0,14,0,0"
                     TextAlignment="Center" Foreground="{StaticResource DsDangerBrush}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Process list -->
    <Border x:Name="ProcessPanel" Style="{StaticResource DsCard}" Visibility="Collapsed">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
          <Button x:Name="LogoutButton" DockPanel.Dock="Left" Style="{StaticResource DsButtonGhost}"
                  Content="خروج" Click="Logout_Click"/>
          <Button x:Name="RefreshButton" DockPanel.Dock="Left" Style="{StaticResource DsButtonSecondary}"
                  Content="بازخوانی" Margin="0,0,8,0" Click="Refresh_Click"/>
          <TextBlock x:Name="WhoamiText" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Foreground="{StaticResource DsMutedBrush}" Text=""/>
        </DockPanel>

        <TextBlock x:Name="ListStatus" Grid.Row="1" Style="{StaticResource DsHint}" Margin="0,0,0,8"/>

        <DataGrid x:Name="ProcessGrid" Grid.Row="2" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="2*"/>
            <DataGridTextColumn Header="گروه" Binding="{Binding GroupsLabel}" Width="60"/>
            <DataGridTextColumn Header="مرحله" Binding="{Binding StepsLabel}" Width="60"/>
            <DataGridTextColumn Header="منبع" Binding="{Binding SourcesLabel}" Width="60"/>
            <DataGridTextColumn Header="آخرین اجرا" Binding="{Binding LastRunLabel}" Width="140"/>
            <DataGridTemplateColumn Header="اجرا" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding RunOnServer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Content="روی سرور" VerticalAlignment="Center" Margin="6,0"
                            ToolTip="روشن: اجرا روی سرور ثبت می‌شود. خاموش: اجرا کامل روی همین سیستم."/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="عملیات" Width="230">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="اجرا" Style="{StaticResource DsButton}" Padding="10,4" Margin="2,0"
                            Click="RowRun_Click"/>
                    <Button Content="ویرایش" Style="{StaticResource DsButtonSecondary}" Padding="10,4" Margin="2,0"
                            Click="RowEdit_Click"/>
                    <Button Content="سینک" Style="{StaticResource DsButtonSecondary}" Padding="10,4" Margin="2,0"
                            Visibility="{Binding SyncVisibility}" Click="RowSync_Click"
                            ToolTip="نتیجهٔ اجرای محلی را روی سرور بنویس"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
      </Grid>

    <!-- Footer: licence state + updates -->
    <StackPanel Grid.Row="2" Margin="14,10,14,14">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="LicenseText" Style="{StaticResource DsHint}" VerticalAlignment="Center"/>
        <Button x:Name="DriverCheckButton" Style="{StaticResource DsButtonGhost}" Content="بررسی پیش‌نیازها"
                Margin="12,0,0,0" Click="DriverCheck_Click"/>
        <Button x:Name="UpdateButton" Style="{StaticResource DsButtonGhost}" Content="بررسی به‌روزرسانی"
                Margin="8,0,0,0" Click="CheckUpdate_Click"/>
      </StackPanel>
      <!--
        The server this copy talks to, always visible in the footer. One machine can carry several
        players bound to different servers, so "which server is this one?" has to be answerable at a
        glance rather than inferred from the window title — which carries the brand, not the host.
      -->
      <TextBlock x:Name="ServerFooterText" Style="{StaticResource DsHint}" Margin="0,6,0,0"
                 TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="30000"/>
      <TextBlock x:Name="UpdateStatus" Style="{StaticResource DsHint}" Margin="0,6,0,0"/>
    </StackPanel>
    </Grid>
  </Border>
</Window>
