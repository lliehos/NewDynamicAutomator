<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Webautomator.Player</RootNamespace>
    <AssemblyName>Webautomator.Player</AssemblyName>
    <ApplicationIcon>Assets\webautomator-icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <!--
      The player is published for win-x64 by the web publish (see PublishDesktopPlayer in
      Webautomator.Web.csproj). Listing the RID here is what lets restore produce a win-x64 asset target —
      without it, the publish fails asking for the target it was told to build.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- The product name is not the branding name: the window and title bar take the deployment's
         own app name from the panel (see PlayerIdentity), so this only has to identify the binary. -->
    <Product>Webautomator Player</Product>
    <AssemblyTitle>Webautomator Player</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- The source image is a JPEG (it was misnamed .png, which WPF tolerated but the shell icon
         builder did not). The .ico is a real 4-frame 32bpp icon generated from it. -->
    <Resource Include="Assets\webautomator-icon.jpg" />
    <Resource Include="Assets\webautomator-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The panel's own Persian face, embedded rather than installed. A desktop app that assumed a
         system font rendered correct Persian on the developer's machine and broke everywhere else;
         carrying the same two files the panel ships means the player looks like the panel on any
         Windows install, with no dependency on what the user happens to have. -->
    <Resource Include="Assets\Fonts\Vazir-FD-WOL.ttf" />
    <Resource Include="Assets\Fonts\Vazir-Bold-FD-WOL.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- The license model is shared with the web app, so a signed license means the same thing in
         both and the feature gate cannot drift between them. -->
    <ProjectReference Include="..\Webautomator.Licensing\Webautomator.Licensing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Selenium drives the user's own Firefox. GeckoDriver is version-match free by design (unlike
         ChromeDriver), which is why it is the default driver rather than the only one. -->
    <PackageReference Include="Selenium.WebDriver" Version="4.27.0" />
    <PackageReference Include="Selenium.Support" Version="4.27.0" />
    <!-- The SignalR client lets the server push a new version to a running player instead of the
         player having to poll for one. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.31" />
  </ItemGroup>

</Project>
