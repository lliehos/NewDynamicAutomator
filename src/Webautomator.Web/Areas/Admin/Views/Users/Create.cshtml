@model Webautomator.Domain.Entities.AppUser
@using Webautomator.Web.Areas.Admin.Models
@{
  ViewData["Title"] = L["admin.users.create"];
  var plans = ViewBag.Plans as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
  // No plan picker without licence plan management: the account is placed on the deployment's top
  // level and there is no page that could define a lower one.
  var allowsPlanManagement = TenantBrandingViewDataFilter.AllowsPlanManagement(ViewData);
}
<form method="post" class="admin-form-shell is-2col">
  @Html.AntiForgeryToken()
  <div class="admin-form-card">
    <div asp-validation-summary="All" class="text-danger mb-2"></div>
    <p class="admin-field-hint">@L["admin.users.reservedHint"]</p>
    <div class="mb-2"><label>@L["admin.users.userName"]</label><input class="form-control" name="userName" value="@Model.UserName" required /></div>
    <div class="mb-2"><label>@L["admin.users.password"]</label><input class="form-control" type="password" name="password" required /></div>
    <div class="mb-2"><label>@L["admin.users.firstName"]</label><input class="form-control" name="firstName" value="@Model.FirstName" /></div>
    <div class="mb-2"><label>@L["admin.users.lastName"]</label><input class="form-control" name="lastName" value="@Model.LastName" /></div>
  </div>
  <div class="admin-form-card">
    <div class="mb-2"><label>@L["admin.users.email"]</label><input class="form-control" name="email" type="email" value="@Model.Email" /></div>
    <div class="mb-2"><label>@L["admin.users.nationalId"]</label><input class="form-control" name="nationalId" value="@Model.NationalId" maxlength="20" /></div>
    @if (allowsPlanManagement)
    {
      <div class="mb-2">
        <label>@L["admin.users.plan"]</label>
        <select name="planId" class="form-select">
          <option value="">—</option>
          @if (plans != null)
          {
            foreach (var p in plans)
            {
              if (Model.PlanId?.ToString() == p.Value) { <option value="@p.Value" selected>@p.Text</option> }
              else { <option value="@p.Value">@p.Text</option> }
            }
          }
        </select>
      </div>
    }
    <div class="mb-2">
      <label>@L["admin.users.role"]</label>
      @*
        One switch per role, not a drop-down: an account may carry several roles at once (a process
        manager who also monitors, an admin who also owns templates), and a single-select control
        cannot express that. The Switches share the name "roles", so the POST arrives as one value
        per checked box and binds to string[] on the controller. Enum.GetValues drives the list, so
        adding a role to the enum is enough to offer it; None is skipped because it is not a grant.
      *@
      <div class="d-flex flex-column gap-2 mt-1">
        @foreach (var r in Enum.GetValues<Webautomator.Domain.Enums.UserRole>().Where(x => x != Webautomator.Domain.Enums.UserRole.None))
        {
          <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "roles", Value = r.ToString(), Label = L["admin.users.roles." + r], Checked = r == Webautomator.Domain.Enums.UserRole.User, Id = "roleCreate" + r }' />
        }
      </div>
    </div>
    <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "isActive", Label = L["admin.users.active"], Checked = true, Id = "isActiveCreate", Hint = L["admin.hints.userActive"] }' />
  </div>
  <div class="admin-form-actions" style="grid-column:1/-1">
    <button type="submit" class="btn-admin">@L["admin.common.create"]</button>
    <a class="btn-admin secondary" asp-action="Index">@L["admin.common.back"]</a>
  </div>
</form>
