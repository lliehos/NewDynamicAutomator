@model Webautomator.Web.Areas.Admin.Models.MonitoringViewModel
@{
  Layout = "_Layout";
  ViewData["Title"] = L["admin.monitoring.title"];
  var s = Model.Snapshot;

  // Byte sizes in the unit a person reads at a glance. One helper so every figure on the page
  // rounds the same way.
  string Bytes(long value)
  {
    if (value <= 0) return "—";
    string[] units = { "B", "KB", "MB", "GB", "TB" };
    double v = value; var u = 0;
    while (v >= 1024 && u < units.Length - 1) { v /= 1024; u++; }
    return $"{v:0.#} {units[u]}";
  }

  // A rate reads better with an explicit "/s"; "0 B/s" only when genuinely idle.
  string Rate(long perSec) => perSec <= 0 ? "0 B/s" : $"{Bytes(perSec)}/s";

  string Pct(long value, long max) =>
      (max <= 0 ? 0 : Math.Clamp(100.0 * value / max, 0, 100))
      .ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

  var hours = s.WindowHours;
  var maxNet = s.History.Count > 0 ? Math.Max(1, s.History.Max(p => p.BytesIn + p.BytesOut)) : 1;
  var topUserBytes = s.ByUser.Count > 0 ? Math.Max(1, s.ByUser.Max(u => u.BytesTotal)) : 1;
  var topIpBytes = s.ByIp.Count > 0 ? Math.Max(1, s.ByIp.Max(i => i.BytesTotal)) : 1;
  var windowLabel = hours == 1 ? L["admin.monitoring.h1"]
                  : hours == 6 ? L["admin.monitoring.h6"]
                  : hours == 24 ? L["admin.monitoring.h24"]
                  : hours == 24 * 7 ? L["admin.monitoring.d7"]
                  : L["admin.monitoring.d14"];
  var isFa = Model.IsRtl;
}

@* The chosen window is echoed to the page so the poll below reads the same range the user picked. *@
<script>document.body.setAttribute("data-mon-hours", "@hours");</script>

@* One anti-forgery token for every action on the page: the buttons post with it rather than each
   carrying its own form, because they all act on the same page state. *@
<form id="mon-anti-forgery" class="d-none">@Html.AntiForgeryToken()</form>

<p class="admin-dash-intro">@L["admin.monitoring.intro"]</p>

@* ---- Stop all server-side runs: first on the page, because it is what an operator reaches for
   while something is running away, and because a control found by scrolling is a control found too
   late. ---- *@
<section class="admin-mon-stopall @(s.StopAllServerRuns ? "is-on" : null)">
  <div class="admin-mon-stopall-text">
    <b>@L["admin.monitoring.stopAllTitle"]</b>
    <span class="admin-field-hint">@L["admin.monitoring.stopAllHint"]</span>
  </div>
  <label class="admin-settings-switch" for="mon-stop-all">
    <input type="checkbox" id="mon-stop-all" data-stop-all
           data-confirm="@L["admin.monitoring.stopAllConfirm"]"
           @(s.StopAllServerRuns ? "checked" : null) />
    <span class="admin-settings-switch-track" aria-hidden="true"></span>
  </label>
</section>
@if (s.StopAllServerRuns)
{
  @* Plain, unmissable, and it names the consequence rather than the state: an operator opening this
     page an hour later has to know why nothing is running. *@
  <p class="alert alert-warning admin-mon-alert">
    <i class="ti ti-alert-triangle" aria-hidden="true"></i>
    @L["admin.monitoring.stopAllOn"]
  </p>
}

@* ---- Headline: this application's own traffic ---- *@
<section class="admin-mon-hero">
  <article class="admin-mon-hero-card is-net">
    <div class="admin-mon-hero-head">
      <i class="ti ti-network" aria-hidden="true"></i>
      <span>@L["admin.monitoring.network"]</span>
    </div>
    <div class="admin-mon-hero-main">
      <b data-mon="netIn">@Rate(s.NetworkInPerSec)</b>
      <span class="admin-mon-hero-sub">@L["admin.monitoring.inbound"]</span>
    </div>
    <div class="admin-mon-hero-main is-alt">
      <b data-mon="netOut">@Rate(s.NetworkOutPerSec)</b>
      <span class="admin-mon-hero-sub">@L["admin.monitoring.outbound"]</span>
    </div>
    <div class="admin-mon-hero-foot">
      @L["admin.monitoring.totalSince"]:
      <b data-mon="netTotal">@Bytes(s.NetworkReceivedBytes + s.NetworkSentBytes)</b>
    </div>
    <div class="admin-mon-hero-foot">
      @L.T("admin.monitoring.windowTotal", ("n", windowLabel)):
      <b data-mon="windowTotal">@Bytes(s.WindowBytesIn + s.WindowBytesOut)</b>
    </div>
  </article>

  <article class="admin-mon-hero-card">
    <div class="admin-mon-hero-head">
      <i class="ti ti-activity-heartbeat" aria-hidden="true"></i>
      <span>@L["admin.monitoring.load"]</span>
    </div>
    <div class="admin-mon-hero-main">
      <b data-mon="liveSessions">@s.LiveSessions</b>
      <span class="admin-mon-hero-sub">@L["admin.monitoring.liveSessions"]</span>
    </div>
    <div class="admin-mon-hero-main is-alt">
      <b data-mon="onlineUsers">@s.OnlineUsers</b>
      <span class="admin-mon-hero-sub">@L["admin.monitoring.onlineUsers"]</span>
    </div>
    <div class="admin-mon-hero-foot">
      @L["admin.monitoring.ipsSeen"]: <b data-mon="distinctIps">@s.DistinctIpCount</b>
    </div>
  </article>
</section>

@* ---- Window selector: drives the history AND every per-user/per-address figure ---- *@
<section class="admin-mon-range">
  <span class="admin-field-hint">@L["admin.monitoring.window"]</span>
  <div class="admin-mon-range-btns" role="group" aria-label="@L["admin.monitoring.window"]">
    @foreach (var h in new[] { 1, 6, 24, 24 * 7, 24 * 14 })
    {
      var label = h == 1 ? L["admin.monitoring.h1"]
                 : h == 6 ? L["admin.monitoring.h6"]
                 : h == 24 ? L["admin.monitoring.h24"]
                 : h == 24 * 7 ? L["admin.monitoring.d7"]
                 : L["admin.monitoring.d14"];
      <a class="admin-mon-range-btn @(hours == h ? "is-active" : null)"
         asp-action="Index" asp-route-hours="@h">@label</a>
    }
  </div>
  @if (!s.DatabaseReachable)
  {
    <span class="admin-mon-range-state is-bad">@L["admin.monitoring.dbDown"]</span>
  }
  else
  {
    <span class="admin-mon-range-state">
      @L["admin.monitoring.dbPingShort"]: <b data-mon="dbPing">@s.DatabasePingMs.ToString("0.#") ms</b>
    </span>
  }
</section>

@* ---- The server-run master switch (same setting as Admin → Settings) ---- *@
<section class="admin-mon-serverrun @(Model.ServerRunEnabled ? "is-on" : "is-off")" id="da-mon-serverrun">
  <div class="admin-mon-serverrun-head">
    <i class="ti ti-player-play" aria-hidden="true"></i>
    <span>@L["admin.monitoring.serverRun"]</span>
  </div>
  <div class="admin-mon-serverrun-body">
    <p class="admin-mon-serverrun-hint">
      @(Model.ServerRunEnabled ? L["admin.monitoring.serverRunOnHint"] : L["admin.monitoring.serverRunOffHint"])
    </p>
    @if (Model.CanToggleServerRun)
    {
      <label class="admin-settings-switch">
        <input type="checkbox" id="da-serverrun-toggle" data-da-switch="off"
               data-state="@(Model.ServerRunEnabled ? "1" : "0")" @(Model.ServerRunEnabled ? "checked" : null) />
        <span class="admin-settings-switch-track" aria-hidden="true"></span>
        <span class="admin-settings-switch-text">@L["admin.monitoring.serverRunToggle"]</span>
      </label>
    }
    else
    {
      <span class="admin-mon-serverrun-state">
        @(Model.ServerRunEnabled ? L["admin.monitoring.serverRunEnabled"] : L["admin.monitoring.serverRunDisabled"])
      </span>
    }
  </div>
</section>

@* ---- History: the application's own network traffic over the chosen window ---- *@
<section class="admin-dash-section">
  <div class="admin-dash-section-head">
    <h2><i class="ti ti-chart-histogram" aria-hidden="true"></i>@L["admin.monitoring.history"]</h2>
    <span class="admin-field-hint">@L.T("admin.monitoring.historyHint", ("n", windowLabel))</span>
  </div>

  @if (s.History.Count == 0)
  {
    @* An empty chart is explained rather than drawn as a flat line, because a flat line reads as
       "idle" when the truth is "no samples yet". *@
    <div class="admin-mon-empty">
      <i class="ti ti-clock-hour-4" aria-hidden="true"></i>
      <div>@L["admin.monitoring.noHistory"]</div>
    </div>
  }
  else
  {
    <div class="admin-mon-legend">
      <span class="admin-mon-legend-item is-in"><i></i>@L["admin.monitoring.inbound"]</span>
      <span class="admin-mon-legend-item is-out"><i></i>@L["admin.monitoring.outbound"]</span>
    </div>
    <div class="admin-mon-chart" data-mon-chart="net" aria-hidden="true">
      @foreach (var p in s.History)
      {
        var netInH = Pct(p.BytesIn, maxNet);
        var netOutH = Pct(p.BytesOut, maxNet);
        @* Two stacked bars per sample: inbound over outbound, so the pair reads as one traffic
           column while keeping the two directions distinguishable. *@
        <div class="admin-mon-chart-col" title="@p.AtUtc.ToString("MM-dd HH:mm") — ↓@Bytes(p.BytesIn) ↑@Bytes(p.BytesOut)">
          <span class="admin-mon-chart-in" style="height:@netInH%"></span>
          <span class="admin-mon-chart-out" style="height:@netOutH%"></span>
        </div>
      }
    </div>
  }
</section>

@* ---- Connected users: the traffic each one accounts for, and the two controls on them ---- *@
<section class="admin-dash-section">
  <div class="admin-dash-section-head">
    <h2><i class="ti ti-users" aria-hidden="true"></i>@L["admin.monitoring.byUser"]</h2>
    <span class="admin-field-hint">@L["admin.monitoring.byUserHint"]</span>
  </div>

  @if (s.ByUser.Count == 0)
  {
    <p class="admin-field-hint">@L["admin.monitoring.noUsers"]</p>
  }
  else
  {
    <div class="admin-mon-table-wrap">
      <table class="admin-mon-table">
        <thead>
          <tr>
            <th>@L["admin.monitoring.user"]</th>
            <th>@L["admin.monitoring.ip"]</th>
            <th>@L["admin.monitoring.inbound"]</th>
            <th>@L["admin.monitoring.outbound"]</th>
            <th>@L["admin.monitoring.total"]</th>
            <th>@L["admin.monitoring.serverRuns"]</th>
            <th>@L["admin.monitoring.lastSeen"]</th>
            <th>@L["admin.monitoring.actions"]</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var u in s.ByUser)
          {
            <tr class="@(u.IsOnline ? "is-online" : null)">
              <td>
                <span class="admin-mon-dot @(u.IsOnline ? "is-on" : null)" aria-hidden="true"></span>
                <b>@(u.IsAnonymous ? L["admin.monitoring.anonymous"] : u.UserName)</b>
              </td>
              <td class="admin-mon-ltr">@(string.IsNullOrWhiteSpace(u.Ips) ? "—" : u.Ips)</td>
              <td class="admin-mon-bar-cell">
                <span class="admin-mon-mini"><i style="width:@Pct(u.BytesIn, topUserBytes)%"></i></span>
                <span class="admin-mon-num">@Bytes(u.BytesIn)</span>
              </td>
              <td class="admin-mon-bar-cell">
                <span class="admin-mon-mini"><i style="width:@Pct(u.BytesOut, topUserBytes)%"></i></span>
                <span class="admin-mon-num">@Bytes(u.BytesOut)</span>
              </td>
              <td class="admin-mon-nowrap"><b>@Bytes(u.BytesTotal)</b></td>
              <td>
                @if (u.ActiveRuns > 0)
                {
                  <span class="admin-chip admin-chip-warning">@u.ActiveRuns</span>
                }
                else
                {
                  <span class="admin-mon-num">—</span>
                }
              </td>
              <td class="admin-mon-nowrap">
                @(u.LastSeenUtc is null ? "—" : u.LastSeenUtc.Value.ToLocalTime().ToString("MM-dd HH:mm"))
              </td>
              <td>
                @* Actions are offered for real accounts only: the anonymous row is an aggregate of
                   traffic that has no session to act on. *@
                @if (!u.IsAnonymous)
                {
                  <div class="admin-mon-actions">
                    <button type="button" class="btn-admin secondary icon-only"
                            data-stop-runs="@u.UserId"
                            data-confirm="@L.T("admin.monitoring.stopRunsConfirm", ("user", u.UserName))"
                            title="@L["admin.monitoring.stopRuns"]">
                      <i class="ti ti-player-stop" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="btn-admin danger icon-only"
                            data-close-session="@u.UserId"
                            data-confirm="@L.T("admin.monitoring.closeSessionConfirm", ("user", u.UserName))"
                            title="@L["admin.monitoring.closeSession"]">
                      <i class="ti ti-logout" aria-hidden="true"></i>
                    </button>
                  </div>
                }
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
    <p class="admin-field-hint admin-mon-actions-hint">
      <i class="ti ti-player-stop" aria-hidden="true"></i> @L["admin.monitoring.stopRunsHint"]
      <i class="ti ti-logout ms-3" aria-hidden="true"></i> @L["admin.monitoring.closeSessionHint"]
    </p>
  }
</section>

@* ---- Per-address traffic ---- *@
<section class="admin-dash-section">
  <div class="admin-dash-section-head">
    <h2><i class="ti ti-world-www" aria-hidden="true"></i>@L["admin.monitoring.byIp"]</h2>
    <span class="admin-field-hint">@L["admin.monitoring.byIpHint"]</span>
  </div>

  @if (s.ByIp.Count == 0)
  {
    <p class="admin-field-hint">@L["admin.monitoring.noIps"]</p>
  }
  else
  {
    <div class="admin-mon-table-wrap">
      <table class="admin-mon-table">
        <thead>
          <tr>
            <th>@L["admin.monitoring.ip"]</th>
            <th>@L["admin.monitoring.users"]</th>
            <th>@L["admin.monitoring.inbound"]</th>
            <th>@L["admin.monitoring.outbound"]</th>
            <th>@L["admin.monitoring.total"]</th>
            <th>@L["admin.monitoring.lastSeen"]</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var ip in s.ByIp)
          {
            <tr>
              <td class="admin-mon-ltr">@ip.Ip</td>
              <td>@(ip.Users == 0 ? "—" : ip.Users.ToString())</td>
              <td class="admin-mon-bar-cell">
                <span class="admin-mon-mini"><i style="width:@Pct(ip.BytesIn, topIpBytes)%"></i></span>
                <span class="admin-mon-num">@Bytes(ip.BytesIn)</span>
              </td>
              <td class="admin-mon-bar-cell">
                <span class="admin-mon-mini"><i style="width:@Pct(ip.BytesOut, topIpBytes)%"></i></span>
                <span class="admin-mon-num">@Bytes(ip.BytesOut)</span>
              </td>
              <td class="admin-mon-nowrap"><b>@Bytes(ip.BytesTotal)</b></td>
              <td class="admin-mon-nowrap">
                @(ip.LastSeenUtc is null ? "—" : ip.LastSeenUtc.Value.ToLocalTime().ToString("MM-dd HH:mm"))
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</section>

<p class="admin-field-hint admin-mon-stamp">
  @L["admin.monitoring.capturedAt"]: <span data-mon="capturedAt">@s.CapturedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
  <span class="admin-mon-refresh">@L["admin.monitoring.autoRefresh"]</span>
</p>

<script src="~/js/admin-monitoring.js" asp-append-version="true"></script>