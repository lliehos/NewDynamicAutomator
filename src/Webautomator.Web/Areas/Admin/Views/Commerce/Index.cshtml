@using Webautomator.Domain.Entities
@using Webautomator.Domain.Enums
@using Webautomator.Web.Areas.Admin.Models
@{
    ViewData["Title"] = "قیمت‌گذاری فروش";
    var commerceAllowed = ViewBag.CommerceAllowed is true;
    var softwareAllowed = ViewBag.SoftwarePurchaseAllowed is true;
    var selfIssuedAllowed = ViewBag.SelfIssuedAllowed is true;
    var canIssue = ViewBag.CanIssueLicenses is true;
    var options = ViewBag.Options as List<SoftwarePackageOption> ?? new List<SoftwarePackageOption>();
    var lp = ViewBag.LicensePricing as LicensePricing ?? new LicensePricing();
    var unboundUsers = ViewBag.UnboundUsers is int n ? n : 0;
    var editingId = ViewBag.EditingId as int?;
    var ok = TempData["CommerceOk"] as string;
    var status = TempData["CommerceStatus"] as string;
    var err = TempData["CommerceError"] as string;

    string KindLabel(PackageOptionKind k) => k == PackageOptionKind.Feature ? "فیچر" : "محدودیت";
    var edit = editingId is int eid ? options.FirstOrDefault(o => o.Id == eid) : null;
}

<div class="commerce-page">
  <header class="commerce-head">
    <div>
      <h4 class="mb-1">قیمت‌گذاری فروش</h4>
      <p class="text-muted small mb-0">
        قیمت بستهٔ نرم‌افزار و لایسنس — جدا از قیمت پلن‌ها که در صفحهٔ پلن‌ها تنظیم می‌شود.
      </p>
    </div>
    <div class="commerce-badges">
      <span class="commerce-badge @(softwareAllowed ? "is-ok" : null)">
        <i class="ti ti-package" aria-hidden="true"></i>@(softwareAllowed ? "فروش بسته فعال" : "فروش بسته غیرفعال")
      </span>
      @if (selfIssuedAllowed && canIssue)
      {
        <span class="commerce-badge is-ok"><i class="ti ti-certificate" aria-hidden="true"></i>صدور لایسنس فعال</span>
      }
      else if (selfIssuedAllowed && !canIssue)
      {
        <span class="commerce-badge is-warn" title="پرچم لایسنس روشن است ولی کلید امضا تنظیم نشده، پس صدور فایل ممکن نیست.">
          <i class="ti ti-alert-triangle" aria-hidden="true"></i>کلید امضا تنظیم نشده
        </span>
      }
      else
      {
        <span class="commerce-badge"><i class="ti ti-certificate" aria-hidden="true"></i>صدور لایسنس غیرفعال</span>
      }
    </div>
  </header>

  @if (!string.IsNullOrWhiteSpace(ok))
  {
    <div class="admin-alert is-ok"><i class="ti ti-check" aria-hidden="true"></i><div>@ok</div></div>
  }
  @if (!string.IsNullOrWhiteSpace(status))
  {
    <div class="admin-alert is-ok"><i class="ti ti-check" aria-hidden="true"></i><div>@status</div></div>
  }
  @if (!string.IsNullOrWhiteSpace(err))
  {
    <div class="admin-alert is-error"><i class="ti ti-alert-triangle" aria-hidden="true"></i><div>@err</div></div>
  }

  @if (!commerceAllowed)
  {
    @* Nothing to price on an install that cannot sell: editing numbers nobody can charge would be
       a page that looks functional and does nothing. *@
    <div class="admin-alert is-warn">
      <i class="ti ti-info-circle" aria-hidden="true"></i>
      <div>قابلیت فروش در لایسنس این نصب فعال نیست. برای فعال‌سازی با فروشنده تماس بگیرید.</div>
    </div>
    return;
  }

  @* ---- Pricing keys ---- *@
  <section class="commerce-card">
    <div class="commerce-card-head">
      <h4><i class="ti ti-key" aria-hidden="true"></i>کلیدهای قیمت‌گذاری بسته</h4>
      <p class="admin-field-hint">
        این کلیدها همان قابلیت‌هایی هستند که هنگام خرید به مشتری نشان داده می‌شوند و در لایسنس صادر
        می‌شوند. مشتری فقط انتخاب می‌کند؛ تعریف و قیمت همه اینجا انجام می‌شود.
      </p>
    </div>

    @if (options.Count == 0)
    {
      <p class="admin-field-hint">کلیدی ثبت نشده است. با فرم پایین یکی اضافه کنید.</p>
    }
    else
    {
      <div class="commerce-key-grid">
        @foreach (var o in options)
        {
          var isEditing = editingId == o.Id;
          <article class="commerce-key @(o.IsActive ? null : "is-off") @(isEditing ? "is-editing" : null)">
            <div class="commerce-key-head">
              <div>
                <div class="commerce-key-title">@o.Title</div>
                <code class="commerce-key-code">@o.Key</code>
              </div>
              <span class="commerce-key-state @(o.IsActive ? "is-ok" : null)">@(o.IsActive ? "فعال" : "غیرفعال")</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(o.Description))
            {
              <p class="commerce-key-desc">@o.Description</p>
            }

            <div class="commerce-key-price">
              @if (o.Kind == PackageOptionKind.Feature)
              {
                <span class="commerce-key-amount">@o.Amount.ToString("N0")</span>
                <span class="commerce-key-unit">مبلغ ثابت</span>
              }
              else
              {
                <span class="commerce-key-amount">@o.UnitAmount.ToString("N0")</span>
                <span class="commerce-key-unit">هر @(o.UnitLabel ?? "واحد") · شامل @o.IncludedUnits</span>
              }
            </div>

            <div class="commerce-key-foot">
              <span class="commerce-key-kind">@KindLabel(o.Kind)</span>
              @if (o.IsDefault)
              {
                <span class="commerce-key-kind">پیش‌فرض</span>
              }
              <span class="commerce-key-spacer"></span>
              <a class="btn btn-sm btn-label-primary" asp-action="Index" asp-route-edit="@o.Id">
                <i class="ti ti-pencil" aria-hidden="true"></i> ویرایش
              </a>
              <form method="post" asp-action="DeleteOption" class="d-inline"
                    onsubmit="return confirm('کلید «@o.Key» برای همیشه حذف شود؟');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@o.Id" />
                <button type="submit" class="btn btn-sm btn-label-danger">
                  <i class="ti ti-trash" aria-hidden="true"></i> حذف
                </button>
              </form>
            </div>
          </article>
        }
      </div>
    }
  </section>

  @* ---- Add / edit one key ---- *@
  <form method="post" asp-action="SaveOption" class="admin-form-shell is-2col" id="commerce-key-form">
    @Html.AntiForgeryToken()
    @* The id round-trips so the SAME action updates rather than inserting a duplicate. *@
    <input type="hidden" name="Id" value="@(edit?.Id ?? 0)" />

    <div class="admin-form-card">
      <h4><i class="ti ti-@(edit is null ? "plus" : "pencil")" aria-hidden="true"></i>@(edit is null ? "افزودن کلید" : $"ویرایش «{edit.Key}»")</h4>

      <div class="mb-2">
        <label class="admin-label">کلید</label>
        <input class="form-control" name="Key" value="@(edit?.Key ?? "")" placeholder="مثلاً local_run"
               dir="ltr" @(edit is null ? null : "readonly") />
        @if (edit is not null)
        {
          <p class="admin-field-hint">کلید پس از ساخت قابل تغییر نیست (سفارش‌های گذشته به آن ارجاع دارند).</p>
        }
      </div>

      <div class="mb-2">
        <label class="admin-label">عنوان (نمایش به مشتری)</label>
        <input class="form-control" name="Title" value="@(edit?.Title ?? "")" />
      </div>

      <div class="mb-2">
        <label class="admin-label">نوع</label>
        <select class="form-select" name="Kind" id="commerce-kind">
          <option value="1" selected="@(edit is null || edit.Kind == PackageOptionKind.Feature)">فیچر (مبلغ ثابت)</option>
          <option value="2" selected="@(edit?.Kind == PackageOptionKind.Limit)">محدودیت (به‌ازای واحد)</option>
        </select>
      </div>

      <div class="mb-2">
        <label class="admin-label">توضیح</label>
        <input class="form-control" name="Description" value="@(edit?.Description ?? "")" />
      </div>

      <div class="mb-2">
        <label class="admin-label">ترتیب نمایش</label>
        <input class="form-control" name="SortOrder" type="number" value="@(edit?.SortOrder ?? 0)" />
      </div>
    </div>

    <div class="admin-form-card">
      <h4><i class="ti ti-currency-dollar" aria-hidden="true"></i>قیمت</h4>

      <div class="mb-2" data-kind="feature">
        <label class="admin-label">مبلغ ثابت</label>
        <input class="form-control" name="Amount" type="number" step="1000" value="@(edit?.Amount ?? 0)" dir="ltr" />
      </div>

      <div class="mb-2" data-kind="limit">
        <label class="admin-label">مبلغ هر واحد</label>
        <input class="form-control" name="UnitAmount" type="number" step="1000" value="@(edit?.UnitAmount ?? 0)" dir="ltr" />
      </div>

      <div class="mb-2" data-kind="limit">
        <label class="admin-label">واحدهای شامل</label>
        <input class="form-control" name="IncludedUnits" type="number" value="@(edit?.IncludedUnits ?? 0)" dir="ltr" />
      </div>

      <div class="mb-2" data-kind="limit">
        <label class="admin-label">سقف واحد</label>
        <input class="form-control" name="MaxUnits" type="number" value="@edit?.MaxUnits" dir="ltr" placeholder="∞" />
      </div>

      <div class="mb-2" data-kind="limit">
        <label class="admin-label">برچسب واحد</label>
        <input class="form-control" name="UnitLabel" value="@(edit?.UnitLabel ?? "")" placeholder="کاربر / منبع" />
      </div>

      <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "IsActive", Label = "فعال (به مشتری نمایش داده شود)", Checked = edit?.IsActive ?? true }' />
      <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "IsDefault", Label = "پیش‌فرض انتخاب‌شده", Checked = edit?.IsDefault ?? false }' />
    </div>

    <div class="admin-form-actions">
      <button type="submit" class="btn btn-primary btn-sm">
        <i class="ti ti-device-floppy" aria-hidden="true"></i> @(edit is null ? "افزودن کلید" : "ذخیرهٔ تغییرات")
      </button>
      @if (edit is not null)
      {
        <a class="btn btn-label-secondary btn-sm" asp-action="Index">لغو</a>
      }
    </div>
  </form>

  @* ---- Licence price list ---- *@
  <form method="post" asp-action="SaveLicensePricing" class="admin-form-shell is-2col">
    @Html.AntiForgeryToken()
    <div class="admin-form-card">
      <h4><i class="ti ti-certificate" aria-hidden="true"></i>قیمت‌گذاری لایسنس</h4>
      <p class="admin-field-hint">مبلغ پایه + به‌ازای هر کاربر، با ضریب دوره.</p>

      <div class="mb-2">
        <label class="admin-label">مبلغ پایه</label>
        <input class="form-control" name="BaseAmount" type="number" step="1000" value="@lp.BaseAmount" dir="ltr" />
      </div>
      <div class="mb-2">
        <label class="admin-label">به‌ازای هر کاربر</label>
        <input class="form-control" name="PerUserAmount" type="number" step="1000" value="@lp.PerUserAmount" dir="ltr" />
      </div>
      <div class="mb-2">
        <label class="admin-label">کاربران شامل</label>
        <input class="form-control" name="IncludedUsers" type="number" value="@lp.IncludedUsers" dir="ltr" />
      </div>
      <div class="mb-2">
        <label class="admin-label">سقف کاربر</label>
        <input class="form-control" name="MaxUsers" type="number" value="@lp.MaxUsers" dir="ltr" placeholder="∞" />
      </div>
    </div>

    <div class="admin-form-card">
      <h4><i class="ti ti-repeat" aria-hidden="true"></i>ضریب دوره و واحد پول</h4>
      <div class="mb-2">
        <label class="admin-label">ضریب سالانه</label>
        <input class="form-control" name="YearlyTermMultiplier" type="number" step="0.1" value="@lp.YearlyTermMultiplier" dir="ltr" />
      </div>
      <div class="mb-2">
        <label class="admin-label">ضریب دائمی</label>
        <input class="form-control" name="PerpetualMultiplier" type="number" step="0.1" value="@lp.PerpetualMultiplier" dir="ltr" />
      </div>
      <div class="mb-2">
        <label class="admin-label">واحد پول</label>
        <input class="form-control" name="Currency" value="@lp.Currency" dir="ltr" maxlength="8" />
      </div>
    </div>

    <div class="admin-form-actions">
      <button type="submit" class="btn btn-primary btn-sm">
        <i class="ti ti-device-floppy" aria-hidden="true"></i> ذخیرهٔ قیمت لایسنس
      </button>
    </div>
  </form>

  @* ---- Portability ---- *@
  <section class="commerce-card">
    <div class="commerce-card-head">
      <h4><i class="ti ti-arrows-exchange" aria-hidden="true"></i>انتقال و پشتیبان‌گیری</h4>
      <p class="admin-field-hint">
        برای جابه‌جایی این نصب به سرور دیگر: از دیتابیس پشتیبان بگیرید، همان دیتابیس را روی سرور جدید
        بازگردانید، فایل‌های برنامه را منتقل کنید و لایسنس را در نصب جدید وارد کنید. با وارد کردن لایسنس،
        همهٔ کاربران و فرآیندها به‌طور خودکار به سرور جدید متصل می‌شوند.
      </p>
    </div>
    @if (unboundUsers > 0)
    {
      <div class="admin-alert is-warn">
        <i class="ti ti-alert-triangle" aria-hidden="true"></i>
        <div>@unboundUsers کاربر بدون اتصال به سرور وجود دارد. اگر این نصب تازه منتقل شده است، دکمهٔ زیر را بزنید.</div>
      </div>
    }
    <form method="post" asp-action="RebindHost" asp-area="Admin"
          onsubmit="return confirm('همهٔ کاربران و فرآیندها به این سرور متصل می‌شوند. ادامه می‌دهید؟');">
      @Html.AntiForgeryToken()
      <button type="submit" class="btn btn-outline-primary btn-sm">اتصال داده‌های موجود به این سرور</button>
    </form>
  </section>
</div>

<script src="~/js/admin-commerce.js" asp-append-version="true"></script>
