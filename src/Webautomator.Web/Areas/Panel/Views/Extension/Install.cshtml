@{
    ViewData["Title"] = "نصب افزونه‌ها";
    var appKey = ViewBag.AppInstanceKey as string ?? "default";
    var keySegment = ViewBag.InstanceKeySegment as string;
    var globalVer = ViewBag.GlobalVersion as string ?? ViewBag.RecorderVersion as string ?? ViewBag.Version as string ?? "";
    var smartVer = ViewBag.SmartVersion as string ?? "";
    var brandHead = ViewData["BrandHead"] as BrandHeadModel ?? new BrandHeadModel();
    var globalExtName = $"{brandHead.AppName} Global";
    var smartExtName = $"{brandHead.AppName} Smart Recorder";

    /*
     * Two ways to hand the extension to a user, and the right one depends on WHERE THE BROWSER IS.
     *
     * The folder lives on whatever machine runs this app. When the page is opened from that same
     * machine — locally, in Development — the folder path is real and the shortest route is to paste
     * it straight into "Load unpacked". When the page is opened from anywhere else the server is a
     * different computer from the reader's, the folder does not exist for them at all, and the only
     * thing that can work is downloading a package and extracting it locally.
     *
     * `ShowLocalPath` is decided by the controller from the request host, not from the environment
     * name: the environment alone cannot tell whether the caller can see that directory.
     */
    var showLocalPath = ViewBag.ShowLocalPath is true;
    var globalPath = ViewBag.GlobalPath as string ?? "";
    var smartPath = ViewBag.SmartPath as string ?? "";
    var localPathReady = showLocalPath && !string.IsNullOrWhiteSpace(globalPath);

    /*
     * A PowerShell one-liner that creates and opens the conventional folder on the USER's machine.
     * Built here as a plain string rather than inline in the markup: the command contains backslashes
     * and `$` tokens, and putting it directly in a Razor expression makes C# treat them as escape
     * sequences. `$env:LOCALAPPDATA` is intentionally left for PowerShell to expand, so the user's own
     * profile path is used instead of a guessed one.
     */
    var commandParts = new System.Collections.Generic.List<string>
    {
        "$p = Join-Path $env:LOCALAPPDATA 'webautomator'"
    };
    if (!string.IsNullOrWhiteSpace(keySegment))
    {
        commandParts.Add("$p = Join-Path $p '" + keySegment + "'");
    }
    commandParts.Add("New-Item -ItemType Directory -Force -Path $p | Out-Null");
    commandParts.Add("explorer $p");
    var suggestedPathCommand = string.Join("; ", commandParts);

    /*
     * The remote case: the folder is on the USER's machine, so the only thing this server can do is
     * hand over the package. Two ways to do that, and the faster one is a command that does the
     * download AND the extraction locally: paste once, and the files land in the same fixed folder
     * every time (`%LOCALAPPDATA%\webautomator\…`), ready for "Load unpacked" — no zip juggling, and
     * a later update is the same command again. The zip stays as the manual fallback.
     *
     * The ticket in the links is minted by the controller (they expire; reload the page for new
     * ones), because the script on the user's machine has no browser session. Building the command
     * here rather than in the markup is deliberate: it contains backslashes, quotes and `$` tokens.
     */
    var serverBase = ViewBag.ServerBase as string ?? "";
    var ticketGlobal = ViewBag.InstallTicketGlobal as string ?? "";
    var ticketSmart = ViewBag.InstallTicketSmart as string ?? "";
    var subGlobal = string.IsNullOrWhiteSpace(keySegment) ? "webautomator\\extension-global" : $"webautomator\\{keySegment}\\extension-global";
    var subSmart = string.IsNullOrWhiteSpace(keySegment) ? "webautomator\\extension-smart-recorder" : $"webautomator\\{keySegment}\\extension-smart-recorder";
    var autoGlobal = $"$ErrorActionPreference='Stop'; $d=Join-Path $env:LOCALAPPDATA '{subGlobal}'; New-Item -ItemType Directory -Force -Path $d|Out-Null; Invoke-WebRequest '{serverBase}/extension/download/global?ticket={ticketGlobal}' -OutFile \"$env:TEMP\\webautomator-global.zip\" -UseBasicParsing; Expand-Archive \"$env:TEMP\\webautomator-global.zip\" $d -Force; explorer $d";
    var autoSmart = $"$ErrorActionPreference='Stop'; $d=Join-Path $env:LOCALAPPDATA '{subSmart}'; New-Item -ItemType Directory -Force -Path $d|Out-Null; Invoke-WebRequest '{serverBase}/extension/download/smart?ticket={ticketSmart}' -OutFile \"$env:TEMP\\webautomator-smart-recorder.zip\" -UseBasicParsing; Expand-Archive \"$env:TEMP\\webautomator-smart-recorder.zip\" $d -Force; explorer $d";
    var showAutoInstall = !localPathReady && !string.IsNullOrWhiteSpace(serverBase) && !string.IsNullOrWhiteSpace(ticketGlobal);
    var localFolderHint = string.IsNullOrWhiteSpace(keySegment)
        ? "%LOCALAPPDATA%\\webautomator"
        : $"%LOCALAPPDATA%\\webautomator\\{keySegment}";
}
<div class="card mb-4">
  <div class="card-body">
    <h4 class="mb-3">افزونه‌های @brandHead.AppName</h4>

    <div class="alert alert-info mb-3">
      <strong>@globalExtName</strong> شامل ضبط، اجرا و سلکتور است — فقط <strong>یک بار</strong> نصب می‌شود.
      <strong>@smartExtName</strong> جداگانه و اختیاری است.
    </div>

    @if (localPathReady)
    {
      <div class="alert alert-success mb-3 small">
        <strong>حالت توسعه (اجرای محلی):</strong> سرور و مرورگر روی همین کامپیوتر هستند، پس
        مستقیم از مسیر پوشه استفاده کنید — نیازی به دانلود بسته نیست.
      </div>
    }
    else
    {
      <div class="alert alert-warning mb-3 small">
        <strong>این افزونه‌ها روی کامپیوتر خودتان نصب می‌شوند، نه روی سرور.</strong>
        پس مسیر سرور نمایش داده نمی‌شود — آن پوشه روی کامپیوتر شما وجود ندارد.
        سریع‌ترین راه، <strong>نصب خودکار</strong> پایین است (دانلود و استخراج خودکار در پوشهٔ درست)؛
        اگر ترجیح می‌دهید دستی انجام دهید، بستهٔ zip را دانلود و در یک پوشهٔ <strong>ثابت</strong> باز کنید
        (پوشه را بعداً جابجا یا پاک نکنید، وگرنه کروم افزونه را از دست می‌دهد).
      </div>

      if (showAutoInstall)
      {
        <div class="border rounded p-3 mb-3" style="border-right: 3px solid #0d9488 !important;">
          <div class="fw-semibold mb-1">⚡ نصب خودکار در پوشهٔ کاربر (بدون کار دستی با zip)</div>
          <p class="small text-muted mb-2">
            دستور زیر را در <strong>PowerShell</strong> روی همین کامپیوتر اجرا کنید: بسته از همین سرور دانلود و
            مستقیم در مسیر استاندارد زیر استخراج می‌شود و پوشه باز می‌شود — بعد فقط Load unpacked کنید.
            برای <strong>به‌روزرسانی</strong> در آینده هم کافی است همین دستور (یا اسکریپت) را دوباره اجرا کنید.
          </p>
          <div class="fw-semibold small mb-1">① @globalExtName</div>
          <code id="da-ext-auto-global" class="user-select-all d-block small mb-2">@autoGlobal</code>
          <div class="d-flex gap-2 flex-wrap mb-3">
            <button type="button" class="btn btn-sm btn-primary" data-copy="#da-ext-auto-global">کپی دستور Global</button>
            <a class="btn btn-sm btn-outline-primary" href="/extension/installer/global?ticket=@ticketGlobal">⬇ اسکریپت نصب Global (.ps1)</a>
          </div>
          <div class="fw-semibold small mb-1">② @smartExtName</div>
          <code id="da-ext-auto-smart" class="user-select-all d-block small mb-2">@autoSmart</code>
          <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-sm btn-secondary" data-copy="#da-ext-auto-smart">کپی دستور Smart</button>
            <a class="btn btn-sm btn-outline-secondary" href="/extension/installer/smart?ticket=@ticketSmart">⬇ اسکریپت نصب Smart (.ps1)</a>
          </div>
          <p class="small text-muted mt-2 mb-0">
            اجرای فایل .ps1: راست‌کلیک روی فایل دانلودشده → <strong>Run with PowerShell</strong>.
            لینک‌های بالا تا چند ساعت معتبرند؛ اگر منقضی شد همین صفحه را رفرش کنید.
          </p>
        </div>
      }
    }

    <div class="row g-3">
      <div class="col-md-6">
        <div class="border rounded p-3 h-100" style="border-top: 3px solid #0d9488 !important;">
          <h5 class="mb-2">① @globalExtName</h5>
          <p class="small text-muted">ضبط فرآیند، اجرا (Play) و کپی سلکتور — یک افزونه با آیکون برند.</p>
          @if (!string.IsNullOrEmpty(globalVer))
          {
            <div class="small text-muted mb-2">نسخهٔ موردنیاز: <code>@globalVer</code></div>
          }
          @if (!string.IsNullOrEmpty(ViewBag.BindingFingerprint as string))
          {
            <div class="small text-muted mb-2">اثر انگشت پیوند افزونه: <code>@ViewBag.BindingFingerprint</code></div>
          }
          @if (localPathReady)
          {
            <div class="fw-semibold mb-1">مسیر پوشه</div>
            <code id="da-ext-path-global" class="user-select-all d-block small mb-2">@globalPath</code>
            <button type="button" class="btn btn-sm btn-primary w-100" data-copy="#da-ext-path-global">کپی مسیر</button>
          }
          else
          {
            <a class="btn btn-sm btn-primary w-100" href="/extension/download/global?ticket=@ticketGlobal" download>⬇ دانلود بستهٔ Global (zip)</a>
          }
        </div>
      </div>
      <div class="col-md-6">
        <div class="border rounded p-3 h-100" style="border-top: 3px solid #7367f0 !important;">
          <h5 class="mb-2">② @smartExtName</h5>
          <p class="small text-muted">هوشمندسازی فرآیند — جدا از Global.</p>
          @if (!string.IsNullOrEmpty(smartVer))
          {
            <div class="small text-muted mb-2">نسخهٔ موردنیاز: <code>@smartVer</code></div>
          }
          @if (localPathReady)
          {
            <div class="fw-semibold mb-1">مسیر پوشه</div>
            <code id="da-ext-path-smart" class="user-select-all d-block small mb-2">@smartPath</code>
            <button type="button" class="btn btn-sm btn-secondary w-100" data-copy="#da-ext-path-smart">کپی مسیر</button>
          }
          else
          {
            <a class="btn btn-sm btn-secondary w-100" href="/extension/download/smart?ticket=@ticketSmart" download>⬇ دانلود بستهٔ Smart Recorder (zip)</a>
          }
        </div>
      </div>
    </div>

    <h5 class="mt-4 mb-2">مراحل نصب</h5>
    <ol class="mb-3">
      @if (localPathReady)
      {
        <li class="mb-2">مسیر بالا را کپی کنید — پوشه همین حالا روی این کامپیوتر آماده است.</li>
        <li class="mb-2"><code>chrome://extensions</code> یا <code>edge://extensions</code> را باز کنید.</li>
        <li class="mb-2"><strong>Developer mode</strong> را روشن کنید.</li>
        <li class="mb-2"><strong>Load unpacked</strong> → همان مسیر را Paste کنید.</li>
        <li class="mb-2">اگر افزونه‌های قدیمی Recorder/Player/Selector را دارید، حذفشان کنید.</li>
        <li class="mb-2">این پرتال را رفرش کنید.</li>
      }
      else
      {
        if (showAutoInstall)
        {
          <li class="mb-2"><strong>روش سریع:</strong> دستور «نصب خودکار» بالا را در PowerShell اجرا کنید — دانلود و
            استخراج خودکار در <code>@localFolderHint</code> انجام می‌شود و پوشه باز می‌شود.</li>
          <li class="mb-2">یا <strong>روش دستی:</strong> بستهٔ zip پایین را دانلود و در یک پوشهٔ ثابت <strong>Extract</strong> کنید — مثلاً
            <code>C:\@brandHead.AppName-ext\global</code>. پوشه را بعداً جابجا نکنید.</li>
        }
        else
        {
          <li class="mb-2">بستهٔ بالا را دانلود و در یک پوشهٔ ثابت <strong>استخراج (Extract)</strong> کنید — مثلاً
            <code>C:\@brandHead.AppName-ext\global</code>. پوشه را بعداً جابجا نکنید.</li>
        }
        <li class="mb-2"><code>chrome://extensions</code> یا <code>edge://extensions</code> را باز کنید.</li>
        <li class="mb-2"><strong>Developer mode</strong> را روشن کنید.</li>
        <li class="mb-2"><strong>Load unpacked</strong> → همان پوشه‌ای که استخراج کردید را انتخاب کنید.</li>
        <li class="mb-2">اگر افزونه‌های قدیمی Recorder/Player/Selector را دارید، حذفشان کنید.</li>
        <li class="mb-2">این پرتال را رفرش کنید.</li>
      }
    </ol>

    @if (!localPathReady)
    {
      <div class="border rounded p-3 mb-3">
        <div class="fw-semibold mb-1">مسیر پیشنهادی روی کامپیوتر شما</div>
        <p class="small text-muted mb-2">
          برای اینکه اسم کاربری ویندوزتان را حدس نزنیم، این دستور را در
          <strong>PowerShell</strong> اجرا کنید تا مسیر دقیق باز شود:
        </p>
        <code id="da-ext-suggested-path" class="user-select-all d-block small mb-2">@suggestedPathCommand</code>
        <button type="button" class="btn btn-sm btn-outline-primary" data-copy="#da-ext-suggested-path">کپی دستور</button>
      </div>
    }

    <div class="d-flex gap-2 flex-wrap">
      <button type="button" class="btn btn-outline-primary" id="da-sync-now">همگام‌سازی سرور</button>
      <a class="btn btn-label-secondary" asp-area="Panel" asp-controller="Home" asp-action="Index">بازگشت</a>
    </div>
    <p class="mt-3 mb-0" id="da-sync-status"></p>
  </div>
</div>

@section Scripts {
<script>
(function () {
  document.querySelectorAll("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const sel = btn.getAttribute("data-copy");
      const el = sel ? document.querySelector(sel) : null;
      const text = el?.textContent?.trim() || "";
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const prev = btn.textContent;
        btn.textContent = "کپی شد";
        setTimeout(() => { btn.textContent = prev; }, 1200);
      } catch { /* ignore */ }
    });
  });

  document.getElementById("da-sync-now")?.addEventListener("click", async () => {
    const status = document.getElementById("da-sync-status");
    if (status) status.textContent = "در حال همگام‌سازی…";
    try {
      const res = await fetch("/extension/sync", { method: "POST" });
      const data = await res.json();
      // Only versions (and, in local mode, the refreshed paths) are echoed back. The message is
      // phrased for whichever mode this page rendered in, because "packages are ready to download"
      // is wrong on a page that offers a folder to copy.
      if (status) {
        const g = data?.global?.version || data?.version || "";
        const s = data?.smart?.version || "";
        const tail = @(localPathReady ? "true" : "false")
          ? " مسیرها به‌روز شدند."
          : " بسته‌ها آمادهٔ دانلود هستند.";
        status.textContent = data?.ok
          ? `همگام شد — Global ${g}${s ? ` · Smart ${s}` : ""}.${tail}`
          : (data?.error || "خطا در همگام‌سازی");
      }
    } catch (e) {
      if (status) status.textContent = e.message || "خطا";
    }
  });
})();
</script>
}
