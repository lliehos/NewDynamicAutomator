@using Webautomator.Domain.Entities
@{
    ViewData["Title"] = L["billing.renew.title"];
    var selfIssued = ViewBag.SelfIssued is true;
    var canIssue = ViewBag.CanIssue is true;
    var pricing = ViewBag.Pricing as LicensePricing ?? new LicensePricing();
    var error = TempData["BillingError"] as string;
}

<div class="da-home">
  <header class="da-home-head">
    <div>
      <h4 class="da-home-title mb-1">@L["billing.renew.heading"]</h4>
      <p class="da-home-sub mb-0">@L["billing.renew.sub"]</p>
    </div>
  </header>

  @if (!string.IsNullOrWhiteSpace(error))
  {
    <div class="alert alert-warning">@error</div>
  }

  <div class="row g-3">
    @if (selfIssued)
    {
      <div class="col-lg-7">
        <div class="card h-100">
          <div class="card-body">
            <div class="fw-semibold mb-3">@L["billing.renew.buyLicense"]</div>

            @if (!canIssue)
            {
              @* The flag is on but no signing key exists, so the last step would fail AFTER taking
                 money. Saying so here prevents a customer paying for something that cannot be issued. *@
              <div class="alert alert-warning small">@L["billing.renew.noKey"]</div>
            }
            else
            {
              <form method="post" asp-action="BuyLicense" id="lic-form">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                  <label class="form-label">@L["billing.renew.users"]</label>
                  <input name="users" id="lic-users" type="number" class="form-control" value="@Math.Max(1, pricing.IncludedUsers)"
                         min="1" @(pricing.MaxUsers is int cap ? $"max=\"{cap}\"" : "") />
                  <div class="form-text">
                    @L.T("billing.renew.usersHint", ("n", pricing.IncludedUsers.ToString()))
                  </div>
                </div>
                <div class="mb-3">
                  <label class="form-label">@L["billing.common.period"]</label>
                  <select name="term" id="lic-term" class="form-select">
                    <option value="monthly">@L["billing.common.cycleMonthly"]</option>
                    <option value="yearly" selected>@L["billing.common.cycleYearly"]</option>
                    <option value="perpetual">@L["billing.common.cyclePerpetual"]</option>
                  </select>
                </div>
                <div class="mb-3">
                  <label class="form-label">@L["billing.common.orgOptional"]</label>
                  <input name="organization" class="form-control" />
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <span class="fw-semibold">@L["billing.common.amount"]</span>
                  <span class="billing-total" id="lic-total">—</span>
                </div>
                <div id="lic-lines" class="small text-muted mb-3"></div>
                <button type="submit" class="btn btn-primary w-100" @(canIssue ? null : "disabled")>
                  @L["billing.renew.payAndGet"]
                </button>
              </form>
            }
          </div>
        </div>
      </div>
    }

    <div class="col-lg-5">
      <div class="card h-100">
        <div class="card-body">
          <div class="fw-semibold mb-2">@L["billing.renew.requestTitle"]</div>
          <p class="small text-muted mb-2">@L["billing.renew.requestBody"]</p>
          <p class="small mb-0">@L["billing.renew.requestPath"]</p>
        </div>
      </div>
    </div>
  </div>
</div>

@if (selfIssued && canIssue)
{
  @section Scripts {
  <script>
  (function () {
    // Priced by the server for the same reason as the package wizard: the quoted total must be the
    // total the order is created with.
    var usersEl = document.getElementById("lic-users");
    var termEl = document.getElementById("lic-term");
    var totalEl = document.getElementById("lic-total");
    var linesEl = document.getElementById("lic-lines");
    var form = document.getElementById("lic-form");
    var token = form.querySelector('input[name="__RequestVerificationToken"]').value;
    var timer = null;
    var numLocale = document.documentElement.lang || "fa-IR";

    function refresh() {
      var body = new FormData();
      body.append("__RequestVerificationToken", token);
      body.append("users", usersEl.value || "1");
      body.append("term", termEl.value);
      fetch("@Url.Action("QuoteLicense", "Billing", new { area = "Panel" })", {
        method: "POST", credentials: "same-origin", body: body
      }).then(function (r) { return r.json(); }).then(function (data) {
        if (data.error) return;
        totalEl.textContent = Number(data.total).toLocaleString(numLocale) + " " + (data.currency || "");
        linesEl.innerHTML = (data.lines || []).map(function (l) {
          var detail = l.detail ? ' <span class="ms-1">(' + l.detail + ")</span>" : "";
          return "<div>" + l.title + detail + " — " + Number(l.amount).toLocaleString(numLocale) + "</div>";
        }).join("");
      }).catch(function () { /* the total simply stays as it was */ });
    }

    function schedule() { clearTimeout(timer); timer = setTimeout(refresh, 250); }
    usersEl.addEventListener("input", schedule);
    termEl.addEventListener("change", schedule);
    refresh();
  })();
  </script>
  }
}
