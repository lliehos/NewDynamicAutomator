@using Webautomator.Domain.Entities
@{
    ViewData["Title"] = L["billing.plans.title"];
    var plans = ViewBag.Plans as List<Plan> ?? new List<Plan>();
    var error = TempData["BillingError"] as string;
    // The plan's own name is stored per language, so pick by the request culture rather than
    // always preferring the Persian column.
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    string PlanName(Plan p)
    {
        var preferred = isFa ? p.NameFa : p.NameEn;
        var fallback = isFa ? p.NameEn : p.NameFa;
        return string.IsNullOrWhiteSpace(preferred) ? (string.IsNullOrWhiteSpace(fallback) ? p.Code : fallback) : preferred;
    }
    string Money(decimal? amount, string currency) =>
        amount is null ? "—" : $"{amount.Value:N0} {currency}";
}

<div class="da-home da-billing">
  <header class="da-home-head">
    <div>
      <h4 class="da-home-title mb-1">@L["billing.plans.heading"]</h4>
      <p class="da-home-sub mb-0">@L["billing.plans.sub"]</p>
    </div>
  </header>

  @if (!string.IsNullOrWhiteSpace(error))
  {
    <div class="alert alert-warning">@error</div>
  }

  @if (plans.Count == 0)
  {
    <div class="alert alert-info">@L["billing.plans.empty"]</div>
  }

  <div class="d-flex gap-2 mb-3 flex-wrap">
    @if (Webautomator.Web.Filters.TenantBrandingViewDataFilter.AllowsSoftwarePurchase(ViewData))
    {
      <a class="btn btn-label-primary btn-sm" asp-action="Package">@L["billing.plans.buyPackage"]</a>
    }
    @if (Webautomator.Web.Filters.TenantBrandingViewDataFilter.AllowsSelfIssuedLicenses(ViewData))
    {
      <a class="btn btn-label-secondary btn-sm" asp-action="Renew">@L["billing.plans.buyLicense"]</a>
    }
    <a class="btn btn-label-secondary btn-sm" asp-action="History">@L["billing.plans.history"]</a>
  </div>

  @if (plans.Count > 0)
  {
    <div class="billing-plans">
    @foreach (var plan in plans)
    {
      var monthly = plan.MonthlyPrice;
      var yearly = plan.YearlyPrice;
      var yearlyDisc = plan.YearlyDiscountPercent;
      <div class="billing-plan card">
        <div class="card-body d-flex flex-column">
          <div class="fw-bold fs-5 mb-1">@PlanName(plan)</div>
          <div class="text-muted small mb-3">@L.T("billing.plans.planSub", ("name", PlanName(plan)))</div>

          @if (monthly is not null)
          {
            <div class="billing-price mb-1">
              @Money(monthly, plan.PriceCurrency)
              <span class="text-muted small">/ @L["billing.plans.monthly"]</span>
            </div>
            @if (plan.MonthlyDiscountPercent is > 0)
            {
              <div class="mb-2"><span class="billing-disc">@plan.MonthlyDiscountPercent.Value.ToString("0.##")% @L["billing.plans.discount"]</span></div>
            }
          }
          @if (yearly is not null)
          {
            <div class="billing-price billing-price-alt mb-1">
              @Money(yearly, plan.PriceCurrency)
              <span class="text-muted small">/ @L["billing.plans.yearly"]</span>
            </div>
            @if (yearlyDisc is > 0)
            {
              <div class="mb-2"><span class="billing-disc">@yearlyDisc.Value.ToString("0.##")% @L["billing.plans.discount"]</span></div>
            }
          }

          <ul class="billing-features list-unstyled small my-3">
            @* All three ceilings are NULLABLE ints: null means unlimited. A `x <= 0` test is false for
               null, so it fell through to `.ToString()` and printed nothing at all. Test null first. *@
            <li>✔ @L.T("billing.plans.featTasks", ("n", plan.MaxTasks is null or <= 0 ? L["billing.plans.unlimited"] : plan.MaxTasks.Value.ToString()))</li>
            <li>✔ @L.T("billing.plans.featSources", ("n", plan.MaxDataSources is null or <= 0 ? L["billing.plans.unlimited"] : plan.MaxDataSources.Value.ToString()))</li>
            <li>✔ @L.T("billing.plans.featRows", ("n", plan.MaxSourceRows is null or <= 0 ? L["billing.plans.unlimited"] : plan.MaxSourceRows.Value.ToString("N0")))</li>
            <li>@(plan.CanShare ? "✔" : "✖") @L["billing.plans.canShare"]</li>
            <li>@(plan.CanReceiveShare ? "✔" : "✖") @L["billing.plans.canReceiveShare"]</li>
          </ul>

          <div class="mt-auto">
            @if (monthly is not null)
            {
              <a class="btn btn-primary w-100 mb-2"
                 href="@Url.Action("Checkout", "Billing", new { area = "Panel", plan = plan.Code, cycle = "monthly" })">
                @L["billing.plans.continueMonthly"]
              </a>
            }
            @if (yearly is not null)
            {
              <a class="btn btn-label-secondary w-100"
                 href="@Url.Action("Checkout", "Billing", new { area = "Panel", plan = plan.Code, cycle = "yearly" })">
                @L["billing.plans.continueYearly"]
              </a>
            }
          </div>
        </div>
      </div>
    }
    </div>
  }
</div>
