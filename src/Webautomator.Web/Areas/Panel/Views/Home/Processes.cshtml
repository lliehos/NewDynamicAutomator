@{
    ViewData["Title"] = L["panel.processesTitle"] + " — " + L["brand.name"];
    // Templates are a management surface: only an administrator or a process manager may create
    // one. Same role check as the sidebar entry and HomeController.Templates, so the button and
    // the page it leads to can never disagree.
    var canManageTemplates = User.IsInRole(nameof(Webautomator.Domain.Enums.UserRole.Admin))
        || User.IsInRole(nameof(Webautomator.Domain.Enums.UserRole.ProcessManager));
}

<div class="da-home" data-can-manage-templates="@(canManageTemplates ? "true" : "false")">
  <header class="da-home-head">
    <div>
      <div class="da-home-brand" data-i18n="brand.name">@L["brand.name"]</div>
      <h4 class="da-home-title mb-0" data-i18n="panel.processesTitle">@L["panel.processesTitle"]</h4>
      <p class="da-home-sub mb-0" id="da-portal-status" data-i18n="panel.processesSub">@L["panel.processesSub"]</p>
    </div>
    <button class="btn btn-primary da-home-create d-none d-md-inline-flex align-items-center gap-1" type="button"
            data-bs-toggle="modal" data-bs-target="#da-create-task-modal">
      <i class="ti ti-plus"></i>
      <span class="da-home-create-label" data-i18n="panel.createProcess">@L["panel.createProcess"]</span>
    </button>
  </header>

  <div class="da-tasks-panel" id="da-tasks-panel">
    <div class="da-tasks-busy" id="da-tasks-busy" hidden aria-live="assertive">
      <div class="da-tasks-busy-inner">
        <span class="da-tasks-spinner" aria-hidden="true"></span>
        <span class="da-tasks-busy-text" data-i18n="panel.busyPlayer">@L["panel.busyPlayer"]</span>
      </div>
    </div>

    @* Client-side filter over the loaded list: the rows are already in the DOM, so filtering is
       a matter of hiding them rather than asking the server again. *@
    <div class="da-task-search">
      <div class="da-task-search-field">
        <i class="ti ti-search da-task-search-icon" aria-hidden="true"></i>
        <input type="search" id="da-task-search" class="da-task-search-input"
               data-i18n-placeholder="panel.searchProcesses" data-i18n-aria="panel.searchProcesses"
               placeholder="@L["panel.searchProcesses"]" aria-label="@L["panel.searchProcesses"]"
               autocomplete="off" spellcheck="false" />
        <button type="button" class="da-task-search-clear" id="da-task-search-clear"
                data-i18n-aria="panel.searchClear" data-i18n-title="panel.searchClear"
                aria-label="@L["panel.searchClear"]" title="@L["panel.searchClear"]" hidden>
          <i class="ti ti-x" aria-hidden="true"></i>
        </button>
      </div>
      <span class="da-task-search-count" id="da-task-search-count" aria-live="polite"></span>
    </div>

    <div class="card d-none d-md-block mb-0">
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th data-i18n="panel.colTitle">@L["panel.colTitle"]</th>
              <th data-i18n="panel.colTemplate">@L["panel.colTemplate"]</th>
              <th class="text-nowrap" data-i18n="panel.colLastRun">@L["panel.colLastRun"]</th>
              <th data-i18n="panel.colShared">@L["panel.colShared"]</th>
              <th data-i18n="panel.colGroup">@L["panel.colGroup"]</th>
              <th data-i18n="panel.colAction">@L["panel.colAction"]</th>
              <th data-i18n="panel.colSource">@L["panel.colSource"]</th>
              <th class="text-nowrap" data-i18n="panel.colOps">@L["panel.colOps"]</th>
            </tr>
          </thead>
          <tbody id="da-task-rows">
            <tr><td colspan="8" class="text-center text-muted py-6" data-i18n="common.loading">@L["common.loading"]</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="da-task-list d-md-none" id="da-task-cards" aria-live="polite">
      <div class="da-task-empty text-muted" data-i18n="common.loading">@L["common.loading"]</div>
    </div>
  </div>

  <button type="button" class="da-fab d-md-none" data-bs-toggle="modal" data-bs-target="#da-create-task-modal"
          data-i18n-aria="panel.createProcess" data-i18n-title="panel.createProcess"
          aria-label="@L["panel.createProcess"]" title="@L["panel.createProcess"]">
    <i class="ti ti-plus"></i>
  </button>
</div>

<div class="ds-viewer" id="da-portal-ds-viewer" hidden>
  <div class="ds-viewer-backdrop" data-portal-ds-close="1"></div>
  <div class="ds-viewer-panel" role="dialog" aria-modal="true" aria-labelledby="da-portal-ds-title">
    <div class="ds-viewer-head">
      <div>
        <h2 id="da-portal-ds-title">منبع داده</h2>
        <p class="ds-viewer-sub" id="da-portal-ds-sub"></p>
      </div>
      <div class="ds-viewer-head-actions">
        <!-- Which copy the grid below is (green = server, grey = local), matching the row buttons. -->
        <span class="ds-view-mode" id="da-portal-ds-mode" hidden></span>
        <span class="ds-viewer-live" id="da-portal-ds-live" title="اتصال زنده">● آفلاین</span>
        <span class="ds-viewer-actor text-muted small" id="da-portal-ds-actor" hidden></span>
        <!-- Icon-only controls with tooltips: one 30px square each, so the head never wraps. -->
        <!-- "Clear data" empties the copy being viewed: an eraser reads as clear, a pencil reads as
             edit (which the grid itself already expresses). -->
        <button type="button" class="ds-icon-btn" id="da-portal-ds-clear"
                title="پاک‌سازی داده" aria-label="پاک‌سازی داده"
                data-i18n-title="sources.clearData" data-i18n-aria="sources.clearData">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M16.2 3.3c.6-.6 1.6-.6 2.2 0l2.3 2.3c.6.6.6 1.6 0 2.2l-9.3 9.2q-.3.3-.7.5l-1.7 1.4q-.9.5-1.8-.2l-2.6-2.6q-.6-.9-.2-1.8l1.4-1.7q.2-.4.5-.7zM8.4 15.2l-3-3-.9 1.1 2.6 2.6z"/><path fill="currentColor" d="M3 19.6h18v2H3z"/></svg>
        </button>
        <button type="button" class="ds-icon-btn" id="da-portal-ds-refresh"
                title="بازخوانی" aria-label="بازخوانی"
                data-i18n-title="sources.refresh" data-i18n-aria="sources.refresh">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 5a7 7 0 0 1 6.5 4.4l1.9-1.1V13h-4.7l1.8-1A5 5 0 1 0 12 17v2a7 7 0 1 1 0-14z"/></svg>
        </button>
        <!-- Excel export moved here from the process row: it exports the copy the modal shows. -->
        <button type="button" class="ds-icon-btn" id="da-portal-ds-download"
                title="دانلود اکسل" aria-label="دانلود اکسل"
                data-i18n-title="sources.downloadExcel" data-i18n-aria="sources.downloadExcel">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M11 3h2v8.2l2.9-2.9 1.4 1.4-5.3 5.3-5.3-5.3 1.4-1.4 2.9 2.9V3zM5 16.6h14v2H5v-2z"/></svg>
        </button>
        <button type="button" class="ds-icon-btn" data-portal-ds-close="1"
                title="بستن" aria-label="بستن"
                data-i18n-title="sources.close" data-i18n-aria="sources.close">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M18.3 5.7L12 12l6.3 6.3-1.4 1.4L10.6 13.4 4.3 19.7 2.9 18.3 9.2 12 2.9 5.7 4.3 4.3l6.3 6.3 6.3-6.3z"/></svg>
        </button>
      </div>
    </div>
    <div class="ds-viewer-legend">
      <span class="ds-leg ds-leg-read">خواندن</span>
      <span class="ds-leg ds-leg-write">نوشتن</span>
    </div>
    <!-- Shown when the grid is a LOCAL copy (a local run's data, or results not yet synced): the
         numbers on screen may then differ from what the server holds. -->
    <p class="ds-local-note" id="da-portal-ds-local-note" role="status" hidden></p>
    <div class="ds-viewer-scroll">
      <table class="ds-viewer-table" id="da-portal-ds-table">
        <thead></thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</div>

<div class="modal fade" id="da-create-task-modal" tabindex="-1" aria-labelledby="da-create-task-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
    <div class="modal-content">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title" id="da-create-task-title" data-i18n="panel.createProcess">@L["panel.createProcess"]</h5>
      </div>
      <div class="modal-body">
        <label class="form-label" for="da-new-title" data-i18n="panel.processTitle">@L["panel.processTitle"]</label>
        <input class="form-control form-control-lg" id="da-new-title" type="text" data-i18n-placeholder="panel.processTitlePh" placeholder="@L["panel.processTitlePh"]" autocomplete="off" />

        @* Start from a template. Hidden until the picker has actually loaded a list: a user with no
           templates to choose from (or one who may not use them) should not be offered an empty
           "none" dropdown that changes nothing. *@
        <div class="mt-3" id="da-new-template-wrap" hidden>
          <label class="form-label" for="da-new-template" data-i18n="panel.startFromTemplate">@L["panel.startFromTemplate"]</label>
          <select class="form-select" id="da-new-template">
            <option value="" data-i18n="panel.startFromScratch">@L["panel.startFromScratch"]</option>
          </select>
          <p class="palette-hint mb-0 mt-1" data-i18n="panel.startFromTemplateHint">@L["panel.startFromTemplateHint"]</p>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal" data-i18n="common.cancel">@L["common.cancel"]</button>
        <button type="button" class="btn btn-primary" id="da-create-local" data-i18n="common.create">@L["common.create"]</button>
      </div>
    </div>
  </div>
</div>

@* Template info: what a template is for, what it contains, and how to act on it. Opened from the
   template menu and from the template cell of a process row, so the same facts are one click away
   from either place a template is mentioned. *@
<div class="modal fade" id="da-tpl-info-modal" tabindex="-1" aria-labelledby="da-tpl-info-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
    <div class="modal-content">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title" id="da-tpl-info-title"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.cancel"]"></button>
      </div>
      <div class="modal-body pt-2">
        <p class="da-tpl-info-desc mb-3" id="da-tpl-info-desc"></p>
        <dl class="da-tpl-info-grid" id="da-tpl-info-grid"></dl>
        <div class="alert alert-info d-flex gap-2 mb-0" role="note">
          <i class="ti ti-info-circle mt-1" aria-hidden="true"></i>
          <span data-i18n="panel.templateInfoNote">@L["panel.templateInfoNote"]</span>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal" data-i18n="common.close">@L["common.close"]</button>
        <button type="button" class="btn btn-primary" id="da-tpl-info-use" data-i18n="panel.templateUse">@L["panel.templateUse"]</button>
      </div>
    </div>
  </div>
</div>

@* Detach confirmation. Detaching is a decision rather than a toggle — the process stops receiving
   the template's later fixes — so it is confirmed in words instead of a silent menu click. *@
<div class="modal fade" id="da-tpl-detach-modal" tabindex="-1" aria-labelledby="da-tpl-detach-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title" id="da-tpl-detach-title" data-i18n="panel.templateDetachTitle">@L["panel.templateDetachTitle"]</h5>
      </div>
      <div class="modal-body">
        <p class="mb-0" id="da-tpl-detach-body"></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal" data-i18n="common.cancel">@L["common.cancel"]</button>
        <button type="button" class="btn btn-danger" id="da-tpl-detach-confirm" data-i18n="panel.templateDetach">@L["panel.templateDetach"]</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script src="~/lib/signalr/signalr.min.js"></script>
<link rel="stylesheet" href="~/editor/flow.css?v=@V.AssetVersion" />
<script src="~/js/task-share.js?v=@V.AssetVersion"></script>
<script src="~/js/local-tasks.js?v=@V.AssetVersion"></script>
<script src="~/js/local-templates.js?v=@V.AssetVersion"></script>
<script>
  document.querySelectorAll("[data-portal-ds-close]").forEach((el) => {
    el.addEventListener("click", () => {
      const modal = document.getElementById("da-portal-ds-viewer");
      if (modal) modal.hidden = true;
    });
  });
</script>
}
