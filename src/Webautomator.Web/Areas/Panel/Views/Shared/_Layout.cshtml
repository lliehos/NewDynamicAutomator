@inject Webautomator.Web.Services.DeploymentFingerprintService Fingerprints
@{
  var culture = L.Culture;
  var dir = L.Dir;
  var cssPrefix = L.IsRtl ? "rtl/" : "";
  var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
  var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
  var isHome = ctrl.Equals("Home", StringComparison.OrdinalIgnoreCase) && act.Equals("Index", StringComparison.OrdinalIgnoreCase);
  var isProcesses = ctrl.Equals("Home", StringComparison.OrdinalIgnoreCase) && act.Equals("Processes", StringComparison.OrdinalIgnoreCase);
  var isSources = ctrl.Equals("Home", StringComparison.OrdinalIgnoreCase) && act.Equals("DataSources", StringComparison.OrdinalIgnoreCase);
  var isTemplates = ctrl.Equals("Home", StringComparison.OrdinalIgnoreCase) && act.Equals("Templates", StringComparison.OrdinalIgnoreCase);
  var isGuide = ctrl.Equals("Home", StringComparison.OrdinalIgnoreCase) && act.Equals("Guide", StringComparison.OrdinalIgnoreCase);
  var isSettings = ctrl.Equals("Settings", StringComparison.OrdinalIgnoreCase);
  var nextLang = L.IsRtl ? "en" : "fa";
  var langLabel = L.IsRtl ? L["common.switchToEn"] : L["common.switchToFa"];
  var displayName = User.FindFirst("display_name")?.Value;
  if (string.IsNullOrWhiteSpace(displayName))
    displayName = User.Identity?.Name;
  var brandHead = ViewData["BrandHead"] as BrandHeadModel ?? new BrandHeadModel();
  var pageTitle = ViewData["Title"] as string;
}
<!doctype html>
<html
  lang="@culture"
  class="light-style layout-navbar-fixed layout-menu-fixed layout-compact"
  dir="@dir"
  data-culture="@culture"
  data-theme="theme-default"
  data-assets-path="~/assets/"
  data-template="vertical-menu-template-starter"
  data-style="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
  @* This deployment's identity: the extension compares it with the fingerprint it was built for,
     so "connected" means THIS server's bundle — not merely "some Webautomator extension is installed". *@
  <meta name="da-server-fingerprint" content="@(Fingerprints.TryGet()?.Fingerprint)" />
  <title>@brandHead.ComposeTitle(pageTitle, L["brand.tagline"])</title>
  <partial name="_BrandHead" model="brandHead" />
  <link rel="stylesheet" href="~/assets/vendor/fonts/tabler-icons.css" />
  <link rel="stylesheet" href="~/assets/vendor/css/@(cssPrefix)core.css" />
  <link rel="stylesheet" href="~/assets/vendor/css/@(cssPrefix)theme-default.css" />
  <link rel="stylesheet" href="~/assets/css/demo.css" />
  <link rel="stylesheet" href="~/assets/vendor/libs/node-waves/node-waves.css" />
  <link rel="stylesheet" href="~/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
  <link rel="stylesheet" href="~/css/portal-app.css?v=@V.AssetVersion" />
  <link rel="stylesheet" href="~/css/da-notify.css?v=@V.AssetVersion" />
  <link rel="stylesheet" href="~/css/extension-gate.css?v=@V.AssetVersion" />
  <link rel="stylesheet" href="~/css/webautomator-copyright.css?v=@V.AssetVersion" />
  <link rel="stylesheet" href="~/css/referral-qr.css?v=@V.AssetVersion" />
  <link rel="stylesheet" href="~/css/da-switch.css?v=@V.AssetVersion" />
  <link rel="stylesheet" href="~/css/da-cropper.css?v=@V.AssetVersion" />
  <link rel="stylesheet" href="~/css/da-avatar.css?v=@V.AssetVersion" />
  @* The guide's long-form reading rules are not needed by the other panel pages, so the
     stylesheet is loaded only where it is used rather than in every page's critical path. *@
  @if (isGuide)
  {
    <link rel="stylesheet" href="~/css/panel-guide.css?v=@V.AssetVersion" />
  }
  <style>
    body, .menu, .layout-navbar, .card, input, button { font-family: Vazirmatn, "Public Sans", sans-serif !important; }
  </style>
  <script src="~/assets/vendor/js/helpers.js"></script>
  <script src="~/assets/js/config.js"></script>
</head>
<body>
  <div id="da-ext-modal" role="dialog" aria-modal="true" aria-labelledby="da-ext-title" data-role="recorder" hidden>
    <div class="da-ext-card">
      <h2 id="da-ext-title">@L["panel.extModalTitle"]</h2>
      <p id="da-ext-desc">@L["panel.extModalDesc"]</p>
      <div class="da-ext-versions" id="da-ext-versions" hidden></div>
      @{
        /*
         * Same two modes as the install page, and for the same reason: the extension folder exists on
         * the machine running the app. A request from that same machine can be handed the path; a
         * request from anywhere else cannot use it and gets the package instead. `IsLocal` is set here
         * from the request host rather than the environment name, because the environment cannot tell
         * whether the caller can actually see that directory.
         */
        var modalHost = Context.Request.Host.Host;
        var modalIsLocal = string.Equals(modalHost, "localhost", StringComparison.OrdinalIgnoreCase)
          || (System.Net.IPAddress.TryParse(modalHost, out var modalIp) && System.Net.IPAddress.IsLoopback(modalIp));
      }
      <div class="da-ext-path-box">
        <div class="da-ext-path-label" id="da-ext-path-label">@L["panel.extPathLabel"]</div>
        @if (modalIsLocal)
        {
          @* Locally the folder is the fastest route, so the path is shown and copied as before. *@
          <code id="da-ext-modal-path">@L["panel.extPathPreparing"]</code>
        }
        else
        {
          @* Remotely the server's folder does not exist for the reader, so a package is the only
             thing that can work. The links rely on the download endpoint the app already exposes.
             A ticket is attached for the same reason the install page does it: a top-level link
             navigation is not guaranteed to carry the auth cookie, and without one the endpoint
             answers 401 (previously it was a licence-gate redirect to the login page). *@
          <div class="da-ext-downloads" id="da-ext-downloads">
            <a class="btn-da btn-da-primary" id="da-ext-download-global"
               href="/extension/download/global?ticket=@(ViewBag.InstallTicketGlobal)" download>⬇ @L["panel.extDownloadGlobal"]</a>
            <a class="btn-da btn-da-ghost" id="da-ext-download-smart"
               href="/extension/download/smart?ticket=@(ViewBag.InstallTicketSmart)" download>⬇ @L["panel.extDownloadSmart"]</a>
          </div>
        }
      </div>
      <ol>
        <li data-i18n="panel.extStep1">@L["panel.extStep1"]</li>
        <li data-i18n="panel.extStep2">@L["panel.extStep2"]</li>
        <li data-i18n="panel.extStep3">@L["panel.extStep3"]</li>
      </ol>
      <p class="da-ext-note" data-i18n="panel.extNote">@L["panel.extNote"]</p>
      <div class="da-ext-actions">
        <button type="button" class="btn-da btn-da-primary" id="da-ext-copy-path" data-i18n="panel.extCopy">@L["panel.extCopy"]</button>
        <button type="button" class="btn-da btn-da-ghost" id="da-ext-recheck" data-i18n="panel.extRecheck">@L["panel.extRecheck"]</button>
        <button type="button" class="btn-da btn-da-ghost" id="da-ext-guide" data-i18n="panel.extGuide">@L["panel.extGuide"]</button>
        <button type="button" class="btn-da btn-da-ghost" id="da-ext-dismiss" data-i18n="panel.extLater">@L["panel.extLater"]</button>
      </div>
      <div class="da-ext-hint" id="da-ext-modal-hint"></div>
    </div>
  </div>
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
        <div class="app-brand demo">
          <a asp-area="Panel" asp-controller="Home" asp-action="Index" class="app-brand-link webautomator-brand-link">
            @{ ViewData["BrandImgClass"] = "webautomator-brand-mark"; ViewData["BrandImgWidth"] = 32; ViewData["BrandImgHeight"] = 32; }
            <partial name="_BrandMark" model="brandHead" />
            <span class="app-brand-text demo menu-text fw-bold ms-2">@brandHead.AppName</span>
          </a>
        </div>
        <div class="menu-inner-shadow"></div>
        <ul class="menu-inner py-1">
          <li class="menu-item @(isHome ? "active" : null)">
            <a asp-area="Panel" asp-controller="Home" asp-action="Index" class="menu-link">
              <i class="menu-icon tf-icons ti ti-home"></i>
              <div data-i18n="panel.navHome">@L["panel.navHome"]</div>
            </a>
          </li>
          <li class="menu-item @(isProcesses ? "active" : null)">
            <a asp-area="Panel" asp-controller="Home" asp-action="Processes" class="menu-link">
              <i class="menu-icon tf-icons ti ti-list"></i>
              <div data-i18n="panel.navProcesses">@L["panel.navProcesses"]</div>
            </a>
          </li>
          <li class="menu-item @(isSources ? "active" : null)">
            <a asp-area="Panel" asp-controller="Home" asp-action="DataSources" class="menu-link">
              <i class="menu-icon tf-icons ti ti-database"></i>
              <div data-i18n="panel.navResources">@L["panel.navResources"]</div>
            </a>
          </li>
          @* Templates are a management surface, so the entry point is shown only to the people who
             may actually publish to them. An administrator gets in too, the same way they reach
             everything else on this rail. *@
          @if (User.IsInRole("Admin") || User.IsInRole("ProcessManager"))
          {
            <li class="menu-item @(isTemplates ? "active" : null)">
              <a asp-area="Panel" asp-controller="Home" asp-action="Templates" class="menu-link">
                <i class="menu-icon tf-icons ti ti-copy"></i>
                <div data-i18n="panel.navTemplates">@L["panel.navTemplates"]</div>
              </a>
            </li>
          }
          <li class="menu-item @(isGuide ? "active" : null)">
            <a asp-area="Panel" asp-controller="Home" asp-action="Guide" class="menu-link">
              <i class="menu-icon tf-icons ti ti-help-circle"></i>
              <div data-i18n="panel.navGuide">@L["panel.navGuide"]</div>
            </a>
          </li>
          <li class="menu-item">
            <a asp-area="Panel" asp-controller="Desktop" asp-action="Install" class="menu-link">
              <i class="menu-icon tf-icons ti ti-download"></i>
              <div data-i18n="panel.navDownloads">@L["panel.navDownloads"]</div>
            </a>
          </li>
          @if (Webautomator.Web.Filters.TenantBrandingViewDataFilter.AllowsCommerce(ViewData))
          {
            @* Only shown when this deployment is licensed to sell; the controller re-checks, so
               hiding the link is a courtesy rather than the guard. *@
            <li class="menu-item @(ctrl.Equals("Billing", StringComparison.OrdinalIgnoreCase) ? "active" : null)">
              <a asp-area="Panel" asp-controller="Billing" asp-action="Plans" class="menu-link">
                <i class="menu-icon tf-icons ti ti-credit-card"></i>
                <div data-i18n="panel.navBilling">@L["panel.navBilling"]</div>
              </a>
            </li>
          }
          <li class="menu-item @(isSettings ? "active" : null)">
            <a asp-area="Panel" asp-controller="Settings" asp-action="Index" class="menu-link">
              <i class="menu-icon tf-icons ti ti-settings"></i>
              <div data-i18n="panel.navSettings">@L["panel.navSettings"]</div>
            </a>
          </li>
          @if (User.IsInRole("Admin"))
          {
            <li class="menu-item">
              <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons ti ti-shield"></i>
                <div data-i18n="admin.menuLabel">@L["admin.menuLabel"]</div>
              </a>
            </li>
          }
          @* A Monitor operator lives on the Panel like everyone else but has no other way into the
             one page their role exists for, so this is their entry point. It points straight at the
             monitoring dashboard rather than the admin home, which they are not allowed to open. *@
          @if (User.IsInRole("Monitor"))
          {
            <li class="menu-item @(ctrl.Equals("Monitoring", StringComparison.OrdinalIgnoreCase) ? "active" : null)">
              <a asp-area="Admin" asp-controller="Monitoring" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons ti ti-activity-heartbeat"></i>
                <div data-i18n="admin.nav.monitoring">@L["admin.nav.monitoring"]</div>
              </a>
            </li>
          }
        </ul>
        <div class="da-menu-foot px-4 pb-3 mt-auto">
          <small class="text-muted d-block" data-i18n="brand.copyright">@L["brand.copyright"]</small>
        </div>
      </aside>
      <div class="layout-page">
        <nav class="layout-navbar container-xxl navbar navbar-expand-xl navbar-detached align-items-center bg-navbar-theme"
             id="layout-navbar">
          <div class="layout-menu-toggle navbar-nav align-items-xl-center me-3 me-xl-0 d-xl-none">
            <a class="nav-item nav-link px-0 me-xl-4" href="javascript:void(0)">
              <i class="ti ti-menu-2 ti-md"></i>
            </a>
          </div>
          <div class="navbar-nav-right d-flex align-items-center w-100" id="navbar-collapse">
            <div class="d-xl-none fw-semibold text-heading me-auto d-flex align-items-center gap-2">
              @{ ViewData["BrandImgClass"] = ""; ViewData["BrandImgWidth"] = 22; ViewData["BrandImgHeight"] = 22; }
              <partial name="_BrandMark" model="brandHead" />
              <span>@brandHead.AppName</span>
            </div>
            <ul class="navbar-nav flex-row align-items-center ms-auto">
              <li class="nav-item me-2">
                @* Hidden when the licence excludes the second language, so the visitor is not offered
                   a choice the install cannot honour. *@
                @if (L.Bilingual)
                {
                  <button type="button" class="btn btn-sm btn-label-primary rounded-pill px-3 da-lang-chip"
                          data-lang-switch data-lang-next="@nextLang" title="@langLabel">@langLabel</button>
                }
              </li>
              <li class="nav-item me-3 d-none d-sm-block">
                <a class="nav-link text-muted" href="/" data-i18n="common.site" title="@L["common.site"]">@L["common.site"]</a>
              </li>
              <li class="nav-item me-3 d-none d-sm-block">
                <a class="nav-link text-muted da-navbar-guide" asp-area="Panel" asp-controller="Home" asp-action="Guide"
                   data-i18n="panel.navGuide" title="@L["panel.navGuide"]">@L["panel.navGuide"]</a>
              </li>
              <li class="nav-item me-3 d-none d-sm-block">
                @{
                  ViewData["Path"] = User.FindFirst("avatar_path")?.Value ?? "";
                  ViewData["Name"] = displayName;
                  ViewData["Size"] = 32;
                }
                <a class="nav-link da-navbar-user" asp-area="Panel" asp-controller="Settings" asp-action="Index">
                  <partial name="_Avatar" />
                  <span>@displayName</span>
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link" asp-area="Panel" asp-controller="Account" asp-action="Logout" data-i18n="common.logout">@L["common.logout"]</a>
              </li>
            </ul>
          </div>
        </nav>
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            @RenderBody()
          </div>
          <footer class="content-footer footer bg-footer-theme">
            <div class="container-xxl">
              <div class="footer-container d-flex align-items-center justify-content-center py-3">
                <div class="text-muted small" data-i18n="brand.copyright">@L["brand.copyright"]</div>
              </div>
            </div>
          </footer>
        </div>
      </div>
    </div>
    <div class="layout-overlay layout-menu-toggle"></div>
    <div class="drag-target"></div>
  </div>
  <script src="~/js/i18n.js?v=@V.AssetVersion"></script>
  <script>
    // The signed-in user's name, so live-update handlers can tell their own edit from someone
    // else's and avoid re-reading (and fighting) the grid they just wrote to.
    window.daCurrentUserName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(User.Identity?.Name ?? ""));
  </script>
  <script src="~/js/da-crypto.js?v=@V.AssetVersion"></script>
  <script src="~/js/da-secure-store.js?v=@V.AssetVersion"></script>
  <script src="~/assets/vendor/libs/jquery/jquery.js"></script>
  <script src="~/assets/vendor/libs/popper/popper.js"></script>
  <script src="~/assets/vendor/js/bootstrap.js"></script>
  <script src="~/assets/vendor/libs/node-waves/node-waves.js"></script>
  <script src="~/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
  <script src="~/assets/vendor/js/menu.js"></script>
  <script src="~/assets/js/main.js"></script>
  <script src="~/lib/signalr/signalr.min.js"></script>
  <script src="~/js/da-notify.js?v=@V.AssetVersion"></script>
  <script src="~/js/da-catalog.js?v=@V.AssetVersion"></script>
  <script src="~/js/da-device.js?v=@V.AssetVersion"></script>
  <script src="~/js/da-telemetry.js?v=@V.AssetVersion"></script>
  <script src="~/js/entitlements.js?v=@V.AssetVersion"></script>
  <script src="~/js/extension-gate.js?v=@V.AssetVersion"></script>
  <script src="~/js/da-switch.js?v=@V.AssetVersion"></script>
  <script src="~/js/da-cropper.js?v=@V.AssetVersion"></script>
  @await RenderSectionAsync("Scripts", required: false)
  @if (brandHead.ShowReferralQr)
  {
    <partial name="_ReferralQrWidget" model="brandHead" />
    @* Self-hosted QR: the encoder plus a shim exposing the QRCode.toCanvas API referral-qr.js
       calls. Nothing here leaves the server -- see wwwroot/lib/qrcode. *@
    <script src="~/lib/qrcode/qrcode-generator.min.js"></script>
    <script src="~/lib/qrcode/qrcode-shim.js"></script>
    <script src="~/js/referral-qr.js?v=@V.AssetVersion"></script>
  }
  @await Component.InvokeAsync("SiteChrome")
</body>
</html>
