@{
  Layout = null;
  var culture = L.Culture;
  var dir = L.Dir;
  var nextLang = L.IsRtl ? "en" : "fa";
  var langLabel = L.IsRtl ? L["common.switchToEn"] : L["common.switchToFa"];
  var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
  string NavClass(string c) => ctrl.Equals(c, StringComparison.OrdinalIgnoreCase) ? "active" : null!;
  var brandHead = ViewData["BrandHead"] as BrandHeadModel ?? new BrandHeadModel();
  var pageTitle = ViewData["Title"] as string;
}
<!doctype html>
<html lang="@culture" dir="@dir" data-admin-catalog="1">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@brandHead.ComposeTitle(pageTitle, L["brand.tagline"])</title>
  <partial name="_BrandHead" model="brandHead" />
  <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/assets/vendor/fonts/tabler-icons.css" />
  <link rel="stylesheet" href="~/css/admin-app.css?v=9" />
  <link rel="stylesheet" href="~/css/da-switch.css?v=1" />
  <link rel="stylesheet" href="~/css/da-cropper.css?v=1" />
  <link rel="stylesheet" href="~/css/da-avatar.css?v=1" />
  <link rel="stylesheet" href="~/css/morobot-copyright.css?v=1" />
</head>
<body data-admin-catalog="1">
  <div class="admin-shell">
    <aside class="admin-nav">
      <div class="admin-brand">
        @{ ViewData["BrandImgClass"] = ""; ViewData["BrandImgWidth"] = 28; ViewData["BrandImgHeight"] = 28; }
        <partial name="_BrandMark" model="brandHead" />
        <span>@brandHead.AppName</span>
      </div>
      <nav class="admin-nav-links">
        <a class="@NavClass("Home")" asp-area="Admin" asp-controller="Home" asp-action="Index"><i class="ti ti-dashboard" aria-hidden="true"></i>@L["admin.nav.dashboard"]</a>
        <a class="@NavClass("Settings")" asp-area="Admin" asp-controller="Settings" asp-action="Index"><i class="ti ti-settings" aria-hidden="true"></i>@L["admin.nav.settings"]</a>
        <a class="@NavClass("License")" asp-area="Admin" asp-controller="License" asp-action="Index"><i class="ti ti-certificate" aria-hidden="true"></i>@L["admin.nav.license"]</a>
        <a class="@NavClass("Branding")" asp-area="Admin" asp-controller="Branding" asp-action="Index"><i class="ti ti-palette" aria-hidden="true"></i>@L["admin.nav.branding"]</a>
        <a class="@NavClass("Plans")" asp-area="Admin" asp-controller="Plans" asp-action="Index"><i class="ti ti-layers-intersect" aria-hidden="true"></i>@L["admin.nav.plans"]</a>
        <a class="@NavClass("Prices")" asp-area="Admin" asp-controller="Prices" asp-action="Index"><i class="ti ti-currency-dollar" aria-hidden="true"></i>@L["admin.nav.prices"]</a>
        <a class="@NavClass("Processes")" asp-area="Admin" asp-controller="Processes" asp-action="Index"><i class="ti ti-git-branch" aria-hidden="true"></i>@L["admin.nav.processes"]</a>
        <a class="@NavClass("Migrate")" asp-area="Admin" asp-controller="Migrate" asp-action="Index"><i class="ti ti-database-import" aria-hidden="true"></i>@L["admin.nav.migrate"]</a>
        <a class="@NavClass("Sources")" asp-area="Admin" asp-controller="Sources" asp-action="Index"><i class="ti ti-database" aria-hidden="true"></i>@L["admin.nav.sources"]</a>
        <a class="@NavClass("Users")" asp-area="Admin" asp-controller="Users" asp-action="Index"><i class="ti ti-users" aria-hidden="true"></i>@L["admin.nav.users"]</a>
        <a class="@NavClass("Logs")" asp-area="Admin" asp-controller="Logs" asp-action="Index"><i class="ti ti-history" aria-hidden="true"></i>@L["admin.nav.events"]</a>
        <a asp-area="Admin" asp-controller="Logs" asp-action="Devices"><i class="ti ti-device-desktop" aria-hidden="true"></i>@L["admin.nav.devices"]</a>
      </nav>
      <div class="admin-nav-foot">
        <a asp-area="Panel" asp-controller="Home" asp-action="Index"><i class="ti ti-layout-dashboard" aria-hidden="true"></i>@L["common.panel"]</a>
        <a asp-area="Panel" asp-controller="Account" asp-action="Logout"><i class="ti ti-logout" aria-hidden="true"></i>@L["common.logout"]</a>
      </div>
    </aside>
    <main class="admin-main">
      <div class="admin-top">
        <h1>@ViewData["Title"]</h1>
        <form method="post" asp-area="Admin" asp-controller="Settings" asp-action="SetLanguage" class="admin-lang">
          @Html.AntiForgeryToken()
          <input type="hidden" name="lang" value="@nextLang" />
          <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
          <button type="submit" class="btn-admin secondary">@langLabel</button>
        </form>
      </div>
      @await Component.InvokeAsync("AdminLicenseStrip")
      @if (TempData["Danger"] != null)
      {
        <div class="admin-alert is-error" role="alert"><i class="ti ti-alert-circle" aria-hidden="true"></i> @TempData["Danger"]</div>
      }
      @if (TempData["Warn"] != null)
      {
        <div class="admin-alert is-warn" role="alert"><i class="ti ti-alert-triangle" aria-hidden="true"></i> @TempData["Warn"]</div>
      }
      @if (TempData["Ok"] != null)
      {
        <div class="card-admin is-ok">@TempData["Ok"]</div>
      }
      @RenderBody()
    </main>
  </div>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
  <script src="~/assets/vendor/libs/apex-charts/apexcharts.js"></script>
  <script src="~/js/da-catalog.js?v=admin-1"></script>
  <script src="~/js/admin-ui.js?v=1"></script>
  <script src="~/js/admin-charts.js?v=1"></script>
  <script>window.AdminI18n = { strings: { pager: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["admin.pager.label"])), page: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["admin.pager.page"])), first: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["admin.pager.first"])), prev: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["admin.pager.prev"])), next: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["admin.pager.next"])), last: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["admin.pager.last"])) } };</script>
  <script src="~/js/admin-pager.js?v=1"></script>
  <script src="~/js/da-switch.js?v=1"></script>
  <script src="~/js/da-cropper.js?v=1"></script>
  @await RenderSectionAsync("Scripts", required: false)
  @await Component.InvokeAsync("SiteChrome")
</body>
</html>
