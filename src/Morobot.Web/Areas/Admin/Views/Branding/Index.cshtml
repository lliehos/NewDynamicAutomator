@model Morobot.Contracts.Licensing.TenantBrandingDto
@{
  Layout = "_Layout";
  ViewData["Title"] = L["admin.branding.title"];
}
<partial name="_AdminPageHead" model='new AdminPageHeadModel { Summary = L["admin.branding.intro"] }' />

<form method="post" enctype="multipart/form-data" class="admin-settings-grid admin-branding-form">
  @Html.AntiForgeryToken()
  <div class="admin-settings-card">
    <h3><i class="ti ti-palette" aria-hidden="true"></i>@L["admin.branding.identity"]</h3>
    <div class="mb-3">
      <label class="admin-label" for="AppName">@L["admin.branding.appName"]</label>
      <input class="form-control" id="AppName" name="AppName" value="@Model.AppName" autocomplete="organization" />
    </div>
    <div class="mb-3">
      <label class="admin-label" for="BrandTitle">@L["admin.branding.brandTitle"]</label>
      <input class="form-control" id="BrandTitle" name="BrandTitle" value="@Model.BrandTitle" />
    </div>
    <div class="mb-3">
      <label class="admin-label" for="OrganizationName">@L["admin.branding.organization"]</label>
      <input class="form-control" id="OrganizationName" name="OrganizationName" value="@Model.OrganizationName" />
    </div>
  </div>

  <div class="admin-settings-card">
    <h3><i class="ti ti-photo" aria-hidden="true"></i>@L["admin.branding.assets"]</h3>

    <div class="admin-file-field mb-4">
      <label class="admin-label" for="logoFile">@L["admin.branding.logo"]</label>
      <p class="admin-field-hint">@L["admin.branding.logoHint"]</p>
      <div class="admin-file-picker" data-admin-file-picker>
        <div class="admin-file-picker-preview" id="logoPreviewWrap">
          @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
          {
            <img src="@Model.LogoUrl" alt="" id="logoPreviewImg" class="admin-file-picker-img admin-file-picker-img--logo" />
          }
          else
          {
            <div class="admin-file-picker-placeholder" id="logoPreviewPlaceholder">
              <i class="ti ti-photo" aria-hidden="true"></i>
              <span>@L["admin.branding.preview"]</span>
            </div>
            <img src="" alt="" id="logoPreviewImg" class="admin-file-picker-img admin-file-picker-img--logo" hidden />
          }
        </div>
        <div class="admin-file-picker-actions">
          <input type="file" class="admin-file-input" id="logoFile" name="logoFile" accept="image/png,image/jpeg,image/webp,image/svg+xml" data-preview-target="logoPreviewImg" data-placeholder-id="logoPreviewPlaceholder" />
          <label class="btn-admin btn-admin-outline" for="logoFile"><i class="ti ti-upload" aria-hidden="true"></i>@L["admin.branding.chooseFile"]</label>
          <span class="admin-file-name" data-file-name-for="logoFile">@L["admin.branding.noFileChosen"]</span>
        </div>
      </div>
    </div>

    <div class="admin-file-field">
      <label class="admin-label" for="faviconFile">@L["admin.branding.favicon"]</label>
      <p class="admin-field-hint">@L["admin.branding.faviconHint"]</p>
      <div class="admin-file-picker" data-admin-file-picker>
        <div class="admin-file-picker-preview admin-file-picker-preview--favicon" id="faviconPreviewWrap">
          @if (!string.IsNullOrWhiteSpace(Model.FaviconUrl))
          {
            <img src="@Model.FaviconUrl" alt="" id="faviconPreviewImg" class="admin-file-picker-img admin-file-picker-img--favicon" />
          }
          else
          {
            <div class="admin-file-picker-placeholder" id="faviconPreviewPlaceholder">
              <i class="ti ti-app-window" aria-hidden="true"></i>
              <span>@L["admin.branding.preview"]</span>
            </div>
            <img src="" alt="" id="faviconPreviewImg" class="admin-file-picker-img admin-file-picker-img--favicon" hidden />
          }
        </div>
        <div class="admin-file-picker-actions">
          <input type="file" class="admin-file-input" id="faviconFile" name="faviconFile" accept="image/png,image/jpeg,image/webp,image/x-icon,image/vnd.microsoft.icon" data-preview-target="faviconPreviewImg" data-placeholder-id="faviconPreviewPlaceholder" />
          <label class="btn-admin btn-admin-outline" for="faviconFile"><i class="ti ti-upload" aria-hidden="true"></i>@L["admin.branding.chooseFile"]</label>
          <span class="admin-file-name" data-file-name-for="faviconFile">@L["admin.branding.noFileChosen"]</span>
        </div>
      </div>
    </div>
  </div>

  <div class="admin-settings-card">
    <h3><i class="ti ti-color-swatch" aria-hidden="true"></i>@L["admin.branding.colors"]</h3>
    <p class="admin-field-hint mb-3">@L["admin.branding.colorsIntro"]</p>
    <div class="admin-color-grid">
      @foreach (var f in new[] {
        new { Id = "ColorPrimary", Key = "admin.branding.colorPrimary", Val = Model.ColorPrimary },
        new { Id = "ColorPrimaryDark", Key = "admin.branding.colorPrimaryDark", Val = Model.ColorPrimaryDark },
        new { Id = "ColorPrimaryLight", Key = "admin.branding.colorPrimaryLight", Val = Model.ColorPrimaryLight },
        new { Id = "ColorAccent", Key = "admin.branding.colorAccent", Val = Model.ColorAccent },
        new { Id = "ColorSoft", Key = "admin.branding.colorSoft", Val = Model.ColorSoft },
        new { Id = "ColorSoft2", Key = "admin.branding.colorSoft2", Val = Model.ColorSoft2 },
        new { Id = "ColorInk", Key = "admin.branding.colorInk", Val = Model.ColorInk },
        new { Id = "ColorBorderSubtle", Key = "admin.branding.colorBorderSubtle", Val = Model.ColorBorderSubtle }
      })
      {
        <div class="admin-color-field">
          <label class="admin-label" for="@f.Id">@L[f.Key]</label>
          <div class="admin-color-row">
            <input type="color" class="form-control form-control-color" id="@f.Id" name="@f.Id" value="@f.Val" data-hex-pair="@f.Id" />
            <input type="text" class="form-control admin-color-hex" id="@(f.Id)-hex" value="@f.Val" maxlength="7" data-hex-pair="@f.Id" aria-label="@L[f.Key]" />
          </div>
        </div>
      }
    </div>
  </div>

  <div class="admin-settings-card">
    <h3><i class="ti ti-qrcode" aria-hidden="true"></i>@L["admin.branding.referralQr"]</h3>
    <p class="admin-field-hint">@L["admin.branding.referralQrHint"]</p>
    <label class="admin-switch-line">
      <input type="hidden" name="ShowReferralQrWidget" value="false" />
      <input type="checkbox" name="ShowReferralQrWidget" value="true" @(Model.ShowReferralQrWidget ? "checked" : null) />
      <span>@L["admin.branding.referralQrShow"]</span>
    </label>
  </div>

  <div class="admin-settings-card admin-branding-actions">
    <button type="submit" class="btn-admin"><i class="ti ti-device-floppy" aria-hidden="true"></i>@L["admin.branding.save"]</button>
  </div>
</form>

@section Scripts {
<script>
(function () {
  var NO_FILE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["admin.branding.noFileChosen"].ToString()));
  var CROP_STRINGS = {
    zoom: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["crop.zoom"].ToString())),
    rotate: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["crop.rotate"].ToString())),
    reset: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["crop.reset"].ToString())),
    cancel: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["common.cancel"].ToString())),
    apply: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["crop.apply"].ToString())),
    free: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["crop.free"].ToString()))
  };

  function setPreview(input, file) {
    var imgId = input.getAttribute('data-preview-target');
    var phId = input.getAttribute('data-placeholder-id');
    var img = imgId ? document.getElementById(imgId) : null;
    var ph = phId ? document.getElementById(phId) : null;
    if (!file || !img) return;
    // Revoke the previous object URL so repeated crops don't leak memory.
    if (img.dataset.blobUrl) { try { URL.revokeObjectURL(img.dataset.blobUrl); } catch (e) { /* ignore */ } }
    var url = URL.createObjectURL(file);
    img.dataset.blobUrl = url;
    img.src = url;
    img.hidden = false;
    if (ph) ph.hidden = true;
  }

  /** Put the cropped output back into the input so the form post sends it. */
  function replaceFile(input, blob, name, type) {
    try {
      var dt = new DataTransfer();
      dt.items.add(new File([blob], name, { type: type || blob.type || "image/png" }));
      input.files = dt.files;
      return true;
    } catch (e) {
      return false;
    }
  }

  document.querySelectorAll('.admin-file-input').forEach(function (input) {
    input.addEventListener('change', function () {
      var nameEl = document.querySelector('[data-file-name-for="' + input.id + '"]');
      var file = input.files && input.files[0];
      if (!file) {
        if (nameEl) nameEl.textContent = NO_FILE;
        return;
      }
      if (nameEl) nameEl.textContent = file.name;
      setPreview(input, file);

      // Every raster image is cropped first; SVG passes straight through.
      if (!window.DaCropper || DaCropper.isVector(file)) return;
      DaCropper.open({
        file: file,
        // Logo keeps a wide lockup; favicon is square.
        aspect: input.id === "faviconFile" ? 1 : null,
        maxWidth: input.id === "faviconFile" ? 512 : 1600,
        maxHeight: input.id === "faviconFile" ? 512 : 600,
        title: input.id === "faviconFile"
          ? @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["admin.branding.favicon"].ToString()))
          : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["admin.branding.logo"].ToString())),
        strings: CROP_STRINGS,
        onApply: function (blob, meta) {
          if (meta && meta.passthrough) return;
          if (!replaceFile(input, blob, meta.name, meta.type)) {
            // Browser without DataTransfer.files — fall back to File.name spoofing.
            try {
              Object.defineProperty(blob, "name", { value: meta.name, configurable: true });
              input.files = Object.assign([blob], { item: function (i) { return this[i]; } });
            } catch (e2) { /* keep the original file */ }
          }
          if (nameEl) nameEl.textContent = meta.name;
          setPreview(input, blob);
        }
      });
    });
  });
})();
</script>
<script>
(function () {
  function normHex(v) {
    v = String(v || "").trim();
    if (!v) return "";
    if (!v.startsWith("#")) v = "#" + v;
    return v.length === 4 || v.length === 7 ? v : "";
  }
  document.querySelectorAll("[data-hex-pair]").forEach(function (el) {
    el.addEventListener("input", function () {
      var id = el.getAttribute("data-hex-pair");
      if (!id) return;
      var other = el.type === "color"
        ? document.getElementById(id + "-hex")
        : document.getElementById(id);
      if (!other) return;
      var v = normHex(el.value);
      if (!v) return;
      other.value = v;
    });
  });
  document.querySelectorAll(".admin-color-hex").forEach(function (txt) {
    txt.addEventListener("change", function () {
      var id = txt.getAttribute("data-hex-pair");
      var color = id ? document.getElementById(id) : null;
      var v = normHex(txt.value);
      if (color && v) color.value = v;
    });
  });
  var form = document.querySelector(".admin-branding-form");
  form?.addEventListener("submit", function () {
    document.querySelectorAll(".admin-color-hex").forEach(function (txt) {
      var id = txt.getAttribute("data-hex-pair");
      var color = id ? document.getElementById(id) : null;
      var v = normHex(txt.value);
      if (color && v) color.value = v;
    });
  });
})();
</script>
}
