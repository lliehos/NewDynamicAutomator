@model Morobot.Domain.Entities.PlanPrice
@using Morobot.Web.Areas.Admin.Models
@{
  ViewData["Title"] = L["admin.prices.create"];
  var plans = ViewBag.Plans as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}
<form method="post" class="admin-form-shell is-2col">
  @Html.AntiForgeryToken()
  <div class="admin-form-card">
    <div class="mb-2">
      <label>@L["admin.prices.plan"]</label>
      <select name="PlanId" class="form-select">
        @if (plans != null)
        {
          foreach (var p in plans)
          {
            <option value="@p.Value">@p.Text</option>
          }
        }
      </select>
    </div>
    <div class="mb-2"><label>@L["admin.prices.amount"]</label><input class="form-control" name="Amount" value="@Model.Amount" /></div>
  </div>
  <div class="admin-form-card">
    <div class="mb-2"><label>@L["admin.prices.currency"]</label><input class="form-control" name="Currency" value="@Model.Currency" /></div>
    <div class="mb-2"><label>@L["admin.prices.interval"]</label><input class="form-control" name="Interval" value="@Model.Interval" /></div>
    <div class="mb-2"><label>@L["admin.prices.notes"]</label><input class="form-control" name="Notes" value="@Model.Notes" /></div>
    <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "IsActive", Label = L["admin.plans.active"], Checked = true, Id = "priceActive" }' />
  </div>
  <div class="admin-form-actions" style="grid-column:1/-1">
    <button type="submit" class="btn-admin">@L["admin.common.create"]</button>
    <a class="btn-admin secondary" asp-action="Index">@L["admin.common.back"]</a>
  </div>
</form>
