@model Morobot.Domain.Entities.Plan
@using Morobot.Web.Areas.Admin.Models
@*
  Deliberately NOT wrapped in its own .admin-form-shell: the caller (Create/Edit) already owns that
  grid. An earlier version opened a second shell here, which nested a 1-column grid inside a 1-column
  grid — every card stacked full width and the price boxes stretched the whole row.
*@
  <div class="admin-form-card">
    <h4><i class="ti ti-tag" aria-hidden="true"></i>@L["admin.plans.name"]</h4>
    <div class="mb-2">
      <label class="admin-label"><span>@L["admin.plans.nameFa"]</span><partial name="_AdminHint" model='L["admin.hints.planNameFa"]' /></label>
      <input class="form-control" name="NameFa" value="@Model.NameFa" required />
    </div>
    <div class="mb-2">
      <label class="admin-label"><span>@L["admin.plans.nameEn"]</span><partial name="_AdminHint" model='L["admin.hints.planNameEn"]' /></label>
      <input class="form-control" name="NameEn" value="@Model.NameEn" required />
    </div>
    <div class="mb-2">
      <label class="admin-label"><span>@L["admin.plans.sort"]</span><partial name="_AdminHint" model='L["admin.hints.planSort"]' /></label>
      <input class="form-control" name="SortOrder" type="number" value="@Model.SortOrder" />
    </div>
    <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "IsActive", Label = L["admin.plans.active"], Checked = Model.IsActive, Hint = L["admin.hints.planActive"] }' />
  </div>

  <div class="admin-form-card">
    <h4><i class="ti ti-adjustments" aria-hidden="true"></i>@L["admin.plans.limits"]</h4>
    <div class="mb-2">
      <label class="admin-label"><span>@L["admin.plans.maxTasks"]</span><partial name="_AdminHint" model='L["admin.hints.maxTasks"]' /></label>
      <input class="form-control" name="MaxTasks" value="@Model.MaxTasks" placeholder="∞" />
    </div>
    <div class="mb-2">
      <label class="admin-label"><span>@L["admin.plans.maxSources"]</span><partial name="_AdminHint" model='L["admin.hints.maxSources"]' /></label>
      <input class="form-control" name="MaxDataSources" value="@Model.MaxDataSources" placeholder="∞" />
    </div>
    <div class="mb-2">
      <label class="admin-label"><span>@L["admin.plans.maxProcessSteps"]</span><partial name="_AdminHint" model='L["admin.hints.maxSteps"]' /></label>
      <input class="form-control" name="MaxProcessSteps" value="@Model.MaxProcessSteps" placeholder="∞" />
    </div>
    <div class="mb-2">
      <label class="admin-label"><span>@L["admin.plans.maxSourceRows"]</span><partial name="_AdminHint" model='L["admin.hints.maxSourceRows"]' /></label>
      <input class="form-control" name="MaxSourceRows" value="@Model.MaxSourceRows" placeholder="∞" />
    </div>
    <div class="mb-2">
      <label class="admin-label"><span>@L["admin.plans.maxSourceBytes"]</span><partial name="_AdminHint" model='L["admin.hints.maxSourceBytes"]' /></label>
      <input class="form-control" name="MaxSourceBytes" value="@Model.MaxSourceBytes" placeholder="∞" />
    </div>
  </div>

  <div class="admin-form-card">
    <h4><i class="ti ti-currency-dollar" aria-hidden="true"></i>@L["admin.plans.pricing"]</h4>
    <p class="admin-field-hint">@L["admin.plans.pricingHint"]</p>
    <div class="mb-2">
      <label class="admin-label"><span>@L["admin.plans.currency"]</span><partial name="_AdminHint" model='L["admin.hints.planCurrency"]' /></label>
      <input class="form-control" name="PriceCurrency" value="@Model.PriceCurrency" dir="ltr" maxlength="8" placeholder="IRR" />
    </div>

    @* Each cycle is its own row: amount, then the discount shown against it. The discount is a
       percentage rather than a second amount so the page cannot advertise a yearly figure that
       contradicts the saving it claims. *@
    <div class="admin-price-row">
      <div>
        <label class="admin-label"><span>@L["admin.plans.monthlyPrice"]</span><partial name="_AdminHint" model='L["admin.hints.monthlyPrice"]' /></label>
        <input class="form-control" name="MonthlyPrice" type="number" step="0.01" min="0"
               value="@(Model.MonthlyPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
               dir="ltr" placeholder="—" />
      </div>
      <div>
        <label class="admin-label"><span>@L["admin.plans.monthlyDiscount"]</span><partial name="_AdminHint" model='L["admin.hints.discountPercent"]' /></label>
        <input class="form-control" name="MonthlyDiscountPercent" type="number" step="0.01" min="0" max="100"
               value="@(Model.MonthlyDiscountPercent?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
               dir="ltr" placeholder="0" />
      </div>
    </div>

    <div class="admin-price-row" style="margin-top:.75rem">
      <div>
        <label class="admin-label"><span>@L["admin.plans.yearlyPrice"]</span><partial name="_AdminHint" model='L["admin.hints.yearlyPrice"]' /></label>
        <input class="form-control" name="YearlyPrice" type="number" step="0.01" min="0"
               value="@(Model.YearlyPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
               dir="ltr" placeholder="—" />
      </div>
      <div>
        <label class="admin-label"><span>@L["admin.plans.yearlyDiscount"]</span><partial name="_AdminHint" model='L["admin.hints.discountPercent"]' /></label>
        <input class="form-control" name="YearlyDiscountPercent" type="number" step="0.01" min="0" max="100"
               value="@(Model.YearlyDiscountPercent?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
               dir="ltr" placeholder="0" />
      </div>
    </div>
  </div>

  <div class="admin-form-card">
    <h4><i class="ti ti-lock" aria-hidden="true"></i>@L["admin.plans.password"]</h4>
    <p class="admin-field-hint">@L["admin.plans.passwordHint"]</p>
    <div class="mb-2">
      <label class="admin-label"><span>@L["admin.plans.minPassword"]</span><partial name="_AdminHint" model='L["admin.hints.minPassword"]' /></label>
      <input class="form-control" name="MinPasswordLength" type="number" min="1" max="128" value="@Model.MinPasswordLength" />
    </div>
    <div class="admin-switch-grid">
      <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "RequireLetterAndDigit", Label = L["admin.plans.requireLetterDigit"], Checked = Model.RequireLetterAndDigit, Hint = L["admin.hints.requireLetterDigit"] }' />
      <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "AllowSelfUpgrade", Label = L["admin.plans.selfUpgrade"], Checked = Model.AllowSelfUpgrade, Hint = L["admin.hints.selfUpgrade"] }' />
    </div>
  </div>

  <div class="admin-form-card">
    <h4><i class="ti ti-toggle-right" aria-hidden="true"></i>@L["admin.plans.caps"]</h4>
    <div class="admin-switch-grid">
      <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "CanPlay", Label = L["admin.plans.canPlay"], Checked = Model.CanPlay, Hint = L["admin.hints.canPlay"] }' />
      <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "CanSelector", Label = L["admin.plans.canSelector"], Checked = Model.CanSelector, Hint = L["admin.hints.canSelector"] }' />
      <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "CanRecord", Label = L["admin.plans.canRecord"], Checked = Model.CanRecord, Hint = L["admin.hints.canRecord"] }' />
      <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "CanSmart", Label = L["admin.plans.canSmart"], Checked = Model.CanSmart, Hint = L["admin.hints.canSmart"] }' />
    </div>
  </div>

  <div class="admin-form-card" style="grid-column:1/-1">
    <h4><i class="ti ti-share" aria-hidden="true"></i>@L["admin.plans.shareSection"]</h4>
    <div class="admin-form-shell is-2col">
      <div>
        <div class="admin-switch-grid">
          <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "CanShare", Label = L["admin.plans.canShare"], Checked = Model.CanShare, Hint = L["admin.hints.canShare"] }' />
          <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "CanReceiveShare", Label = L["admin.plans.canReceiveShare"], Checked = Model.CanReceiveShare, Hint = L["admin.hints.canReceiveShare"] }' />
        </div>
        <div class="mb-2" style="margin-top:.75rem">
          <label class="admin-label"><span>@L["admin.plans.maxShares"]</span><partial name="_AdminHint" model='L["admin.hints.maxShares"]' /></label>
          <input class="form-control" name="MaxSharesPerTask" value="@Model.MaxSharesPerTask" placeholder="∞" />
        </div>
      </div>
      <div>
        <p class="admin-field-hint">@L["admin.plans.shareGrantsHint"]</p>
        <div class="admin-switch-grid">
          <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "ShareAllowView", Label = L["admin.plans.shareView"], Checked = Model.ShareAllowView, Hint = L["admin.hints.shareView"] }' />
          <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "ShareAllowEdit", Label = L["admin.plans.shareEdit"], Checked = Model.ShareAllowEdit, Hint = L["admin.hints.shareEdit"] }' />
          <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "ShareAllowDelete", Label = L["admin.plans.shareDelete"], Checked = Model.ShareAllowDelete, Hint = L["admin.hints.shareDelete"] }' />
          <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "ShareAllowExecute", Label = L["admin.plans.shareExecute"], Checked = Model.ShareAllowExecute, Hint = L["admin.hints.shareExecute"] }' />
          <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "ShareAllowChangeDataSource", Label = L["admin.plans.shareDs"], Checked = Model.ShareAllowChangeDataSource, Hint = L["admin.hints.shareDs"] }' />
        </div>
      </div>
    </div>
  </div>
