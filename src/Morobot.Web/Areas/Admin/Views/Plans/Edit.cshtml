@model Morobot.Domain.Entities.Plan
@{
  Layout = "_Layout";
  ViewData["Title"] = L["admin.plans.edit"];
}
<form method="post" class="admin-form-shell">
  @Html.AntiForgeryToken()
  <div class="admin-form-card">
    <p style="margin:0"><strong>@Model.Code</strong></p>
  </div>
  <partial name="_PlanFields" model="Model" />
  <div class="admin-form-actions">
    <button type="submit" class="btn-admin"><i class="ti ti-device-floppy" aria-hidden="true"></i>@L["admin.common.save"]</button>
    <a class="btn-admin secondary" asp-action="Index"><i class="ti ti-arrow-right" aria-hidden="true"></i>@L["admin.common.back"]</a>
  </div>
</form>
