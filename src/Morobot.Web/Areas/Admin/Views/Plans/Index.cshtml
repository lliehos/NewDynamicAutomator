@model IEnumerable<Morobot.Domain.Entities.Plan>
@using Morobot.Web.Areas.Admin.Models
@{
  Layout = "_Layout";
  ViewData["Title"] = L["admin.plans.title"];
  var list = Model.ToList();
}
<partial name="_AdminPageHead" model='new AdminPageHeadModel {
  Summary = L.T("admin.plans.summary", ("count", list.Count.ToString())),
  ActionText = L["admin.plans.create"],
  ActionUrl = Url.Action("Create"),
  ActionIcon = "ti-plus"
}' />

<div class="admin-table-wrap" data-page-size="20">
<table class="admin-table">
  <thead>
    <tr>
      <th>@L["admin.plans.code"]</th>
      <th>@L["admin.plans.name"]</th>
      <th>@L["admin.plans.limits"]</th>
      <th>@L["admin.plans.caps"]</th>
      <th>@L["admin.plans.pricing"]</th>
      <th>@L["admin.plans.password"]</th>
      <th>@L["admin.plans.active"]</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
  @foreach (var p in list)
  {
    <tr>
      <td><code>@p.Code</code></td>
      <td>@p.NameEn / @p.NameFa</td>
      <td>
        <span class="admin-chip" title="@L["admin.plans.maxTasks"]"><i class="ti ti-git-branch" aria-hidden="true"></i>@(@p.MaxTasks?.ToString() ?? "âˆ‍")</span>
        <span class="admin-chip" title="@L["admin.plans.maxSources"]"><i class="ti ti-database" aria-hidden="true"></i>@(@p.MaxDataSources?.ToString() ?? "âˆ‍")</span>
        <span class="admin-chip" title="@L["admin.plans.maxProcessSteps"]"><i class="ti ti-list-numbers" aria-hidden="true"></i>@(@p.MaxProcessSteps?.ToString() ?? "âˆ‍")</span>
        <span class="admin-chip" title="@L["admin.plans.maxSourceRows"]"><i class="ti ti-rows" aria-hidden="true"></i>@(@p.MaxSourceRows?.ToString() ?? "âˆ‍")</span>
        <span class="admin-chip" title="@L["admin.plans.maxSourceBytes"]"><i class="ti ti-file-database" aria-hidden="true"></i>@(Morobot.Web.Areas.Admin.Views.Plans.PlanViewFormat.Size(p.MaxSourceBytes))</span>
      </td>
      <td><partial name="_AdminPlanCaps" model="p" /></td>
      <td>        @* Two cycles, each showing its amount and, when set, the discount advertised against it.
           A plan with no price for a cycle shows a dash rather than 0 — "not sold" and "free" are
           different answers and the admin needs to tell them apart. *@
        @{ var currency = p.PriceCurrency; }
        <div class="admin-price-chip">
          <span class="admin-price-cycle">@L["admin.plans.monthlyShort"]</span>
          @if (p.MonthlyPrice is decimal mp)
          {
            <span class="admin-price-amount">@mp.ToString("N0") <small>@currency</small></span>
            @if (p.MonthlyDiscountPercent is decimal md and > 0)
            {
              <span class="admin-price-off">@md.ToString("0.##")% @L["admin.plans.off"]</span>
            }
          }
          else
          {
            <span class="admin-price-none">—</span>
          }
        </div>
        <div class="admin-price-chip">
          <span class="admin-price-cycle">@L["admin.plans.yearlyShort"]</span>
          @if (p.YearlyPrice is decimal yp)
          {
            <span class="admin-price-amount">@yp.ToString("N0") <small>@currency</small></span>
            @if (p.YearlyDiscountPercent is decimal yd and > 0)
            {
              <span class="admin-price-off">@yd.ToString("0.##")% @L["admin.plans.off"]</span>
            }
          }
          else
          {
            <span class="admin-price-none">—</span>
          }
        </div>
      </td>
      <td>        â‰¥@p.MinPasswordLength
        @(p.RequireLetterAndDigit ? " آ· Aa1" : "")
      </td>
      <td><partial name="_AdminStatus" model="p.IsActive" /></td>
      <td>
        <a class="btn-admin secondary icon-only" asp-action="Edit" asp-route-id="@p.Id" title="@L["admin.common.edit"]">
          <i class="ti ti-pencil" aria-hidden="true"></i>
        </a>
      </td>
    </tr>
  }
  </tbody>
</table>
</div>
