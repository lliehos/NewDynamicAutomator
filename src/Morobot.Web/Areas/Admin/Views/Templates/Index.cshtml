@model IReadOnlyList<Morobot.Contracts.Tasks.ProcessTemplateDto>
@{
  ViewData["Title"] = L["admin.templates.title"];
  var templates = Model.ToList();
  // A template nobody follows is a leftover: an adopted-then-dropped one, or one that was never
  // used. It is the same rule the service applies when sweeping them.
  var unusedCount = templates.Count(t => t.AttachedProcessCount == 0);
}
<p class="text-muted small mb-3">@L["admin.templates.intro"]</p>

@if (templates.Count > 0)
{
@* Selection toolbar. Ticked rows are collected by admin-bulk.js into the DeleteMany form;
   "delete unused" is a one-click server-side sweep and needs no selection. *@
<div class="admin-bulk-bar" data-bulk-for="#admin-template-rows">
  <span class="admin-bulk-count" data-bulk-count></span>
  <form method="post" asp-action="DeleteMany" data-bulk-form>
    @Html.AntiForgeryToken()
    <button type="submit" class="btn-admin danger" data-bulk-delete disabled>@L["admin.common.deleteSelected"]</button>
  </form>
  <form method="post" asp-action="DeleteUnused" class="admin-bulk-unused"
        onsubmit="return confirm('@L.T("admin.templates.deleteUnusedConfirm", ("count", unusedCount.ToString()))');">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn-admin secondary" disabled="@(unusedCount == 0)">@L.T("admin.templates.deleteUnused", ("count", unusedCount.ToString()))</button>
  </form>
</div>
}

@if (templates.Count == 0)
{
  <p class="text-muted">@L["admin.templates.empty"]</p>
}
else
{
  <div class="admin-table-wrap" data-page-size="20">
    <table class="admin-table" id="admin-template-table">
      <thead>
        <tr>
          <th class="admin-bulk-col"><input type="checkbox" class="admin-bulk-all" aria-label="@L["admin.common.selectAll"]" /></th>
          <th>@L["admin.templates.colId"]</th>
          <th>@L["admin.templates.colTitle"]</th>
          <th>@L["admin.templates.colVersion"]</th>
          <th>@L["admin.templates.colSteps"]</th>
          <th>@L["admin.templates.colMother"]</th>
          <th>@L["admin.templates.colAttached"]</th>
          <th>@L["admin.templates.colCreator"]</th>
          <th>@L["admin.templates.colUpdated"]</th>
          <th>@L["admin.templates.colOps"]</th>
        </tr>
      </thead>
      <tbody id="admin-template-rows">
        @foreach (var t in templates)
        {
          <tr data-template-id="@t.Id">
            <td class="admin-bulk-col"><input type="checkbox" class="admin-bulk-check" value="@t.Id" aria-label="@t.Title" /></td>
            <td>@t.Id</td>
            <td>
              <div class="fw-semibold">@t.Title</div>
              @if (!string.IsNullOrWhiteSpace(t.Description))
              {
                <div class="text-muted small">@t.Description</div>
              }
            </td>
            <td>@t.Version</td>
            <td>@t.StepCount</td>
            <td>
              @if (t.SourceProcessId is int motherId)
              {
                @* Naming the mother is the point of this column: it is the process whose edits
                   cascade into every attached child, so an admin looking at a template needs to
                   know which process owns it. A dash means the mother was deleted and the template
                   now stands alone — a supported state, not an error. *@
                <a href="@Url.Action("Index", "Processes", new { area = "Admin" })">@(t.SourceProcessTitle ?? $"#{motherId}")</a>
              }
              else
              {
                <span class="text-muted">—</span>
              }
            </td>
            <td>@t.AttachedProcessCount</td>
            <td>@(string.IsNullOrWhiteSpace(t.CreatorUserName) ? "—" : t.CreatorUserName)</td>
            <td class="text-nowrap">@Morobot.Web.Services.DateDisplay.DateTimeLocal(t.UpdatedAtUtc)</td>
            <td class="text-nowrap">
              @* Deleting a template detaches its processes rather than deleting them, so the
                 confirmation says how many will be cut loose. *@
              <form method="post" asp-action="Delete" asp-route-id="@t.Id" class="d-inline"
                    onsubmit="return confirm('@L.T("admin.templates.deleteConfirm", ("title", t.Title), ("attached", t.AttachedProcessCount.ToString()))');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-admin danger" title="@L["admin.templates.delete"]">@L["admin.templates.delete"]</button>
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
}
