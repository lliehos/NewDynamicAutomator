@using Morobot.Infrastructure.Services
@{
  ViewData["Title"] = "انتقال از دیتابیس قدیمی";
}
<div class="card-admin">
  <p>Connection string دیتابیس قدیمی را وارد کنید. فقط فرآیندهایی که کاربر <strong>مالک</strong> آن‌هاست (Creator) با گروه/مرحله/شرط منتقل می‌شوند — مبدأ «انتقال». منابع داده منتقل نمی‌شوند (کتابخانهٔ جدا).</p>
  @if (ViewBag.Error != null)
  {
    <div style="color:#b91c1c;margin-bottom:1rem">@ViewBag.Error</div>
  }
  <form method="post" asp-area="Admin" asp-controller="Migrate" asp-action="Connect">
    @Html.AntiForgeryToken()
    <label>Connection string
      <textarea class="form-control" name="connectionString" rows="3" required placeholder="Server=.;Database=dynamicAutomatorV2;Trusted_Connection=True;TrustServerCertificate=True">@ViewBag.ConnectionString</textarea>
    </label>
    <div style="margin-top:1rem">
      <button type="submit" class="btn-admin">اتصال و فهرست کاربران</button>
    </div>
  </form>
</div>
