@using Morobot.Infrastructure.Services
@using Morobot.Web.Areas.Admin.Models
@{
  ViewData["Title"] = L["admin.migrate.title"];
}
<partial name="_AdminPageHead" model='new AdminPageHeadModel {
  Summary = L["admin.migrate.intro"]
}' />

<div class="admin-form-shell">
  <div class="admin-form-card">
    @if (ViewBag.Error != null)
    {
      <div class="admin-alert is-error">@ViewBag.Error</div>
    }
    <form method="post" asp-area="Admin" asp-controller="Migrate" asp-action="Connect">
      @Html.AntiForgeryToken()
      <div class="admin-field-block">
        <label class="admin-label" for="migrate-conn">
          <span>@L["admin.migrate.connectionString"]</span>
          <partial name="_AdminHint" model='L["admin.migrate.connectionHint"]' />
        </label>
        <textarea class="form-control admin-textarea"
                  id="migrate-conn"
                  name="connectionString"
                  rows="4"
                  required
                  spellcheck="false"
                  placeholder="Server=.;Database=dynamicAutomatorV2;Trusted_Connection=True;TrustServerCertificate=True">@ViewBag.ConnectionString</textarea>
      </div>
      <div class="admin-form-actions">
        <button type="submit" class="btn-admin">
          <i class="ti ti-plug-connected" aria-hidden="true"></i>
          @L["admin.migrate.connect"]
        </button>
      </div>
    </form>
  </div>
</div>

@* The wizard is a repeated operator task; cache the connection string in THIS browser so the admin
   does not re-enter it on every visit. It never leaves the machine — no server-side storage. *@
<script>
  (function () {
    var KEY = 'morobot.migrate.connectionString';
    var el = document.getElementById('migrate-conn');
    if (!el) return;
    try {
      if (!el.value) {
        var saved = localStorage.getItem(KEY);
        if (saved) el.value = saved;
      }
      var save = function () {
        try {
          var v = el.value.trim();
          if (v) localStorage.setItem(KEY, v);
          else localStorage.removeItem(KEY);
        } catch (_) { /* storage disabled — ignore */ }
      };
      el.addEventListener('input', save);
      el.closest('form').addEventListener('submit', save);
    } catch (_) { /* storage disabled — ignore */ }
  })();
</script>
