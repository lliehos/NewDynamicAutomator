@using Morobot.Infrastructure.Services
@{
  ViewData["Title"] = "نتیجه انتقال";
  var report = ViewBag.Report as LegacyImportReport;
}
<div class="card-admin">
  @if (report != null)
  {
    <p>
      کاربران جدید: <strong>@report.UsersCreated</strong> —
      تطبیق‌شده: <strong>@report.UsersMatched</strong> —
      فرآیند واردشده: <strong>@report.ProcessesImported</strong> —
      ردشده: <strong>@report.ProcessesSkipped</strong> —
      خطا: <strong>@report.Errors</strong>
    </p>
    <pre style="white-space:pre-wrap;background:#f8fafc;padding:1rem;border-radius:.5rem;max-height:28rem;overflow:auto">@string.Join("\n", report.Lines)</pre>
  }
  <a class="btn-admin" asp-area="Admin" asp-controller="Migrate" asp-action="Index">انتقال دیگر</a>
  <a class="btn-admin secondary" asp-area="Admin" asp-controller="Processes" asp-action="Index">فرآیندها</a>
</div>
