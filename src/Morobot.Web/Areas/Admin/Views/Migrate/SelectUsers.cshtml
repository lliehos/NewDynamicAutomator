@using Morobot.Infrastructure.Services
@{
  ViewData["Title"] = "انتخاب کاربران برای انتقال";
  var users = ViewBag.Users as List<LegacyUserRow> ?? new List<LegacyUserRow>();
}
<div class="card-admin">
  <p>کاربران دیتابیس قدیمی — چند مورد را انتخاب کنید.</p>
  <form method="post" asp-area="Admin" asp-controller="Migrate" asp-action="Run">
    @Html.AntiForgeryToken()
    <input type="hidden" name="connectionString" value="@ViewBag.ConnectionString" />
    <table class="admin-table">
      <thead>
        <tr>
          <th></th>
          <th>Id</th>
          <th>نام کاربری</th>
          <th>نام</th>
          <th>فرآیندها</th>
        </tr>
      </thead>
      <tbody>
      @foreach (var u in users)
      {
        <tr>
          <td><input type="checkbox" name="userIds" value="@u.Id" @(u.ProcessCount > 0 ? "checked" : null) /></td>
          <td>@u.Id</td>
          <td>@u.UserName</td>
          <td>@($"{u.FirstName} {u.LastName}".Trim())</td>
          <td>@u.ProcessCount</td>
        </tr>
      }
      </tbody>
    </table>
    <div style="margin-top:1rem;display:flex;gap:.75rem">
      <button type="submit" class="btn-admin">انتقال انتخاب‌شده‌ها</button>
      <a class="btn-admin secondary" asp-area="Admin" asp-controller="Migrate" asp-action="Index">بازگشت</a>
    </div>
  </form>
</div>
