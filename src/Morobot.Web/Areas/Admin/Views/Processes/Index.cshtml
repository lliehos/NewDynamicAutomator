@model IEnumerable<Morobot.Contracts.Tasks.TaskListItemDto>
@{
  ViewData["Title"] = "Processes";
}
<table class="admin-table">
  <thead>
    <tr>
      <th>Id</th>
      <th>Title</th>
      <th>Owner</th>
      <th>Origin</th>
      <th>Created</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
  @foreach (var t in Model)
  {
    <tr>
      <td>@t.Id</td>
      <td>@t.Title</td>
      <td>@(t.OwnerUserName ?? "—")</td>
      <td>@t.DesignOrigin</td>
      <td>@t.CreatedAtUtc.ToString("u")</td>
      <td>
        <form method="post" asp-action="Delete" asp-route-id="@t.Id" onsubmit="return confirm('Delete process #@t.Id?');">
          @Html.AntiForgeryToken()
          <button type="submit" class="btn-admin danger">Delete</button>
        </form>
      </td>
    </tr>
  }
  </tbody>
</table>
