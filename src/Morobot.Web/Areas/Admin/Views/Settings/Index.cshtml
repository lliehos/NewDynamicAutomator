@model Morobot.Web.Areas.Admin.Models.AdminSettingsViewModel
@using Morobot.Domain
@{
  Layout = "_Layout";
  ViewData["Title"] = L["admin.settings.title"];
  var isFa = L.IsRtl;
  // Groups are ordered by their declared presentation order so the page reads
  // Auth → Updates → Deployment, and any future group without metadata lands last.
  var groups = Model.Settings
    .GroupBy(s => s.Group)
    .OrderBy(g => SystemSettingKeys.SettingGroupInfo.OrderOf(g.Key))
    .ToList();
}

<partial name="_AdminPageHead" model='new AdminPageHeadModel {
  Summary = L["admin.settings.intro"],
  ActionText = L["admin.settings.gotoPlans"],
  ActionUrl = Url.Action("Index", "Plans"),
  ActionIcon = "ti-layers-intersect"
}' />

<form method="post" class="admin-settings-form">
  @Html.AntiForgeryToken()

  @* Category rail: quick jump between groups, so a long settings page stays navigable. *@
  <nav class="admin-settings-toc" aria-label="@L["admin.settings.categories"]">
    @foreach (var group in groups)
    {
      var key = SystemSettingKeys.SettingGroupInfo.LocaleKeyOf(group.Key);
      <a href="#settings-group-@key" class="admin-settings-toc-item">
        <i class="ti @SystemSettingKeys.SettingGroupInfo.IconOf(group.Key)" aria-hidden="true"></i>
        <span>@L["admin.settings.groups." + key + ".title"]</span>
        <span class="admin-settings-toc-count">@Model.VisibleCount(group)</span>
      </a>
    }
  </nav>

  <div class="admin-settings-grid">
    @foreach (var group in groups)
    {
      var gkey = SystemSettingKeys.SettingGroupInfo.LocaleKeyOf(group.Key);
      var gtitle = L["admin.settings.groups." + gkey + ".title"];
      var gdesc = L["admin.settings.groups." + gkey + ".desc"];
      // One card per group. The Diagram group used to be split in two here because its colours lived
      // on Branding while its behaviour defaults lived here; both halves are on Branding now, so the
      // split has nothing left to describe.
      var cards = new[] { (Key: gkey, Title: gtitle, Desc: gdesc, Rows: group.ToList()) };
      @foreach (var card in cards.Where(c => c.Rows.Count > 0))
      {
        var gkey2 = card.Key;
        gtitle = card.Title;
        gdesc = card.Desc;
        var rows = card.Rows;
      <section class="admin-settings-card" id="settings-group-@gkey2">
        <h3>
          <i class="ti @SystemSettingKeys.SettingGroupInfo.IconOf(group.Key)" aria-hidden="true"></i>
          <span>@gtitle</span>
          <span class="admin-settings-card-count">@Model.VisibleCount(rows)</span>
        </h3>
        @if (!string.IsNullOrWhiteSpace(gdesc) && !gdesc.StartsWith("admin.settings.groups."))
        {
          <p class="admin-settings-card-desc">@gdesc</p>
        }

        @foreach (var s in rows)
        {
          // The legacy single-value auth row is superseded by the two switches below. Leaving it
          // on the page would offer a second, contradictory way to choose the same thing.
          if (s.Key == SystemSettingKeys.AuthMode) continue;
          var hint = isFa ? s.HintFa : s.HintEn;
          var label = isFa ? s.LabelFa : s.LabelEn;
          var readOnly = SystemSettingKeys.IsReadOnlyForAdmin(s.Key);
          var isSecret = SystemSettingKeys.IsSensitiveForAdmin(s.Key);
          var secretSet = isSecret && !string.IsNullOrWhiteSpace(s.Value);
          // The two sign-in switches: rendered as checkboxes, and the LDAP-only fields below are
          // hidden while the LDAP switch is off (the server keeps them intact either way).
          var isAuthSwitch = s.Key is SystemSettingKeys.AuthLocalEnabled or SystemSettingKeys.AuthLdapEnabled;
          var authSwitchOn = string.Equals(s.Value, "true", StringComparison.OrdinalIgnoreCase) || s.Value == "1";
          // Any other plain flag (use TLS, the two ignore-error defaults) also gets a switch rather
          // than a text box, so a mistyped value cannot read as "off".
          var isBooleanSwitch = !isAuthSwitch && SystemSettingKeys.IsBoolean(s.Key);
          var boolSwitchOn = string.Equals(s.Value, "true", StringComparison.OrdinalIgnoreCase) || s.Value == "1";
          var isLdapField = SystemSettingKeys.IsLdapOnly(s.Key);
          <div class="admin-settings-field@(isLdapField ? " admin-settings-ldap-field" : null)"
               @(isLdapField ? "data-ldap-field" : null)>
            <label class="admin-label" for="setting_@s.Key">
              <span>@label</span>
              @if (readOnly)
              {
                <span class="admin-settings-ro-badge" title="@L["admin.settings.systemManagedHint"]">
                  <i class="ti ti-lock" aria-hidden="true"></i>@L["admin.settings.systemManaged"]
                </span>
              }
            </label>

            @if (isAuthSwitch)
            {
              @* A hidden "false" plus a checkbox: the browser posts the checkbox value only when
                 ticked, so the hidden entry guarantees a value either way and the last one wins.
                 `data-da-switch="off"` stops da-switch.js from ALSO restyling this input: it would
                 add a second switch track on top of the one below, leaving two switches per row. *@
              <label class="admin-settings-switch" for="setting_@s.Key">
                <input type="hidden" name="setting_@s.Key" value="false" />
                <input type="checkbox" id="setting_@s.Key" name="setting_@s.Key" value="true"
                       data-auth-switch="true" data-da-switch="off" @(authSwitchOn ? "checked" : null) />
                <span class="admin-settings-switch-track" aria-hidden="true"></span>
              </label>
            }
            else if (isBooleanSwitch)
            {
              <label class="admin-settings-switch" for="setting_@s.Key">
                <input type="hidden" name="setting_@s.Key" value="false" />
                <input type="checkbox" id="setting_@s.Key" name="setting_@s.Key" value="true"
                       data-da-switch="off" @(boolSwitchOn ? "checked" : null) />
                <span class="admin-settings-switch-track" aria-hidden="true"></span>
              </label>
            }
            else if (s.Key == SystemSettingKeys.DefaultRegisterPlan)
            {
              <select class="form-select" id="setting_@s.Key" name="setting_@s.Key">
                @foreach (var plan in Model.Plans.Where(p => p.IsActive).OrderBy(p => p.SortOrder))
                {
                  var planLabel = isFa ? plan.NameFa : plan.NameEn;
                  <option value="@plan.Code" selected="@(string.Equals(s.Value, plan.Code, StringComparison.OrdinalIgnoreCase))">@planLabel (@plan.Code)</option>
                }
              </select>
            }
            else if (SystemSettingKeys.IsLanguageChoice(s.Key))
            {
              @* A language is a fixed choice, not free text: only the locales that ship can be
                 rendered, so a text box would let an administrator store a code nothing can draw.
                 When the licence excludes the second language this still renders — the setting is
                 what decides WHICH single language the install uses, so hiding it would leave the
                 deployment locked to a language nobody chose. *@
              var currentLang = string.IsNullOrWhiteSpace(s.Value) ? "fa" : s.Value.Trim().ToLowerInvariant();
              <select class="form-select" id="setting_@s.Key" name="setting_@s.Key" dir="ltr">
                <option value="fa" selected="@(currentLang == "fa")">فارسی (fa)</option>
                <option value="en" selected="@(currentLang == "en")">English (en)</option>
              </select>
              @if (!L.Bilingual)
              {
                <p class="admin-field-hint">@L["admin.settings.bilingualOff"]</p>
              }
            }
            else if (s.Key == SystemSettingKeys.LdapNameFormat)
            {              @* One choice per form the directory accepts, rather than a text box the administrator
                 can misspell. The value stored is the enum name, which the resolver parses back. *@
              var current = string.IsNullOrWhiteSpace(s.Value)
                ? nameof(Morobot.Contracts.Auth.LdapNameFormat.DomainBackslash)
                : s.Value.Trim();
              <select class="form-select" id="setting_@s.Key" name="setting_@s.Key">
                @foreach (var fmt in Enum.GetValues<Morobot.Contracts.Auth.LdapNameFormat>())
                {
                  var fmtLabel = fmt switch
                  {
                    Morobot.Contracts.Auth.LdapNameFormat.UserPrincipalName => L["admin.settings.ldapFormatUpn"],
                    Morobot.Contracts.Auth.LdapNameFormat.PlainUserName => L["admin.settings.ldapFormatPlain"],
                    _ => L["admin.settings.ldapFormatDomain"]
                  };
                  <option value="@fmt" selected="@(string.Equals(current, fmt.ToString(), StringComparison.OrdinalIgnoreCase))">@fmtLabel</option>
                }
              </select>
            }
            else if (readOnly)
            {
              @* Printed, not put in a disabled box. An empty disabled input looks like a field
                 waiting to be filled, which is exactly the wrong signal for a value the system
                 owns and may not have set yet; a printed value (or a dash) reads as a fact.
                 No name attribute, so the POST omits it and the owning service keeps authority. *@
              var roText = string.IsNullOrWhiteSpace(s.Value) ? null : s.Value.Trim();
              <div class="admin-settings-ro-value" id="setting_@s.Key">
                @if (roText is null)
                {
                  <span class="admin-muted" title="@L["admin.settings.notSetYet"]">—</span>
                }
                else
                {
                  <code>@roText</code>
                }
              </div>
            }
            else if (isSecret)
            {
              @* Deliberately empty and never round-tripped: printing the stored secret into the
                 page would hand it to anyone who can open developer tools, so the field starts
                 blank with a placeholder saying what happens if it is left that way. Saving an
                 empty value keeps the stored secret (see SettingsController). *@
              <input class="form-control" type="password" id="setting_@s.Key" name="setting_@s.Key"
                     value="" autocomplete="new-password"
                     placeholder="@(secretSet ? L["admin.settings.secretKeep"] : L["admin.settings.secretEmpty"])" />
            }
            else
            {
              @* No colour branch: every colour, diagram included, is edited on Admin → Branding,
                 where it has a picker, a hex box and a reset. Rendering one here too would give the
                 same row two editors and let a stale Settings form overwrite a fresh palette. *@
              <input class="form-control" id="setting_@s.Key" name="setting_@s.Key" value="@s.Value" />
            }

            @if (!string.IsNullOrWhiteSpace(hint))
            {
              <div class="admin-field-hint">@hint</div>
            }

            @* Who last changed this value, and when. A seeded value nobody has touched says so,
               rather than showing a blank that reads like a missing figure. *@
            @if (s.LastChangedAtUtc is not null)
            {
              <div class="admin-settings-changed">
                <i class="ti ti-history" aria-hidden="true"></i>
                <span>
                  @L["admin.settings.lastChangedBy"]
                  <strong>@(string.IsNullOrWhiteSpace(s.LastChangedByUserName) ? L["admin.settings.unknownUser"] : s.LastChangedByUserName)</strong>
                  · @Morobot.Web.Services.DateDisplay.DateTimeLocal(s.LastChangedAtUtc.Value)
                </span>
              </div>
            }
            else
            {
              <div class="admin-settings-changed is-muted">
                <i class="ti ti-history" aria-hidden="true"></i>
                <span>@L["admin.settings.neverChanged"]</span>
              </div>
            }
          </div>
        }
      </section>
      }
    }
  </div>

  <div class="admin-settings-actions">
    <button type="submit" class="btn-admin">
      <i class="ti ti-device-floppy" aria-hidden="true"></i>@L["admin.settings.save"]
    </button>
  </div>
</form>

<script>
  // Keep each colour picker and its text box in step. The text box is the one that posts, so
  // choosing in the picker fills it in rather than the two drifting apart; typing a value moves
  // the picker when it is a colour the picker can represent, and is otherwise left alone so the
  // typed value survives.
  (function () {
    document.querySelectorAll('.admin-settings-colour-picker').forEach(function (picker) {
      var textId = picker.getAttribute('data-colour-for');
      var text = textId ? document.getElementById(textId) : null;
      if (!text) return;

      picker.addEventListener('input', function () {
        text.value = picker.value;
      });

      var syncText = function () {
        var v = (text.value || '').trim();
        if (/^#[0-9a-fA-F]{6}$/.test(v)) picker.value = v;
      };
      text.addEventListener('input', syncText);
      text.addEventListener('change', syncText);
    });
  })();

  // The two sign-in switches and the LDAP fields they govern.
  //
  // Independent state: turning one on must NOT turn the other off. Both may be on at once, which
  // is the whole point of having two switches instead of one choice.
  //
  // The LDAP fields are only meaningful while the LDAP switch is on, so they are hidden when it
  // is off — hidden with CSS rather than removed, so their values still post and turning the
  // switch off and back on does not lose the host name someone just typed.
  //
  // The only rule is that they may not BOTH be off: that would leave nobody able to sign in,
  // including whoever would have to fix it. When the second one is switched off, the other is
  // turned back on. The server enforces the same rule (see SettingsController), because a crafted
  // POST would not run this script.
  (function () {
    var grid = document.querySelector('.admin-settings-grid');
    if (!grid) return;
    var localId = '@SystemSettingKeys.AuthLocalEnabled';
    var ldapId = '@SystemSettingKeys.AuthLdapEnabled';
    var localBox = document.getElementById('setting_' + localId);
    var ldapBox = document.getElementById('setting_' + ldapId);
    if (!localBox || !ldapBox) return;

    var ldapFields = grid.querySelectorAll('[data-ldap-field]');

    function syncLdapFields() {
      var on = ldapBox.checked;
      ldapFields.forEach(function (f) {
        // Visual hiding only: the inputs keep their names and values so a save made while LDAP
        // is off does not blank the connection details.
        f.style.display = on ? '' : 'none';
        f.setAttribute('aria-hidden', on ? 'false' : 'true');
        // The group count in the heading is decorative and would be wrong once fields are hidden.
        f.querySelectorAll('input,select,textarea').forEach(function (el) {
          if (on) el.removeAttribute('tabindex');
          else el.setAttribute('tabindex', '-1');
        });
      });
    }

    /**
     * Reflect a programmatic change on the element so the switch chrome follows it.
     *
     * The visual switch is drawn by its own stylesheet off :checked, so setting .checked alone
     * re-renders correctly — but a disabled checkbox is styled as off AND is omitted from the
     * POST, so nothing here may leave one disabled.
     */
    function setChecked(box, value) {
      if (box.checked === value) return;
      box.checked = value;
      box.dispatchEvent(new Event('change', { bubbles: false }));
    }

    function ensureOneOn(changed) {
      if (localBox.checked || ldapBox.checked) return;
      // The user just turned the last one off. Put the OTHER one back on: the switch they clicked
      // stays where they put it (off), and the method they did not touch becomes the one that
      // keeps sign-in available. Doing it the other way round would look like the click was
      // ignored.
      var other = changed === localBox ? ldapBox : localBox;
      setChecked(other, true);
    }

    function onLocalChange() {
      ensureOneOn(localBox);
      syncLdapFields();
    }

    function onLdapChange() {
      ensureOneOn(ldapBox);
      syncLdapFields();
    }

    localBox.addEventListener('change', onLocalChange);
    ldapBox.addEventListener('change', onLdapChange);
    syncLdapFields();
  })();
</script>
