@model Morobot.Web.Areas.Admin.Models.AdminSettingsViewModel
@using Morobot.Domain
@{
  Layout = "_Layout";
  ViewData["Title"] = L["admin.settings.title"];
  var isFa = L.IsRtl;
  // Groups are ordered by their declared presentation order so the page reads
  // Auth → Updates → Deployment, and any future group without metadata lands last.
  var groups = Model.Settings
    .GroupBy(s => s.Group)
    .OrderBy(g => SystemSettingKeys.SettingGroupInfo.OrderOf(g.Key))
    .ToList();
}

<partial name="_AdminPageHead" model='new AdminPageHeadModel {
  Summary = L["admin.settings.intro"],
  ActionText = L["admin.settings.gotoPlans"],
  ActionUrl = Url.Action("Index", "Plans"),
  ActionIcon = "ti-layers-intersect"
}' />

<form method="post" class="admin-settings-form">
  @Html.AntiForgeryToken()

  @* Category rail: quick jump between groups, so a long settings page stays navigable. *@
  <nav class="admin-settings-toc" aria-label="@L["admin.settings.categories"]">
    @foreach (var group in groups)
    {
      var key = SystemSettingKeys.SettingGroupInfo.LocaleKeyOf(group.Key);
      <a href="#settings-group-@key" class="admin-settings-toc-item">
        <i class="ti @SystemSettingKeys.SettingGroupInfo.IconOf(group.Key)" aria-hidden="true"></i>
        <span>@L["admin.settings.groups." + key + ".title"]</span>
        <span class="admin-settings-toc-count">@group.Count()</span>
      </a>
    }
  </nav>

  <div class="admin-settings-grid">
    @foreach (var group in groups)
    {
      var gkey = SystemSettingKeys.SettingGroupInfo.LocaleKeyOf(group.Key);
      var gtitle = L["admin.settings.groups." + gkey + ".title"];
      var gdesc = L["admin.settings.groups." + gkey + ".desc"];
      <section class="admin-settings-card" id="settings-group-@gkey">
        <h3>
          <i class="ti @SystemSettingKeys.SettingGroupInfo.IconOf(group.Key)" aria-hidden="true"></i>
          <span>@gtitle</span>
          <span class="admin-settings-card-count">@group.Count()</span>
        </h3>
        @if (!string.IsNullOrWhiteSpace(gdesc) && !gdesc.StartsWith("admin.settings.groups."))
        {
          <p class="admin-settings-card-desc">@gdesc</p>
        }

        @foreach (var s in group)
        {
          var hint = isFa ? s.HintFa : s.HintEn;
          var label = isFa ? s.LabelFa : s.LabelEn;
          var readOnly = SystemSettingKeys.IsReadOnlyForAdmin(s.Key);
          var isSecret = SystemSettingKeys.IsSensitiveForAdmin(s.Key);
          var secretSet = isSecret && !string.IsNullOrWhiteSpace(s.Value);
          <div class="admin-settings-field">
            <label class="admin-label" for="setting_@s.Key">
              <span>@label</span>
              @if (readOnly)
              {
                <span class="admin-settings-ro-badge" title="@L["admin.settings.systemManagedHint"]">
                  <i class="ti ti-lock" aria-hidden="true"></i>@L["admin.settings.systemManaged"]
                </span>
              }
            </label>

            @if (s.Key == SystemSettingKeys.DefaultRegisterPlan)
            {
              <select class="form-select" id="setting_@s.Key" name="setting_@s.Key">
                @foreach (var plan in Model.Plans.Where(p => p.IsActive).OrderBy(p => p.SortOrder))
                {
                  var planLabel = isFa ? plan.NameFa : plan.NameEn;
                  <option value="@plan.Code" selected="@(string.Equals(s.Value, plan.Code, StringComparison.OrdinalIgnoreCase))">@planLabel (@plan.Code)</option>
                }
              </select>
            }
            else if (readOnly)
            {
              @* Printed, not put in a disabled box. An empty disabled input looks like a field
                 waiting to be filled, which is exactly the wrong signal for a value the system
                 owns and may not have set yet; a printed value (or a dash) reads as a fact.
                 No name attribute, so the POST omits it and the owning service keeps authority. *@
              var roText = string.IsNullOrWhiteSpace(s.Value) ? null : s.Value.Trim();
              <div class="admin-settings-ro-value" id="setting_@s.Key">
                @if (roText is null)
                {
                  <span class="admin-muted" title="@L["admin.settings.notSetYet"]">—</span>
                }
                else
                {
                  <code>@roText</code>
                }
              </div>
            }
            else if (isSecret)
            {
              @* Deliberately empty and never round-tripped: printing the stored secret into the
                 page would hand it to anyone who can open developer tools, so the field starts
                 blank with a placeholder saying what happens if it is left that way. Saving an
                 empty value keeps the stored secret (see SettingsController). *@
              <input class="form-control" type="password" id="setting_@s.Key" name="setting_@s.Key"
                     value="" autocomplete="new-password"
                     placeholder="@(secretSet ? L["admin.settings.secretKeep"] : L["admin.settings.secretEmpty"])" />
            }
            else
            {
              <input class="form-control" id="setting_@s.Key" name="setting_@s.Key" value="@s.Value" />
            }

            @if (!string.IsNullOrWhiteSpace(hint))
            {
              <div class="admin-field-hint">@hint</div>
            }

            @* Who last changed this value, and when. A seeded value nobody has touched says so,
               rather than showing a blank that reads like a missing figure. *@
            @if (s.LastChangedAtUtc is not null)
            {
              <div class="admin-settings-changed">
                <i class="ti ti-history" aria-hidden="true"></i>
                <span>
                  @L["admin.settings.lastChangedBy"]
                  <strong>@(string.IsNullOrWhiteSpace(s.LastChangedByUserName) ? L["admin.settings.unknownUser"] : s.LastChangedByUserName)</strong>
                  · @s.LastChangedAtUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </span>
              </div>
            }
            else
            {
              <div class="admin-settings-changed is-muted">
                <i class="ti ti-history" aria-hidden="true"></i>
                <span>@L["admin.settings.neverChanged"]</span>
              </div>
            }
          </div>
        }
      </section>
    }
  </div>

  <div class="admin-settings-actions">
    <button type="submit" class="btn-admin">
      <i class="ti ti-device-floppy" aria-hidden="true"></i>@L["admin.settings.save"]
    </button>
  </div>
</form>
