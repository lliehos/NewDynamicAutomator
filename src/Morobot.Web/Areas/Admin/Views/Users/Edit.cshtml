@model Morobot.Domain.Entities.AppUser
@using Morobot.Web.Areas.Admin.Models
@{
  Layout = "_Layout";
  ViewData["Title"] = L["admin.users.edit"];
  var plans = ViewBag.Plans as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}
<form method="post" class="admin-form-shell is-2col">
  @Html.AntiForgeryToken()
  <div class="admin-form-card">
    <p style="margin:0 0 .75rem"><strong>@Model.UserName</strong> (#@Model.Id)</p>
    <div class="mb-3">
      <label class="form-label">@L["admin.users.firstName"]</label>
      <input class="form-control" name="firstName" value="@Model.FirstName" />
    </div>
    <div class="mb-3">
      <label class="form-label">@L["admin.users.lastName"]</label>
      <input class="form-control" name="lastName" value="@Model.LastName" />
    </div>
    <div class="mb-3">
      <label class="form-label">@L["admin.users.email"]</label>
      <input class="form-control" name="email" type="email" value="@Model.Email" />
    </div>
    <div class="mb-3">
      <label class="form-label">@L["admin.users.nationalId"]</label>
      <input class="form-control" name="nationalId" value="@Model.NationalId" maxlength="20" />
    </div>
  </div>
  <div class="admin-form-card">
    <div class="mb-3">
      <label class="form-label">@L["admin.users.plan"]</label>
      <select name="planId" class="form-select">
        <option value="">—</option>
        @if (plans != null)
        {
          foreach (var p in plans)
          {
            if (Model.PlanId?.ToString() == p.Value)
            {
              <option value="@p.Value" selected>@p.Text</option>
            }
            else
            {
              <option value="@p.Value">@p.Text</option>
            }
          }
        }
      </select>
    </div>
    <div class="mb-3">
      <label class="form-label">@L["admin.users.role"]</label>
      <select name="role" class="form-select">
        @if (Model.Role == Morobot.Domain.Enums.UserRole.User)
        {
          <option value="User" selected>User</option>
          <option value="Admin">Admin</option>
        }
        else
        {
          <option value="User">User</option>
          <option value="Admin" selected>Admin</option>
        }
      </select>
    </div>
    <partial name="_AdminSwitch" model='new AdminSwitchModel { Name = "isActive", Label = L["admin.users.active"], Checked = Model.IsActive, Id = "isActive", Hint = L["admin.hints.userActive"] }' />
    <div class="mb-3" style="margin-top:1rem">
      <label class="form-label" for="newPassword">@L["admin.users.newPassword"]</label>
      <input class="form-control" type="password" id="newPassword" name="newPassword" autocomplete="new-password" />
      <div class="admin-field-hint">@L["admin.users.passwordHint"]</div>
    </div>
  </div>
  <div asp-validation-summary="All" class="text-danger small" style="grid-column:1/-1"></div>
  <div class="admin-form-actions" style="grid-column:1/-1">
    <button type="submit" class="btn-admin">@L["admin.common.save"]</button>
    <a class="btn-admin secondary" asp-action="Index">@L["admin.common.back"]</a>
  </div>
</form>
