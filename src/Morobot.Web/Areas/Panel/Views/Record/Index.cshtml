@{
    ViewData["Title"] = L["record.title"];
}
<div class="card mb-5">
  <div class="card-body text-center py-5">
    <h3 class="mb-3" data-i18n="record.heading">@L["record.heading"]</h3>
    <p class="text-muted mb-2" id="da-record-gate-msg" data-i18n="record.gateMsg">@L["record.gateMsg"]</p>
    <p class="mb-1" data-i18n="record.hint">@L["record.hint"]</p>
    <p class="mb-1 text-warning small" data-i18n="plan.upgradeRecord">@L["plan.upgradeRecord"]</p>
    <a class="btn btn-label-secondary mt-3" asp-area="Panel" asp-controller="Home" asp-action="Processes" data-i18n="panel.navProcesses">@L["panel.navProcesses"]</a>
    <p class="mt-3 text-muted" id="da-portal-status"></p>
  </div>
</div>

<button type="button" id="da-page-rec-fab" class="da-page-rec-fab" hidden data-i18n-title="record.fabTitle" title="@L["record.fabTitle"]">REC</button>
<div id="da-page-rec-panel" class="da-page-rec-panel" hidden>
  <div id="da-page-rec-status" class="small text-muted mb-2">...</div>
  <div id="da-page-idle">
    <p class="small text-muted mb-0" data-i18n="record.idleHint">@L["record.idleHint"]</p>
  </div>
  <div id="da-page-recording" hidden>
    <button type="button" class="btn btn-sm btn-warning w-100 mb-1" data-da-action="finish-record" data-i18n="record.stop">@L["record.stop"]</button>
    <button type="button" class="btn btn-sm btn-outline-secondary w-100" data-da-action="clear-draft" data-i18n="record.endSession">@L["record.endSession"]</button>
  </div>
  <div id="da-page-review" hidden>
    <p class="small text-muted" data-i18n="record.reviewHint">@L["record.reviewHint"]</p>
    <button type="button" class="btn btn-sm btn-success w-100 mb-1" data-da-action="save-draft" data-i18n="record.saveAll">@L["record.saveAll"]</button>
    <button type="button" class="btn btn-sm btn-danger w-100 mb-1" data-da-action="resume-record" data-i18n="record.resume">@L["record.resume"]</button>
    <button type="button" class="btn btn-sm btn-outline-secondary w-100" data-da-action="clear-draft" data-i18n="record.endSession">@L["record.endSession"]</button>
  </div>
</div>

<style>
  .da-page-rec-fab {
    position: fixed !important;
    left: 18px !important;
    right: auto !important;
    bottom: 18px !important;
    z-index: 1080 !important;
    width: 64px; height: 64px; border-radius: 50%; border: 0;
    background: #ea5455; color: #fff; font-weight: 800; font-size: 14px;
    box-shadow: 0 8px 24px rgba(234,84,85,.45);
    cursor: pointer;
  }
  .da-page-rec-panel {
    position: fixed; left: 18px; bottom: 92px; z-index: 1080;
    width: min(280px, calc(100vw - 36px)); background: #fff; border-radius: 12px;
    box-shadow: 0 12px 32px rgba(0,0,0,.18); padding: 12px;
  }
</style>
