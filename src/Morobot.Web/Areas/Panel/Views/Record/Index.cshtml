@{
    ViewData["Title"] = "ضبط فرآیند";
}
<div class="card mb-5">
  <div class="card-body text-center py-5">
    <h3 class="mb-3">صفحهٔ ضبط</h3>
    <p class="text-muted mb-2" id="da-record-gate-msg">اگر افزونه نصب باشد، از لیست فرآیندها ضبط را شروع کنید.</p>
    <p class="mb-1">ضبط همیشه روی یک فرآیند مشخص از لیست شروع می‌شود. کنترل توقف، سویچ‌ها و ذخیره روی تب هدف (مشابه پنل اجرا) است.</p>
    <a class="btn btn-label-secondary mt-3" asp-area="Panel" asp-controller="Home" asp-action="Processes">فرآیندها</a>
    <p class="mt-3 text-muted" id="da-portal-status"></p>
  </div>
</div>

<button type="button" id="da-page-rec-fab" class="da-page-rec-fab" hidden title="ضبط">REC</button>
<div id="da-page-rec-panel" class="da-page-rec-panel" hidden>
  <div id="da-page-rec-status" class="small text-muted mb-2">...</div>
  <div id="da-page-idle">
    <p class="small text-muted mb-0">از لیست فرآیندها دکمهٔ ضبط را بزنید.</p>
  </div>
  <div id="da-page-recording" hidden>
    <button type="button" class="btn btn-sm btn-warning w-100 mb-1" data-da-action="finish-record">توقف</button>
    <button type="button" class="btn btn-sm btn-outline-secondary w-100" data-da-action="clear-draft">پایان جلسه</button>
  </div>
  <div id="da-page-review" hidden>
    <p class="small text-muted">انتخاب موارد و ذخیره را از پنل تب هدف انجام دهید.</p>
    <button type="button" class="btn btn-sm btn-success w-100 mb-1" data-da-action="save-draft">ذخیره همه و ادامه</button>
    <button type="button" class="btn btn-sm btn-danger w-100 mb-1" data-da-action="resume-record">ادامه بدون ذخیره</button>
    <button type="button" class="btn btn-sm btn-outline-secondary w-100" data-da-action="clear-draft">پایان جلسه</button>
  </div>
</div>

<style>
  .da-page-rec-fab {
    position: fixed !important;
    left: 18px !important;
    right: auto !important;
    bottom: 18px !important;
    z-index: 1080 !important;
    width: 64px; height: 64px; border-radius: 50%; border: 0;
    background: #ea5455; color: #fff; font-weight: 800; font-size: 14px;
    box-shadow: 0 8px 24px rgba(234,84,85,.45); cursor: pointer;
  }
  .da-page-rec-fab.on { animation: daPulse 1.1s ease-in-out infinite; }
  @@keyframes daPulse {
    0%,100% { box-shadow: 0 0 0 0 rgba(234,84,85,.5); }
    50% { box-shadow: 0 0 0 14px rgba(234,84,85,0); }
  }
  .da-page-rec-panel {
    position: fixed !important; left: 18px !important; right: auto !important; bottom: 92px !important;
    z-index: 1080 !important; width: 260px; background: #fff; border-radius: 12px;
    padding: 12px; box-shadow: 0 12px 32px rgba(0,0,0,.18); direction: rtl;
  }
</style>
