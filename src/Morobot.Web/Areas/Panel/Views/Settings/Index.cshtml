@{
  Layout = "_Layout";
  ViewData["Title"] = L["settings.title"];
  var culture = L.Culture;
  var userName = (string)(ViewBag.UserName ?? User.Identity?.Name ?? "");
  var incomplete = ViewBag.Incomplete == true;
  var errKey = TempData["ProfileError"] as string;
  var okKey = TempData["ProfileOk"] as string;
}
<div class="da-home da-settings">
  <header class="da-home-head">
    <div>
      <div class="da-home-brand" data-i18n="brand.name">@L["brand.name"]</div>
      <h4 class="da-home-title mb-0" data-i18n="settings.title">@L["settings.title"]</h4>
      <p class="da-home-sub mb-0" data-i18n="settings.subtitle">@L["settings.subtitle"]</p>
    </div>
  </header>

  @if (incomplete)
  {
    <div class="alert alert-warning">برای ادامه کار با پنل، نام، نام خانوادگی، ایمیل و موبایل را تکمیل کنید.</div>
  }
  @if (!string.IsNullOrEmpty(errKey))
  {
    <div class="alert alert-danger">@L[errKey]</div>
  }
  @if (!string.IsNullOrEmpty(okKey))
  {
    <div class="alert alert-success">@L[okKey]</div>
  }

  <div class="row g-4">
    <div class="col-12 col-lg-7">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0" data-i18n="settings.profile">@L["settings.profile"]</h5>
        </div>
        <div class="card-body">
          @{
            var avatarPath = (ViewBag.AvatarPath as string) ?? "";
          }
          <form method="post" asp-area="Panel" asp-controller="Settings" asp-action="SaveAvatar"
                enctype="multipart/form-data" class="mb-4">
            @Html.AntiForgeryToken()
            <label class="form-label" data-i18n="settings.avatar">@L["settings.avatar"]</label>
            <div class="da-avatar-editor">
              @{
                ViewData["Path"] = avatarPath;
                ViewData["Name"] = userName;
                ViewData["Size"] = 72;
              }
              <partial name="_Avatar" />
              <div class="da-avatar-editor-actions">
                <input type="file" id="da-avatar-file" name="avatar" accept="image/png,image/jpeg,image/webp"
                       class="d-none" data-crop-title="@L["settings.avatar"]" />
                <label class="btn btn-sm btn-primary" for="da-avatar-file">
                  <i class="ti ti-upload me-1"></i><span data-i18n="settings.avatarChoose">@L["settings.avatarChoose"]</span>
                </label>
                <button type="submit" class="btn btn-sm btn-label-primary" id="da-avatar-save" hidden>
                  <i class="ti ti-device-floppy me-1"></i><span data-i18n="settings.avatarSave">@L["settings.avatarSave"]</span>
                </button>
                <p class="da-avatar-hint" data-i18n="settings.avatarHint">@L["settings.avatarHint"]</p>
              </div>
            </div>
          </form>
          @if (!string.IsNullOrWhiteSpace(avatarPath))
          {
            <form method="post" asp-area="Panel" asp-controller="Settings" asp-action="RemoveAvatar"
                  class="mb-4">
              @Html.AntiForgeryToken()
              <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="ti ti-trash me-1"></i><span data-i18n="settings.avatarRemove">@L["settings.avatarRemove"]</span>
              </button>
            </form>
          }
          <hr class="my-4" />
          <form method="post" asp-area="Panel" asp-controller="Settings" asp-action="SaveProfile" autocomplete="on">
            @Html.AntiForgeryToken()
            <div class="mb-3">
              <label class="form-label" for="da-prof-user" data-i18n="settings.userName">@L["settings.userName"]</label>
              <input class="form-control" id="da-prof-user" type="text" value="@userName" readonly />
            </div>
            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label" for="firstName" data-i18n="settings.firstName">@L["settings.firstName"] *</label>
                <input class="form-control" id="firstName" name="firstName" type="text" required value="@ViewBag.FirstName" />
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label" for="lastName" data-i18n="settings.lastName">@L["settings.lastName"] *</label>
                <input class="form-control" id="lastName" name="lastName" type="text" required value="@ViewBag.LastName" />
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label" for="email" data-i18n="settings.email">@L["settings.email"] *</label>
              <input class="form-control" id="email" name="email" type="email" required value="@ViewBag.Email" />
            </div>
            <div class="mb-3">
              <label class="form-label" for="mobile" data-i18n="settings.mobile">@L["settings.mobile"] *</label>
              <input class="form-control" id="mobile" name="mobile" type="tel" required value="@ViewBag.Mobile" />
            </div>
            <button type="submit" class="btn btn-primary" data-i18n="settings.saveProfile">@L["settings.saveProfile"]</button>
          </form>
          <hr class="my-4" />
          <a class="btn btn-label-primary" asp-area="Panel" asp-controller="Account" asp-action="Upgrade" data-i18n="plan.upgradeTitle">@L["plan.upgradeTitle"]</a>
        </div>
      </div>
    </div>
    <div class="col-12 col-lg-5">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0" data-i18n="settings.language">@L["settings.language"]</h5>
        </div>
        <div class="card-body">
          <p class="text-muted small" data-i18n="settings.languageHint">@L["settings.languageHint"]</p>
          <form method="post" asp-area="Panel" asp-controller="Settings" asp-action="SetLanguage">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="/Panel/Settings" />
            <div class="d-grid gap-2">
              <button type="submit" name="lang" value="fa" class="btn @(culture == "fa" ? "btn-primary" : "btn-label-secondary")">
                @L["settings.langFa"]
              </button>
              <button type="submit" name="lang" value="en" class="btn @(culture == "en" ? "btn-primary" : "btn-label-secondary")">
                @L["settings.langEn"]
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
(function () {
  var input = document.getElementById('da-avatar-file');
  if (!input) return;
  var saveBtn = document.getElementById('da-avatar-save');

  function reveal() {
    if (saveBtn) saveBtn.hidden = false;
  }

  input.addEventListener('change', function () {
    var file = input.files && input.files[0];
    if (!file) return;
    // SVG would be rasterised by the cropper; avatars are always raster anyway,
    // so route every accepted type through it with a square, 512px output.
    if (!window.DaCropper) { reveal(); return; }
    DaCropper.open({
      file: file,
      aspect: 1,
      maxWidth: 512,
      maxHeight: 512,
      title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["settings.avatar"].ToString())),
      strings: {
        zoom: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["crop.zoom"].ToString())),
        rotate: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["crop.rotate"].ToString())),
        reset: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["crop.reset"].ToString())),
        cancel: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["common.cancel"].ToString())),
        apply: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["crop.apply"].ToString())),
        free: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["crop.free"].ToString()))
      },
      onApply: function (blob, meta) {
        if (meta && meta.passthrough) { reveal(); return; }
        try {
          var dt = new DataTransfer();
          dt.items.add(new File([blob], meta.name, { type: meta.type || 'image/png' }));
          input.files = dt.files;
        } catch (e) { /* keep the original file */ }
        // Show the crop immediately so the user sees what will be saved.
        var img = document.querySelector('.da-avatar-editor .da-avatar');
        if (img) {
          var url = URL.createObjectURL(blob);
          img.className = 'da-avatar';
          img.innerHTML = '';
          var el = document.createElement('img');
          el.src = url;
          el.alt = '';
          img.appendChild(el);
        }
        reveal();
      }
    });
  });
})();
</script>
}
