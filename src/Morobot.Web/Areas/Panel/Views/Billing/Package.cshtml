@using Morobot.Domain.Entities
@using Morobot.Domain.Enums
@{
    ViewData["Title"] = "خرید بستهٔ نرم‌افزار";
    var options = ViewBag.Options as List<SoftwarePackageOption> ?? new List<SoftwarePackageOption>();
    var error = TempData["BillingError"] as string;
}

<div class="da-home">
  <header class="da-home-head">
    <div>
      <h4 class="da-home-title mb-1">خرید بستهٔ نرم‌افزار</h4>
      <p class="da-home-sub mb-0">
        مشخصات لایسنس خود را انتخاب کنید؛ مبلغ به‌صورت زنده محاسبه می‌شود و سپس به درگاه می‌روید.
      </p>
    </div>
  </header>

  @if (!string.IsNullOrWhiteSpace(error))
  {
    <div class="alert alert-warning">@error</div>
  }

  <form method="post" asp-action="BuyPackage" id="pkg-form">
    @Html.AntiForgeryToken()

    <div class="card mb-3">
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">نام سازمان (اختیاری)</label>
            <input name="organization" class="form-control" />
          </div>
        </div>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-body">
        <div class="fw-semibold mb-3">فیچرها و محدودیت‌ها</div>

        @foreach (var o in options)
        {
          <div class="billing-opt row align-items-center g-2 py-2 border-bottom">
            <div class="col-md-6">
              <div class="form-check">
                @if (o.Kind == PackageOptionKind.Feature)
                {
                  <input class="form-check-input pkg-feature" type="checkbox" name="units[@o.Key]" value="1"
                         id="opt-@o.Key" @(o.IsDefault ? "checked" : null) />
                  <label class="form-check-label" for="opt-@o.Key">
                    <span class="fw-semibold">@o.Title</span>
                    @if (o.Amount > 0)
                    {
                      <span class="text-muted small">— @o.Amount.ToString("N0")</span>
                    }
                  </label>
                }
                else
                {
                  <label class="form-check-label">
                    <span class="fw-semibold">@o.Title</span>
                    @if (o.UnitAmount > 0)
                    {
                      <span class="text-muted small">— @o.UnitAmount.ToString("N0") به‌ازای هر @(o.UnitLabel ?? "واحد")</span>
                    }
                  </label>
                }
                @if (!string.IsNullOrWhiteSpace(o.Description))
                {
                  <div class="text-muted small">@o.Description</div>
                }
              </div>
            </div>
            <div class="col-md-6">
              @if (o.Kind == PackageOptionKind.Limit)
              {
                <div class="d-flex align-items-center gap-2">
                  <input class="form-control pkg-limit" type="number" min="0" style="max-width:120px"
                         name="units[@o.Key]" value="@(o.IsDefault ? Math.Max(1, o.IncludedUnits) : o.IncludedUnits)"
                         data-key="@o.Key" data-included="@o.IncludedUnits" data-unit="@o.UnitAmount" />
                  <span class="text-muted small">
                    @(o.UnitLabel ?? "واحد")
                    @if (o.MaxUnits is int cap)
                    {
                      <span>· حداکثر @cap</span>
                    }
                  </span>
                </div>
              }
            </div>
          </div>
        }
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div class="fw-semibold">مبلغ قابل پرداخت</div>
          <div class="billing-total" id="pkg-total">—</div>
        </div>
        <div id="pkg-lines" class="small text-muted mt-2"></div>
        <div id="pkg-error" class="small text-danger mt-2"></div>
      </div>
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-100">ادامه و پرداخت</button>
  </form>
</div>

@section Scripts {
<script>
(function () {
  // The price is computed by the SERVER, never in the browser: the total shown here is the total the
  // order will be created with, so the two cannot disagree after a price-list edit or a rounding
  // difference. The client only formats what came back.
  var form = document.getElementById("pkg-form");
  var totalEl = document.getElementById("pkg-total");
  var linesEl = document.getElementById("pkg-lines");
  var errEl = document.getElementById("pkg-error");
  var token = form.querySelector('input[name="__RequestVerificationToken"]').value;
  var timer = null;

  function collect() {
    var body = new FormData();
    body.append("__RequestVerificationToken", token);
    form.querySelectorAll(".pkg-feature").forEach(function (cb) {
      if (cb.checked) body.append("units[" + cb.name.slice(6, -1) + "]", "1");
    });
    form.querySelectorAll(".pkg-limit").forEach(function (inp) {
      body.append("units[" + inp.dataset.key + "]", inp.value || "0");
    });
    return body;
  }

  function refresh() {
    fetch("@Url.Action("QuotePackage", "Billing", new { area = "Panel" })", {
      method: "POST", credentials: "same-origin", body: collect()
    }).then(function (r) { return r.json(); }).then(function (data) {
      if (data.error) { errEl.textContent = "محاسبهٔ قیمت ممکن نشد."; return; }
      errEl.textContent = "";
      totalEl.textContent = Number(data.total).toLocaleString("fa-IR") + " " + (data.currency || "");
      linesEl.innerHTML = (data.lines || []).map(function (l) {
        var detail = l.detail ? ' <span class="ms-1">(' + l.detail + ")</span>" : "";
        return "<div>" + l.title + detail + " — " + Number(l.amount).toLocaleString("fa-IR") + "</div>";
      }).join("");
    }).catch(function () { errEl.textContent = "محاسبهٔ قیمت ممکن نشد."; });
  }

  function schedule() { clearTimeout(timer); timer = setTimeout(refresh, 250); }

  form.addEventListener("change", schedule);
  form.addEventListener("input", schedule);
  refresh();
})();
</script>
}
