@{
    ViewData["Title"] = L["billing.result.title"];
    var failed = ViewBag.Failed is true;
    var warning = ViewBag.Warning as string;
    var error = ViewBag.Error as string;
    var orderId = ViewBag.OrderId;
}

<div class="da-home">
  <div class="card">
    <div class="card-body text-center py-6">
      @if (failed)
      {
        <div class="display-6 mb-3">✖</div>
        <h4 class="mb-2">@L["billing.result.failedTitle"]</h4>
        <p class="text-muted mb-4">@(error ?? L["billing.result.failedDefault"])</p>
        <a class="btn btn-primary" asp-area="Panel" asp-controller="Billing" asp-action="Plans">@L["billing.result.backToPlans"]</a>
      }
      else
      {
        <div class="display-6 mb-3">✔</div>
        <h4 class="mb-2">@L["billing.result.okTitle"]</h4>
        <p class="text-muted mb-2">
          @L.T("billing.result.okBody", ("n", orderId?.ToString() ?? "—"))
        </p>
        @if (!string.IsNullOrWhiteSpace(warning))
        {
          @* A paid order whose activation was incomplete is reported separately: the money went
             through, so the customer must not be told it failed — they need help, not a retry. *@
          <div class="alert alert-warning small text-start">@warning</div>
        }
        <div class="d-flex gap-2 justify-content-center mt-3">
          <a class="btn btn-primary" asp-area="Panel" asp-controller="Billing" asp-action="History">@L["billing.history.heading"]</a>
          @if (orderId is not null)
          {
            <a class="btn btn-label-secondary"
               asp-area="Panel" asp-controller="Billing" asp-action="DownloadLicense" asp-route-orderId="@orderId">
              @L["billing.result.downloadLicense"]
            </a>
          }
        </div>
      }
    </div>
  </div>
</div>
