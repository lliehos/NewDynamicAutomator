@{
    ViewData["Title"] = "نصب افزونه‌ها";
    var globalPath = ViewBag.GlobalPath as string ?? ViewBag.RecorderPath as string ?? ViewBag.ExtensionPath as string ?? "";
    var appKey = ViewBag.AppInstanceKey as string ?? "default";
    var smartPath = ViewBag.SmartPath as string ?? "";
    var globalVer = ViewBag.GlobalVersion as string ?? ViewBag.RecorderVersion as string ?? ViewBag.Version as string ?? "";
    var smartVer = ViewBag.SmartVersion as string ?? "";
    var brandHead = ViewData["BrandHead"] as BrandHeadModel ?? new BrandHeadModel();
    var globalExtName = $"{brandHead.AppName} Global";
    var smartExtName = $"{brandHead.AppName} Smart Recorder";
}
<div class="card mb-4">
  <div class="card-body">
    <h4 class="mb-3">افزونه‌های @brandHead.AppName</h4>
    <div class="alert alert-warning mb-3 small">
      <strong>کلید استقرار (AppInstanceKey):</strong> <code>@appKey</code><br />
      مسیر افزونه‌ها: <code>%LOCALAPPDATA%\morobot.soras.ir\@appKey\</code> — برای هر دامنه/Cloud/Enterprise جدا تنظیم کنید.
    </div>
    <div class="alert alert-info mb-3">
      <strong>@globalExtName</strong> شامل ضبط، اجرا و سلکتور است — فقط <strong>یک بار</strong> Load unpacked کنید.
      <strong>@smartExtName</strong> جداگانه و اختیاری است.
    </div>

    <div class="row g-3">
      <div class="col-md-6">
        <div class="border rounded p-3 h-100" style="border-top: 3px solid #0d9488 !important;">
          <h5 class="mb-2">① @globalExtName</h5>
          <p class="small text-muted">ضبط فرآیند، اجرا (Play) و کپی سلکتور — یک افزونه با آیکون برند.</p>
          <div class="fw-semibold mb-1">مسیر</div>
          <code id="da-ext-path-global" class="user-select-all d-block small mb-2">@globalPath</code>
          @if (!string.IsNullOrEmpty(globalVer))
          {
            <div class="small text-muted mb-2">نسخه: <code>@globalVer</code></div>
          }
          <button type="button" class="btn btn-sm btn-primary" data-copy="#da-ext-path-global">کپی مسیر</button>
        </div>
      </div>
      <div class="col-md-6">
        <div class="border rounded p-3 h-100" style="border-top: 3px solid #7367f0 !important;">
          <h5 class="mb-2">② @smartExtName</h5>
          <p class="small text-muted">هوشمندسازی فرآیند — جدا از Global.</p>
          <div class="fw-semibold mb-1">مسیر</div>
          <code id="da-ext-path-smart" class="user-select-all d-block small mb-2">@smartPath</code>
          @if (!string.IsNullOrEmpty(smartVer))
          {
            <div class="small text-muted mb-2">نسخه: <code>@smartVer</code></div>
          }
          <button type="button" class="btn btn-sm btn-secondary" data-copy="#da-ext-path-smart">کپی مسیر</button>
        </div>
      </div>
    </div>

    <ol class="mb-4 mt-4">
      <li class="mb-2"><code>chrome://extensions</code> یا <code>edge://extensions</code></li>
      <li class="mb-2"><strong>Developer mode</strong> را روشن کنید.</li>
      <li class="mb-2"><strong>Load unpacked</strong> → مسیر @globalExtName (و در صورت نیاز @smartExtName).</li>
      <li class="mb-2">افزونه‌های قدیمی Recorder/Player/Selector را حذف کنید.</li>
      <li class="mb-2">پرتال را رفرش کنید.</li>
    </ol>

    <div class="d-flex gap-2 flex-wrap">
      <button type="button" class="btn btn-outline-primary" id="da-sync-now">همگام‌سازی</button>
      <a class="btn btn-label-secondary" asp-area="Panel" asp-controller="Home" asp-action="Index">بازگشت</a>
    </div>
    <p class="mt-3 mb-0" id="da-sync-status"></p>
  </div>
</div>

@section Scripts {
<script>
(function () {
  document.querySelectorAll("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const sel = btn.getAttribute("data-copy");
      const el = sel ? document.querySelector(sel) : null;
      const text = el?.textContent?.trim() || "";
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = "کپی شد";
        setTimeout(() => { btn.textContent = "کپی مسیر"; }, 1200);
      } catch { /* ignore */ }
    });
  });
  document.getElementById("da-sync-now")?.addEventListener("click", async () => {
    const status = document.getElementById("da-sync-status");
    if (status) status.textContent = "در حال همگام‌سازی…";
    try {
      const res = await fetch("/extension/sync", { method: "POST" });
      const data = await res.json();
      if (status) {
        status.textContent = data?.ok
          ? "همگام شد — در صورت نیاز مسیرها را دوباره کپی کنید."
          : (data?.error || "خطا در همگام‌سازی");
      }
      const globalPath = data?.global?.path || data?.recorder?.path || data?.path;
      if (globalPath) {
        const g = document.getElementById("da-ext-path-global");
        if (g) g.textContent = globalPath;
      }
      if (data?.smart?.path) {
        const sm = document.getElementById("da-ext-path-smart");
        if (sm) sm.textContent = data.smart.path;
      }
    } catch (e) {
      if (status) status.textContent = e.message || "خطا";
    }
  });
})();
</script>
}
