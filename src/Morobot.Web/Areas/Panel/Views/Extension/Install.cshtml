@{
    ViewData["Title"] = "نصب افزونه‌ها";
    var appKey = ViewBag.AppInstanceKey as string ?? "default";
    var globalVer = ViewBag.GlobalVersion as string ?? ViewBag.RecorderVersion as string ?? ViewBag.Version as string ?? "";
    var smartVer = ViewBag.SmartVersion as string ?? "";
    var brandHead = ViewData["BrandHead"] as BrandHeadModel ?? new BrandHeadModel();
    var globalExtName = $"{brandHead.AppName} Global";
    var smartExtName = $"{brandHead.AppName} Smart Recorder";
    /*
     * The install path of the SERVER is deliberately not shown anywhere here.
     *
     * The extension folder is written under %LOCALAPPDATA% on the machine that runs the web app — the
     * server — while the extension must be loaded into the browser on THIS machine. The two are
     * different computers, so the server's path does not exist for the user and showing it only sent
     * people looking for a folder that was never there. There is no way for the server to learn the
     * user's own path either, so the page hands out the package and lets the user choose where to put
     * it. `%LOCALAPPDATA%` is still given as the conventional location, with a helper that resolves
     * it on the user's own machine.
     */    /*
     * A PowerShell one-liner that creates and opens the conventional folder on the USER's machine.
     * Built here as a plain string rather than inline in the markup: the command contains backslashes
     * and `$` tokens, and putting it directly in a Razor expression makes C# treat them as escape
     * sequences. `$env:LOCALAPPDATA` is intentionally left for PowerShell to expand, so the user's own
     * profile path is used instead of a guessed one.
     */
    var suggestedPathCommand = string.Join("; ", new[]
    {
        "$p = Join-Path $env:LOCALAPPDATA 'morobot.soras.ir'",
        "$p = Join-Path $p '" + appKey + "'",
        "New-Item -ItemType Directory -Force -Path $p | Out-Null",
        "explorer $p"
    });}
<div class="card mb-4">
  <div class="card-body">
    <h4 class="mb-3">افزونه‌های @brandHead.AppName</h4>

    <div class="alert alert-info mb-3">
      <strong>@globalExtName</strong> شامل ضبط، اجرا و سلکتور است — فقط <strong>یک بار</strong> نصب می‌شود.
      <strong>@smartExtName</strong> جداگانه و اختیاری است.
    </div>

    <div class="alert alert-warning mb-3 small">
      <strong>این افزونه‌ها روی کامپیوتر خودتان نصب می‌شوند، نه روی سرور.</strong>
      پس مسیر سرور اینجا نمایش داده نمی‌شود — آن پوشه روی کامپیوتر شما وجود ندارد.
      بستهٔ زیر را دانلود و در یک پوشهٔ <strong>ثابت</strong> باز کنید (پوشه را بعداً جابجا یا پاک نکنید،
      وگرنه کروم افزونه را از دست می‌دهد).
    </div>

    <div class="row g-3">
      <div class="col-md-6">
        <div class="border rounded p-3 h-100" style="border-top: 3px solid #0d9488 !important;">
          <h5 class="mb-2">① @globalExtName</h5>
          <p class="small text-muted">ضبط فرآیند، اجرا (Play) و کپی سلکتور — یک افزونه با آیکون برند.</p>
          @if (!string.IsNullOrEmpty(globalVer))
          {
            <div class="small text-muted mb-2">نسخه: <code>@globalVer</code></div>
          }
          <a class="btn btn-sm btn-primary w-100" href="/extension/download/global" download>⬇ دانلود بستهٔ Global (zip)</a>
        </div>
      </div>
      <div class="col-md-6">
        <div class="border rounded p-3 h-100" style="border-top: 3px solid #7367f0 !important;">
          <h5 class="mb-2">② @smartExtName</h5>
          <p class="small text-muted">هوشمندسازی فرآیند — جدا از Global.</p>
          @if (!string.IsNullOrEmpty(smartVer))
          {
            <div class="small text-muted mb-2">نسخه: <code>@smartVer</code></div>
          }
          <a class="btn btn-sm btn-secondary w-100" href="/extension/download/smart" download>⬇ دانلود بستهٔ Smart Recorder (zip)</a>
        </div>
      </div>
    </div>

    <h5 class="mt-4 mb-2">مراحل نصب</h5>
    <ol class="mb-3">
      <li class="mb-2">بستهٔ بالا را دانلود و در یک پوشهٔ ثابت <strong>استخراج (Extract)</strong> کنید — مثلاً
        <code>C:\@brandHead.AppName-ext\global</code>. پوشه را بعداً جابجا نکنید.</li>
      <li class="mb-2"><code>chrome://extensions</code> یا <code>edge://extensions</code> را باز کنید.</li>
      <li class="mb-2"><strong>Developer mode</strong> را روشن کنید.</li>
      <li class="mb-2"><strong>Load unpacked</strong> → همان پوشه‌ای که استخراج کردید را انتخاب کنید.</li>
      <li class="mb-2">اگر افزونه‌های قدیمی Recorder/Player/Selector را دارید، حذفشان کنید.</li>
      <li class="mb-2">این پرتال را رفرش کنید.</li>
    </ol>

    <div class="border rounded p-3 mb-3">
      <div class="fw-semibold mb-1">مسیر پیشنهادی روی کامپیوتر شما</div>
      <p class="small text-muted mb-2">
        برای اینکه اسم کاربری ویندوزتان را حدس نزنیم، این دستور را در
        <strong>PowerShell</strong> اجرا کنید تا مسیر دقیق باز شود:
      </p>
      <code id="da-ext-suggested-path" class="user-select-all d-block small mb-2">@suggestedPathCommand</code>
      <button type="button" class="btn btn-sm btn-outline-primary" data-copy="#da-ext-suggested-path">کپی دستور</button>
    </div>

    <div class="d-flex gap-2 flex-wrap">
      <button type="button" class="btn btn-outline-primary" id="da-sync-now">همگام‌سازی سرور</button>
      <a class="btn btn-label-secondary" asp-area="Panel" asp-controller="Home" asp-action="Index">بازگشت</a>
    </div>
    <p class="mt-3 mb-0" id="da-sync-status"></p>
  </div>
</div>

@section Scripts {
<script>
(function () {
  document.querySelectorAll("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const sel = btn.getAttribute("data-copy");
      const el = sel ? document.querySelector(sel) : null;
      const text = el?.textContent?.trim() || "";
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const prev = btn.textContent;
        btn.textContent = "کپی شد";
        setTimeout(() => { btn.textContent = prev; }, 1200);
      } catch { /* ignore */ }
    });
  });

  document.getElementById("da-sync-now")?.addEventListener("click", async () => {
    const status = document.getElementById("da-sync-status");
    if (status) status.textContent = "در حال همگام‌سازی…";
    try {
      const res = await fetch("/extension/sync", { method: "POST" });
      const data = await res.json();
      // Only the versions are reported back. The server's own folder path is intentionally not
      // echoed into the page, because it belongs to the server and not to the browser.
      if (status) {
        const g = data?.global?.version || data?.version || "";
        const s = data?.smart?.version || "";
        status.textContent = data?.ok
          ? `همگام شد — Global ${g}${s ? ` · Smart ${s}` : ""}. بسته‌ها آمادهٔ دانلود هستند.`
          : (data?.error || "خطا در همگام‌سازی");
      }
    } catch (e) {
      if (status) status.textContent = e.message || "خطا";
    }
  });
})();
</script>
}
