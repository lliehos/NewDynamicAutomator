@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["login.title"];
    var nextLang = L.IsRtl ? "en" : "fa";
    var langLabel = L.IsRtl ? L["common.switchToEn"] : L["common.switchToFa"];
    var errKey = ViewBag.Error as string;
    var brandHead = ViewData["BrandHead"] as BrandHeadModel ?? new BrandHeadModel();
    // Which methods the administrator has enabled. The chooser below is only rendered when both
    // are on; with a single method there is nothing to pick, and showing one tab would read as a
    // choice the visitor does not actually have.
    var providers = ViewBag.AuthProviders as Morobot.Infrastructure.Identity.AuthModeResolver.AuthProviders
                    ?? new Morobot.Infrastructure.Identity.AuthModeResolver.AuthProviders(Local: true, Ldap: false);
    var showChooser = providers.Both;
    var initialMethod = providers.LdapOnly ? "ldap" : "local";
    // The two methods want different browser hints: a directory password is not this site's, so
    // offering to save or autofill it here would be wrong.
    var autocomplete = providers.LdapOnly ? "off" : "current-password";
}

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-end mb-2">
      @if (L.Bilingual)
      {
        <button type="button" class="btn btn-sm btn-label-primary rounded-pill px-3" data-lang-switch data-lang-next="@nextLang">@langLabel</button>
      }
    </div>
    <div class="app-brand justify-content-center mb-6 morobot-login-brand">
      @{ ViewData["BrandImgClass"] = "morobot-login-logo"; ViewData["BrandImgWidth"] = 120; ViewData["BrandImgHeight"] = 120; }
      <partial name="_BrandMark" model="brandHead" />
      <div class="morobot-login-titles">
        <span class="app-brand-text demo text-heading fw-bold">@brandHead.AppName</span>
      </div>
    </div>
    <h4 class="mb-1" data-i18n="login.heading">@L["login.heading"]</h4>
    <p class="mb-3" data-i18n="login.hint">@L["login.hint"]</p>
    @if (!string.IsNullOrEmpty(errKey))
    {
      <div class="alert alert-danger small" data-i18n="@errKey">@L[errKey]</div>
    }
    @if (showChooser)
    {
      @* Both methods are live, so the visitor does pick — and the choice matters, because a
         national code and a directory account are typed differently. The tabs are real buttons
         that drive the form below (see the script at the end of the page). *@
      <div class="morobot-login-mode mb-4" data-auth-chooser data-initial="@initialMethod">
        <ul class="nav nav-pills nav-justified morobot-login-mode-tabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button type="button" class="nav-link @(initialMethod == "local" ? "active" : null)" role="tab"
                    data-auth-method="local" aria-selected="@(initialMethod == "local" ? "true" : "false")"
                    data-i18n="login.tabLocal">@L["login.tabLocal"]</button>
          </li>
          <li class="nav-item" role="presentation">
            <button type="button" class="nav-link @(initialMethod == "ldap" ? "active" : null)" role="tab"
                    data-auth-method="ldap" aria-selected="@(initialMethod == "ldap" ? "true" : "false")"
                    data-i18n="login.tabLdap">@L["login.tabLdap"]</button>
          </li>
        </ul>
        <p class="morobot-login-mode-hint small mb-0 mt-2"
           data-auth-hint data-i18n="@(initialMethod == "ldap" ? "login.modeLdapHint" : "login.modeLocalHint")">@L[initialMethod == "ldap" ? "login.modeLdapHint" : "login.modeLocalHint"]</p>
        @if (providers.Ldap)
        {
          <p class="morobot-login-mode-fallback small mb-0" data-i18n="login.adminFallbackNote">@L["login.adminFallbackNote"]</p>
        }
      </div>
    }
    else if (providers.LdapOnly)
    {
      @* Single method: no chooser, just a line saying which one, so a refused directory password
         is not mistaken for a local account problem. *@
      <div class="morobot-login-mode mb-4">
        <p class="morobot-login-mode-hint small mb-1" data-i18n="login.modeLdapHint">@L["login.modeLdapHint"]</p>
        <p class="morobot-login-mode-fallback small mb-0" data-i18n="login.adminFallbackNote">@L["login.adminFallbackNote"]</p>
      </div>
    }
    <form method="post" asp-area="Panel" asp-controller="Account" asp-action="Login" id="login-form">
      @Html.AntiForgeryToken()
      <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
      <input type="hidden" name="deviceJson" id="deviceJson" value="" />
      <div class="mb-6">
        <label class="form-label" for="userName" data-i18n="login.userName" data-auth-label>@L["login.userName"]</label>
        <input class="form-control" id="userName" name="userName" value="" autocomplete="username" autofocus
               inputmode="text" data-auth-input />
      </div>
      <div class="mb-6">
        <label class="form-label" for="password" data-i18n="login.password">@L["login.password"]</label>
        <input class="form-control" type="password" id="password" name="password" value="" autocomplete="@autocomplete" />
      </div>
      <button class="btn btn-primary d-grid w-100" type="submit" data-i18n="login.submit">@L["login.submit"]</button>
    </form>
    <p class="text-center mt-4 mb-0">
      <a asp-area="Panel" asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewBag.ReturnUrl" data-i18n="login.toRegister">@L["login.toRegister"]</a>
    </p>
    <p class="text-center mt-2 mb-0">
      <a href="/" data-i18n="login.backSite">@L["login.backSite"]</a>
    </p>
    <p class="text-center text-muted small mt-3 mb-0" data-i18n="brand.copyright">@L["brand.copyright"]</p>
  </div>
</div>
  <script src="~/js/da-device.js?v=@V.AssetVersion"></script>
<script>
(function () {
  // The method chooser. Both providers being live means the visitor has to say which account they
  // are using, because the two are typed differently: a national code is digits, a directory
  // account is a name. The choice drives the label, the input hints and the password's autocomplete
  // so the browser does not offer to save a directory password as this site's.
  //
  // The chosen method is intentionally NOT posted: the server decides the provider from the name
  // (see AuthModeResolver.ResolveFor), so a form that lies about the method cannot make the server
  // check credentials against the wrong store.
  var chooser = document.querySelector('[data-auth-chooser]');
  var input = document.querySelector('[data-auth-input]');
  var label = document.querySelector('[data-auth-label]');
  var password = document.getElementById('password');
  var hint = document.querySelector('[data-auth-hint]');

  function apply(method) {
    if (!chooser) return;
    var isLdap = method === 'ldap';
    chooser.querySelectorAll('[data-auth-method]').forEach(function (tab) {
      var on = tab.getAttribute('data-auth-method') === method;
      tab.classList.toggle('active', on);
      tab.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    if (hint) {
      var key = isLdap ? 'login.modeLdapHint' : 'login.modeLocalHint';
      hint.setAttribute('data-i18n', key);
      if (window.DaI18n && DaI18n.t) hint.textContent = DaI18n.t(key);
    }
    if (label) {
      var lk = isLdap ? 'login.userNameLdap' : 'login.userNameLocal';
      label.setAttribute('data-i18n', lk);
      if (window.DaI18n && DaI18n.t) label.textContent = DaI18n.t(lk);
    }
    if (input) {
      // A national code is digits; asking a phone keyboard for it is friendlier than a full one.
      input.setAttribute('inputmode', isLdap ? 'text' : 'numeric');
    }
    if (password) password.setAttribute('autocomplete', isLdap ? 'off' : 'current-password');
  }

  if (chooser) {
    chooser.querySelectorAll('[data-auth-method]').forEach(function (tab) {
      tab.addEventListener('click', function () {
        apply(tab.getAttribute('data-auth-method'));
        if (input) input.focus();
      });
    });
    apply(chooser.getAttribute('data-initial') || 'local');
  }

  var form = document.getElementById("login-form");
  form.addEventListener("submit", function () {
    try {
      var d = window.DaDevice ? DaDevice.collect() : {};
      document.getElementById("deviceJson").value = JSON.stringify(d);
    } catch (e) { /* ignore */ }
  });
})();
</script>
