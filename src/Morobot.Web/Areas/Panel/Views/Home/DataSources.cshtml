@{
    ViewData["Title"] = L["panel.sourcesTitle"] + " — " + L["brand.name"];
}

<div class="da-home da-sources-home">
  <header class="da-home-head">
    <div>
      <div class="da-home-brand" data-i18n="brand.name">@L["brand.name"]</div>
      <h4 class="da-home-title mb-0" data-i18n="panel.sourcesTitle">@L["panel.sourcesTitle"]</h4>
      <p class="da-home-sub mb-0" id="da-sources-status" data-i18n="panel.sourcesSub">@L["panel.sourcesSub"]</p>
    </div>
  </header>

  <div class="da-tasks-panel" id="da-sources-panel">
    <div class="card d-none d-md-block mb-0">
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th>عنوان منبع</th>
              <th>فرآیند</th>
              <th class="text-nowrap">ستون</th>
              <th class="text-nowrap">ردیف</th>
              <th>فایل</th>
              <th class="text-nowrap">عملیات</th>
            </tr>
          </thead>
          <tbody id="da-source-rows">
            <tr><td colspan="6" class="text-center text-muted py-6">در حال بارگذاری...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="da-task-list d-md-none" id="da-source-cards" aria-live="polite">
      <div class="da-task-empty text-muted">در حال بارگذاری...</div>
    </div>

    <!-- List pager: the library can hold many sources, so the table shows one page at a time. -->
    <div class="da-list-pager" id="da-sources-pager" hidden>
      <button type="button" class="btn btn-sm btn-label-secondary" id="da-sources-prev">قبلی</button>
      <span class="da-list-pageinfo" id="da-sources-pageinfo"></span>
      <button type="button" class="btn btn-sm btn-label-secondary" id="da-sources-next">بعدی</button>
    </div>
  </div>
</div>

<div class="ds-viewer" id="da-portal-ds-viewer" hidden>
  <div class="ds-viewer-backdrop" data-portal-ds-close="1"></div>
  <div class="ds-viewer-panel" role="dialog" aria-modal="true" aria-labelledby="da-portal-ds-title">
    <div class="ds-viewer-head">
      <div>
        <h2 id="da-portal-ds-title">منبع داده</h2>
        <p class="ds-viewer-sub" id="da-portal-ds-sub"></p>
      </div>
        <div class="ds-viewer-head-actions">
          <span class="ds-viewer-live" id="da-portal-ds-live" title="اتصال زنده">● آفلاین</span>
          <span class="ds-viewer-actor text-muted small" id="da-portal-ds-actor" hidden></span>
          <button type="button" class="btn btn-sm btn-label-secondary" id="da-portal-ds-refresh">بازخوانی</button>
          <button type="button" class="btn btn-sm btn-label-secondary" data-portal-ds-close="1">بستن</button>
        </div>
    </div>
    <div class="ds-viewer-legend">
      <span class="ds-leg ds-leg-read">خواندن</span>
      <span class="ds-leg ds-leg-write">نوشتن</span>
    </div>
    <div class="ds-viewer-scroll">
      <table class="ds-viewer-table" id="da-portal-ds-table">
        <thead></thead>
        <tbody></tbody>
      </table>
      <!-- Shown while a long grid operation runs (add row/column, refresh) so the user sees that the
           click registered; without it a slow reload just looks frozen. -->
      <div class="ds-grid-loader" id="da-portal-ds-loader" hidden>
        <span class="ds-grid-spinner" aria-hidden="true"></span>
        <span class="ds-grid-loader-text" id="da-portal-ds-loader-text"></span>
      </div>
    </div>
    <div class="ds-viewer-foot" id="da-portal-ds-pager" hidden>
      <button type="button" class="btn btn-sm btn-label-secondary" id="da-portal-ds-prev">قبلی</button>
      <span class="ds-viewer-page" id="da-portal-ds-pageinfo"></span>
      <button type="button" class="btn btn-sm btn-label-secondary" id="da-portal-ds-next">بعدی</button>
    </div>
  </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<link rel="stylesheet" href="~/editor/flow.css?v=list-paging-1" />
<script src="~/js/local-data-sources.js?v=list-paging-1"></script>
}
