@{
    ViewData["Title"] = L["panel.guide.title"] + " — " + L["brand.name"];
    var shots = ViewData["GuideShots"] as string[] ?? Array.Empty<string>();
}

<div class="da-home da-guide">
  <header class="da-home-head">
    <div>
      <div class="da-home-brand" data-i18n="brand.name">@L["brand.name"]</div>
      <h4 class="da-home-title mb-0" data-i18n="panel.guide.title">@L["panel.guide.title"]</h4>
      <p class="da-home-sub mb-0" data-i18n="panel.guide.sub">@L["panel.guide.sub"]</p>
    </div>
  </header>

  <div class="da-guide-layout">

    @* Contents rail. The guide is long by design — it is the one page a new user reads end to end —
       so a jump list is the difference between reading it and scrolling past it. *@
    <nav class="da-guide-toc" aria-labelledby="da-guide-toc-title">
      <h5 class="da-guide-toc-title" id="da-guide-toc-title" data-i18n="panel.guide.toc">@L["panel.guide.toc"]</h5>
      <ol>
        @for (var i = 1; i <= 12; i++)
        {
          var key = $"panel.guide.s{i}Title";
          var label = L[key];
          if (string.IsNullOrWhiteSpace(label) || label == key) { continue; }
          <li><a href="#g-@i" data-i18n="@key">@label</a></li>
        }
      </ol>
    </nav>

    <div class="da-guide-body">

      @* ── 1. Overview ───────────────────────────────────────────────────────── *@
      <section class="da-guide-section" id="g-1">
        <h5><span class="da-guide-num">۱</span><span data-i18n="panel.guide.s1Title">@L["panel.guide.s1Title"]</span></h5>
        <p data-i18n="panel.guide.s1Body">@L["panel.guide.s1Body"]</p>
        <div class="da-guide-callout" data-i18n="panel.guide.s1Note">@L["panel.guide.s1Note"]</div>
      </section>

      @* ── 2. Dashboard ──────────────────────────────────────────────────────── *@
      <section class="da-guide-section" id="g-2">
        <h5><span class="da-guide-num">۲</span><span data-i18n="panel.guide.s2Title">@L["panel.guide.s2Title"]</span></h5>
        <p data-i18n="panel.guide.s2Body">@L["panel.guide.s2Body"]</p>
        <partial name="_GuideShot" model='new Morobot.Web.Areas.Panel.Models.GuideShotModel {
          Slug = "02-dashboard", Key = "panel.guide.s2Title", Caption = "panel.guide.s2Caption", Url = "/Panel"
        }' />
      </section>

      @* ── 3. Processes ──────────────────────────────────────────────────────── *@
      <section class="da-guide-section" id="g-3">
        <h5><span class="da-guide-num">۳</span><span data-i18n="panel.guide.s3Title">@L["panel.guide.s3Title"]</span></h5>
        <p data-i18n="panel.guide.s3Body">@L["panel.guide.s3Body"]</p>
        <ul class="da-guide-list">
          <li data-i18n="panel.guide.s3L1">@L["panel.guide.s3L1"]</li>
          <li data-i18n="panel.guide.s3L2">@L["panel.guide.s3L2"]</li>
          <li data-i18n="panel.guide.s3L3">@L["panel.guide.s3L3"]</li>
        </ul>
        <partial name="_GuideShot" model='new Morobot.Web.Areas.Panel.Models.GuideShotModel {
          Slug = "03-processes", Key = "panel.guide.s3Title", Caption = "panel.guide.s3Caption", Url = "/Panel/Home/Processes"
        }' />
      </section>

      @* ── 4. The editor ─────────────────────────────────────────────────────── *@
      <section class="da-guide-section" id="g-4">
        <h5><span class="da-guide-num">۴</span><span data-i18n="panel.guide.s4Title">@L["panel.guide.s4Title"]</span></h5>
        <p data-i18n="panel.guide.s4Body">@L["panel.guide.s4Body"]</p>
        <partial name="_GuideShot" model='new Morobot.Web.Areas.Panel.Models.GuideShotModel {
          Slug = "04-editor", Key = "panel.guide.s4Title", Caption = "panel.guide.s4Caption", Url = "/Panel/Home/Processes"
        }' />
        <h6 data-i18n="panel.guide.s4NodesTitle">@L["panel.guide.s4NodesTitle"]</h6>
        <ul class="da-guide-list">
          <li data-i18n="panel.guide.s4N1">@L["panel.guide.s4N1"]</li>
          <li data-i18n="panel.guide.s4N2">@L["panel.guide.s4N2"]</li>
          <li data-i18n="panel.guide.s4N3">@L["panel.guide.s4N3"]</li>
          <li data-i18n="panel.guide.s4N4">@L["panel.guide.s4N4"]</li>
        </ul>
        <div class="da-guide-callout" data-i18n="panel.guide.s4Note">@L["panel.guide.s4Note"]</div>
        <h6 data-i18n="panel.guide.s4PropsTitle">@L["panel.guide.s4PropsTitle"]</h6>
        <ul class="da-guide-list">
          <li data-i18n="panel.guide.s4P1">@L["panel.guide.s4P1"]</li>
          <li data-i18n="panel.guide.s4P2">@L["panel.guide.s4P2"]</li>
          <li data-i18n="panel.guide.s4P3">@L["panel.guide.s4P3"]</li>
          <li data-i18n="panel.guide.s4P4">@L["panel.guide.s4P4"]</li>
        </ul>
      </section>

      @* ── 5. Data sources ───────────────────────────────────────────────────── *@
      <section class="da-guide-section" id="g-5">
        <h5><span class="da-guide-num">۵</span><span data-i18n="panel.guide.s5Title">@L["panel.guide.s5Title"]</span></h5>
        <p data-i18n="panel.guide.s5Body">@L["panel.guide.s5Body"]</p>
        <ul class="da-guide-list">
          <li data-i18n="panel.guide.s5L1">@L["panel.guide.s5L1"]</li>
          <li data-i18n="panel.guide.s5L2">@L["panel.guide.s5L2"]</li>
          <li data-i18n="panel.guide.s5L3">@L["panel.guide.s5L3"]</li>
          <li data-i18n="panel.guide.s5L4">@L["panel.guide.s5L4"]</li>
        </ul>
        <partial name="_GuideShot" model='new Morobot.Web.Areas.Panel.Models.GuideShotModel {
          Slug = "05-data-sources", Key = "panel.guide.s5Title", Caption = "panel.guide.s5Caption", Url = "/Panel/Home/DataSources"
        }' />
      </section>

      @* ── 6. Dynamic values ─────────────────────────────────────────────────── *@
      <section class="da-guide-section" id="g-6">
        <h5><span class="da-guide-num">۶</span><span data-i18n="panel.guide.s6Title">@L["panel.guide.s6Title"]</span></h5>
        <p data-i18n="panel.guide.s6Body">@L["panel.guide.s6Body"]</p>
        <pre class="da-guide-code"><code>{cell: Sheet1!A1}
{row: 2}
{date: yyyy-MM-dd}</code></pre>
        <p class="da-guide-hint" data-i18n="panel.guide.s6Hint">@L["panel.guide.s6Hint"]</p>
      </section>

      @* ── 7. Install the extension ──────────────────────────────────────────── *@
      <section class="da-guide-section" id="g-7">
        <h5><span class="da-guide-num">۷</span><span data-i18n="panel.guide.s7Title">@L["panel.guide.s7Title"]</span></h5>
        <p data-i18n="panel.guide.s7Body">@L["panel.guide.s7Body"]</p>
        <partial name="_GuideShot" model='new Morobot.Web.Areas.Panel.Models.GuideShotModel {
          Slug = "07-extension", Key = "panel.guide.s7Title", Caption = "panel.guide.s7Caption", Url = "/Panel/Extension/Install"
        }' />
        <ol class="da-guide-list da-guide-steps">
          <li data-i18n="panel.guide.s7S1">@L["panel.guide.s7S1"]</li>
          <li data-i18n="panel.guide.s7S2">@L["panel.guide.s7S2"]</li>
          <li data-i18n="panel.guide.s7S3">@L["panel.guide.s7S3"]</li>
          <li data-i18n="panel.guide.s7S4">@L["panel.guide.s7S4"]</li>
        </ol>
        <div class="da-guide-callout" data-i18n="panel.guide.s7Note">@L["panel.guide.s7Note"]</div>
      </section>

      @* ── 8. Record ─────────────────────────────────────────────────────────── *@
      <section class="da-guide-section" id="g-8">
        <h5><span class="da-guide-num">۸</span><span data-i18n="panel.guide.s8Title">@L["panel.guide.s8Title"]</span></h5>
        <p data-i18n="panel.guide.s8Body">@L["panel.guide.s8Body"]</p>
        <ol class="da-guide-list da-guide-steps">
          <li data-i18n="panel.guide.s8S1">@L["panel.guide.s8S1"]</li>
          <li data-i18n="panel.guide.s8S2">@L["panel.guide.s8S2"]</li>
          <li data-i18n="panel.guide.s8S3">@L["panel.guide.s8S3"]</li>
        </ol>
        <div class="da-guide-callout" data-i18n="panel.guide.s8Note">@L["panel.guide.s8Note"]</div>
      </section>

      @* ── 9. Play ───────────────────────────────────────────────────────────── *@
      <section class="da-guide-section" id="g-9">
        <h5><span class="da-guide-num">۹</span><span data-i18n="panel.guide.s9Title">@L["panel.guide.s9Title"]</span></h5>
        <p data-i18n="panel.guide.s9Body">@L["panel.guide.s9Body"]</p>
        <ul class="da-guide-list">
          <li data-i18n="panel.guide.s9L1">@L["panel.guide.s9L1"]</li>
          <li data-i18n="panel.guide.s9L2">@L["panel.guide.s9L2"]</li>
          <li data-i18n="panel.guide.s9L3">@L["panel.guide.s9L3"]</li>
        </ul>
      </section>

      @* ── 10. Templates ─────────────────────────────────────────────────────── *@
      <section class="da-guide-section" id="g-10">
        <h5><span class="da-guide-num">۱۰</span><span data-i18n="panel.guide.s10Title">@L["panel.guide.s10Title"]</span></h5>
        <p data-i18n="panel.guide.s10Body">@L["panel.guide.s10Body"]</p>
        <div class="da-guide-callout" data-i18n="panel.guide.s10Note">@L["panel.guide.s10Note"]</div>
      </section>

      @* ── 11. Account settings ──────────────────────────────────────────────── *@
      <section class="da-guide-section" id="g-11">
        <h5><span class="da-guide-num">۱۱</span><span data-i18n="panel.guide.s11Title">@L["panel.guide.s11Title"]</span></h5>
        <p data-i18n="panel.guide.s11Body">@L["panel.guide.s11Body"]</p>
        <partial name="_GuideShot" model='new Morobot.Web.Areas.Panel.Models.GuideShotModel {
          Slug = "11-settings", Key = "panel.guide.s11Title", Caption = "panel.guide.s11Caption", Url = "/Panel/Settings"
        }' />
      </section>

      @* ── 12. Where your data lives ─────────────────────────────────────────── *@
      <section class="da-guide-section" id="g-12">
        <h5><span class="da-guide-num">۱۲</span><span data-i18n="panel.guide.s12Title">@L["panel.guide.s12Title"]</span></h5>
        <p data-i18n="panel.guide.s12Body">@L["panel.guide.s12Body"]</p>
      </section>

    </div>
  </div>
</div>
