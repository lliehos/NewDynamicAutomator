@{
    ViewData["Title"] = L["panel.processesTitle"] + " — " + L["brand.name"];
}

<div class="da-home">
  <header class="da-home-head">
    <div>
      <div class="da-home-brand" data-i18n="brand.name">@L["brand.name"]</div>
      <h4 class="da-home-title mb-0" data-i18n="panel.processesTitle">@L["panel.processesTitle"]</h4>
      <p class="da-home-sub mb-0" id="da-portal-status" data-i18n="panel.processesSub">@L["panel.processesSub"]</p>
    </div>
    <button class="btn btn-primary da-home-create d-none d-md-inline-flex align-items-center gap-1" type="button"
            data-bs-toggle="modal" data-bs-target="#da-create-task-modal">
      <i class="ti ti-plus"></i>
      <span class="da-home-create-label" data-i18n="panel.createProcess">@L["panel.createProcess"]</span>
    </button>
  </header>

  <div class="da-tasks-panel" id="da-tasks-panel">
    <div class="da-tasks-busy" id="da-tasks-busy" hidden aria-live="assertive">
      <div class="da-tasks-busy-inner">
        <span class="da-tasks-spinner" aria-hidden="true"></span>
        <span class="da-tasks-busy-text" data-i18n="panel.busyPlayer">@L["panel.busyPlayer"]</span>
      </div>
    </div>

    <div class="card d-none d-md-block mb-0">
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th data-i18n="panel.colTitle">@L["panel.colTitle"]</th>
              <th class="text-nowrap" data-i18n="panel.colCreated">@L["panel.colCreated"]</th>
              <th data-i18n="panel.colCreator">@L["panel.colCreator"]</th>
              <th data-i18n="panel.colShared">@L["panel.colShared"]</th>
              <th data-i18n="panel.colGroup">@L["panel.colGroup"]</th>
              <th data-i18n="panel.colAction">@L["panel.colAction"]</th>
              <th data-i18n="panel.colSource">@L["panel.colSource"]</th>
              <th class="text-nowrap" data-i18n="panel.colOps">@L["panel.colOps"]</th>
            </tr>
          </thead>
          <tbody id="da-task-rows">
            <tr><td colspan="8" class="text-center text-muted py-6" data-i18n="common.loading">@L["common.loading"]</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="da-task-list d-md-none" id="da-task-cards" aria-live="polite">
      <div class="da-task-empty text-muted" data-i18n="common.loading">@L["common.loading"]</div>
    </div>
  </div>

  <button type="button" class="da-fab d-md-none" data-bs-toggle="modal" data-bs-target="#da-create-task-modal"
          data-i18n-aria="panel.createProcess" data-i18n-title="panel.createProcess"
          aria-label="@L["panel.createProcess"]" title="@L["panel.createProcess"]">
    <i class="ti ti-plus"></i>
  </button>
</div>

<div class="ds-viewer" id="da-portal-ds-viewer" hidden>
  <div class="ds-viewer-backdrop" data-portal-ds-close="1"></div>
  <div class="ds-viewer-panel" role="dialog" aria-modal="true" aria-labelledby="da-portal-ds-title">
    <div class="ds-viewer-head">
      <div>
        <h2 id="da-portal-ds-title">منبع داده</h2>
        <p class="ds-viewer-sub" id="da-portal-ds-sub"></p>
      </div>
      <div class="ds-viewer-head-actions">
        <button type="button" class="btn btn-sm btn-label-secondary" data-portal-ds-close="1">بستن</button>
      </div>
    </div>
    <div class="ds-viewer-scroll">
      <table class="ds-viewer-table" id="da-portal-ds-table">
        <thead></thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</div>

<div class="modal fade" id="da-create-task-modal" tabindex="-1" aria-labelledby="da-create-task-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
    <div class="modal-content">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title" id="da-create-task-title" data-i18n="panel.createProcess">@L["panel.createProcess"]</h5>
      </div>
      <div class="modal-body">
        <label class="form-label" for="da-new-title" data-i18n="panel.processTitle">@L["panel.processTitle"]</label>
        <input class="form-control form-control-lg" id="da-new-title" type="text" data-i18n-placeholder="panel.processTitlePh" placeholder="@L["panel.processTitlePh"]" autocomplete="off" />
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal" data-i18n="common.cancel">@L["common.cancel"]</button>
        <button type="button" class="btn btn-primary" id="da-create-local" data-i18n="common.create">@L["common.create"]</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<link rel="stylesheet" href="~/editor/flow.css?v=rename-ds-1" />
<script src="~/js/task-share.js?v=2"></script>
<script src="~/js/local-tasks.js?v=play-hydrate-1"></script>
<script>
  document.querySelectorAll("[data-portal-ds-close]").forEach((el) => {
    el.addEventListener("click", () => {
      const modal = document.getElementById("da-portal-ds-viewer");
      if (modal) modal.hidden = true;
    });
  });
</script>
}
