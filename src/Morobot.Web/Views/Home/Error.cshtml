@{
    Layout = null;
    ViewData["Title"] = "خطا";
    var brandHead = ViewData["BrandHead"] as BrandHeadModel ?? new BrandHeadModel();
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>خطا — @brandHead.AppName</title>
  <partial name="_BrandHead" model="brandHead" />
  <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    body { font-family: Vazirmatn, sans-serif; margin: 0; min-height: 100vh; display: grid; place-items: center; background: #f0fdfa; color: #134e4a; }
    a { color: #0d9488; }
  </style>
</head>
<body>
  <div style="text-align:center;padding:2rem">
    @{ ViewData["BrandImgClass"] = ""; ViewData["BrandImgWidth"] = 48; ViewData["BrandImgHeight"] = 48; }
    <partial name="_BrandMark" model="brandHead" />
    <h1 style="font-size:1.25rem;margin:1rem 0 .5rem">خطایی رخ داد</h1>
    <p style="opacity:.8;margin-bottom:1.25rem">لطفاً دوباره تلاش کنید.</p>
    <a href="/">بازگشت به صفحهٔ اصلی</a>
  </div>
</body>
</html>
