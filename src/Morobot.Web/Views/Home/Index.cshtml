@{
  var culture = L.Culture;
  var dir = L.Dir;
  var isEn = !L.IsRtl;
  var brandHead = ViewData["BrandHead"] as BrandHeadModel ?? new BrandHeadModel();
}
<!doctype html>
<html lang="@culture" dir="@dir" data-culture="@culture" data-i18n-title-key="landing.title" class="@(isEn ? "lp-ltr" : "lp-rtl")">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@brandHead.BrandTitle</title>
  <meta name="description" data-i18n="landing.description" content="@L["landing.description"]" />
  <meta name="theme-color" content="#0d9488" />
  <partial name="_BrandHead" model="brandHead" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Vazirmatn:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/landing.css?v=2" />
</head>
<body class="lp">
  <div class="lp-bg" aria-hidden="true"></div>

  <header class="lp-nav">
    <a class="lp-brand" href="/">
      @{ ViewData["BrandImgClass"] = ""; ViewData["BrandImgWidth"] = 36; ViewData["BrandImgHeight"] = 36; }
      <partial name="_BrandMark" model="brandHead" />
      <span class="lp-brand-name">@brandHead.AppName</span>
    </a>
    <nav class="lp-nav-links" data-i18n-aria="landing.navAria" aria-label="@L["landing.navAria"]">
      <a href="#features" data-i18n="landing.navFeatures">@L["landing.navFeatures"]</a>
      <a href="#how" data-i18n="landing.navHow">@L["landing.navHow"]</a>
      <a href="#stack" data-i18n="landing.navStack">@L["landing.navStack"]</a>
      <a asp-controller="Home" asp-action="SetupGuide" data-i18n="landing.navSetup">@L["landing.navSetup"]</a>
    </nav>
    <div class="lp-nav-actions">
      <button type="button" class="lp-lang-btn" data-lang-switch data-lang-mode="live"
              data-lang-next="@(isEn ? "fa" : "en")"
              title="@(isEn ? L["common.switchLangTitleFa"] : L["common.switchLangTitle"])"
              aria-label="@(isEn ? L["common.switchLangTitleFa"] : L["common.switchLangTitle"])">@(isEn ? L["common.switchToFa"] : L["common.switchToEn"])</button>
      <a class="lp-btn lp-btn-solid" asp-area="Panel" asp-controller="Home" asp-action="Index" data-i18n="common.panel">@L["common.panel"]</a>
    </div>
  </header>

  <main>
    <section class="lp-hero" data-i18n-aria="landing.heroAria" aria-label="@L["landing.heroAria"]">
      <div class="lp-hero-copy">
        <p class="lp-kicker" data-i18n="landing.kicker">@L["landing.kicker"]</p>
        <h1 class="lp-logo-word">
          <span class="lp-logo-name" data-i18n="brand.name">@L["brand.name"]</span>
        </h1>
        <p class="lp-lead" data-i18n="landing.lead">@L["landing.lead"]</p>
        <div class="lp-cta">
          <a class="lp-btn lp-btn-solid lp-btn-lg" asp-area="Panel" asp-controller="Account" asp-action="Login" data-i18n="common.panel">@L["common.panel"]</a>
          <a class="lp-btn lp-btn-ghost lp-btn-lg" asp-controller="Home" asp-action="SetupGuide" data-i18n="landing.ctaSetup">@L["landing.ctaSetup"]</a>
          <a class="lp-btn lp-btn-ghost lp-btn-lg" href="#features" data-i18n="landing.ctaLearn">@L["landing.ctaLearn"]</a>
        </div>
      </div>
      <div class="lp-hero-visual" aria-hidden="true">
        <img class="lp-hero-img" src="@L["brand.heroImg"]" width="1280" height="720" alt="" data-i18n-src="brand.heroImg" />
        <div class="lp-hero-fade"></div>
      </div>
    </section>

    <section class="lp-section" id="features">
      <header class="lp-section-head">
        <h2 data-i18n="landing.featuresTitle">@L["landing.featuresTitle"]</h2>
        <p data-i18n="landing.featuresSub">@L["landing.featuresSub"]</p>
      </header>
      <figure class="lp-feature-art">
        <img src="@L["brand.featuresImg"]" width="1280" height="720" data-i18n-src="brand.featuresImg" data-i18n-attr="alt" data-i18n="landing.featuresImgAlt" alt="@L["landing.featuresImgAlt"]" />
      </figure>
      <div class="lp-feature-grid">
        <article class="lp-feat">
          <div class="lp-feat-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M12 2a3 3 0 0 1 3 3v1h2a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V9a3 3 0 0 1 3-3h2V5a3 3 0 0 1 3-3zm0 2a1 1 0 0 0-1 1v1h2V5a1 1 0 0 0-1-1zm-1 7v6h2v-6h-2z"/></svg>
          </div>
          <h3 data-i18n="landing.featRecordTitle">@L["landing.featRecordTitle"]</h3>
          <p data-i18n="landing.featRecordBody">@L["landing.featRecordBody"]</p>
        </article>
        <article class="lp-feat">
          <div class="lp-feat-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M4 4h16v4H4V4zm0 6h7v10H4V10zm9 0h7v10h-7V10z"/></svg>
          </div>
          <h3 data-i18n="landing.featEditorTitle">@L["landing.featEditorTitle"]</h3>
          <p data-i18n="landing.featEditorBody">@L["landing.featEditorBody"]</p>
        </article>
        <article class="lp-feat">
          <div class="lp-feat-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M3 4h18v3H3V4zm0 5h8v11H3V9zm10 0h8v11h-8V9z"/></svg>
          </div>
          <h3 data-i18n="landing.featDataTitle">@L["landing.featDataTitle"]</h3>
          <p data-i18n="landing.featDataBody">@L["landing.featDataBody"]</p>
        </article>
        <article class="lp-feat">
          <div class="lp-feat-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M8 5v14l11-7L8 5z"/></svg>
          </div>
          <h3 data-i18n="landing.featPlayTitle">@L["landing.featPlayTitle"]</h3>
          <p data-i18n="landing.featPlayBody">@L["landing.featPlayBody"]</p>
        </article>
      </div>
    </section>

    <section class="lp-section lp-section-alt" id="how">
      <header class="lp-section-head">
        <h2 data-i18n="landing.howTitle">@L["landing.howTitle"]</h2>
        <p data-i18n="landing.howSub">@L["landing.howSub"]</p>
      </header>
      <ol class="lp-steps">
        <li>
          <span class="lp-step-num">1</span>
          <div>
            <h3 data-i18n="landing.how1Title">@L["landing.how1Title"]</h3>
            <p data-i18n="landing.how1Body">@L["landing.how1Body"]</p>
          </div>
        </li>
        <li>
          <span class="lp-step-num">2</span>
          <div>
            <h3 data-i18n="landing.how2Title">@L["landing.how2Title"]</h3>
            <p data-i18n="landing.how2Body">@L["landing.how2Body"]</p>
          </div>
        </li>
        <li>
          <span class="lp-step-num">3</span>
          <div>
            <h3 data-i18n="landing.how3Title">@L["landing.how3Title"]</h3>
            <p data-i18n="landing.how3Body">@L["landing.how3Body"]</p>
          </div>
        </li>
      </ol>
    </section>

    <section class="lp-section" id="stack">
      <header class="lp-section-head">
        <h2 data-i18n="landing.stackTitle">@L["landing.stackTitle"]</h2>
        <p data-i18n="landing.stackSub">@L["landing.stackSub"]</p>
      </header>
      <div class="lp-ext-row">
        <article class="lp-ext">
          <h3>Recorder</h3>
          <p data-i18n="landing.extRecorderBody">@L["landing.extRecorderBody"]</p>
        </article>
        <article class="lp-ext">
          <h3>Player</h3>
          <p data-i18n="landing.extPlayerBody">@L["landing.extPlayerBody"]</p>
        </article>
        <article class="lp-ext">
          <h3>Selector</h3>
          <p data-i18n="landing.extSelectorBody">@L["landing.extSelectorBody"]</p>
        </article>
      </div>
    </section>

    <section class="lp-cta-band">
      <div class="lp-cta-band-inner">
        @{ ViewData["BrandImgClass"] = ""; ViewData["BrandImgWidth"] = 48; ViewData["BrandImgHeight"] = 48; }
        <partial name="_BrandMark" model="brandHead" />
        <h2 data-i18n="landing.ctaBandTitle">@L["landing.ctaBandTitle"]</h2>
        <p data-i18n="landing.ctaBandBody">@L["landing.ctaBandBody"]</p>
        <a class="lp-btn lp-btn-solid lp-btn-lg" asp-area="Panel" asp-controller="Account" asp-action="Login" data-i18n="common.panel">@L["common.panel"]</a>
      </div>
    </section>
  </main>

  <footer class="lp-foot">
    <div class="lp-foot-brand">
      @{ ViewData["BrandImgClass"] = ""; ViewData["BrandImgWidth"] = 24; ViewData["BrandImgHeight"] = 24; }
      <partial name="_BrandMark" model="brandHead" />
      <span>@brandHead.AppName</span>
    </div>
    <p data-i18n="brand.copyright">@L["brand.copyright"]</p>
    <p><a asp-controller="Home" asp-action="SetupGuide" data-i18n="landing.navSetup">@L["landing.navSetup"]</a></p>
  </footer>

  <script src="~/js/i18n.js?v=3"></script>
</body>
</html>
