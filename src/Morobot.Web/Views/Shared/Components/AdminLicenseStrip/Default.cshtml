@model Morobot.Web.ViewComponents.AdminLicenseStripModel
@using Morobot.Licensing
@{
  var d = Model.Display;
  if (d.ValidityEndsAtUtc is null) return;

  var endLocal = d.ValidityEndsAtUtc.Value.ToLocalTime();
  var startLocal = d.ValidityStartsAtUtc?.ToLocalTime();
  var mode = d.RuntimeMode;
  string modeLabel = L[$"admin.license.runtime.{mode}"];
  var days = d.DaysRemaining;
  var endText = endLocal.ToString("yyyy-MM-dd HH:mm");
  var startText = startLocal?.ToString("yyyy-MM-dd HH:mm");
}
<div class="admin-alert @Model.AlertClass admin-license-strip" role="status">
  <strong><i class="ti ti-clock" aria-hidden="true"></i> @L["admin.license.validityBannerTitle"]</strong>
  <span>@modeLabel — @L["admin.license.fieldValidUntil"]: <span class="num">@endText</span></span>
  @if (startText is not null)
  {
    <span class="admin-license-strip-sep">·</span>
    <span>@L["admin.license.fieldValidityFrom"]: @startText</span>
  }
  @if (days is int n && n >= 0)
  {
    <span class="admin-license-strip-sep">·</span>
    <span>@string.Format(L["admin.license.daysRemaining"], n)</span>
  }
  @if (mode == nameof(LicenseRuntimeMode.Restricted) || (days is int x && x <= 0))
  {
    <span class="admin-license-strip-sep">·</span>
    <a asp-area="Admin" asp-controller="License" asp-action="Index">@L["admin.license.validityBannerAction"]</a>
  }
</div>
