@{
    Layout = null;
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8" />
  <title>طراح گردش فرآیند</title>
  <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/editor/flow.css" />
</head>
<body>
  <div class="flow-shell" id="flow-app" data-task-id="@ViewBag.TaskId" data-can-modify="@(ViewBag.CanModify == true ? "true" : "false")">
    <div class="flow-ribbon">
      <a class="btn-flow btn-ghost" href="@Url.Action("Index","Home")">فرآیندها</a>
      <div class="tabs">
        <button type="button" class="on" data-view="diagram" id="tab-diagram">نمودار گردش</button>
        <button type="button" data-view="list" id="tab-list">فهرست مراحل</button>
      </div>
      <button class="btn-flow btn-ghost" type="button" id="btn-group">گروه‌بندی انتخاب</button>
      <button class="btn-flow btn-ghost" type="button" id="btn-fit">نمایش کامل</button>
      <h1 id="flow-title">گردش کار</h1>
      <span class="status" id="flow-status">بارگذاری...</span>
      <button class="btn-flow" type="button" id="btn-save">ذخیره</button>
    </div>
    <div class="flow-body">
      <aside class="flow-palette">
        <h3>جعبه ابزار</h3>
        <div class="stencil" draggable="true" data-kind="group">گروه (حلقه)</div>
        <div class="stencil" draggable="true" data-kind="step">مرحله / اکشن</div>
        <div class="stencil" draggable="true" data-kind="condition">شرط</div>
        <p style="font-size:12px;color:#a8aaae;line-height:1.8;margin-top:14px">
          نتیجه رکورد اینجا دیده می‌شود. چند مرحله را انتخاب کنید و «گروه‌بندی» بزنید، بعد منبع تکرار گروه را در ویژگی‌ها بگذارید.
        </p>
      </aside>
      <div class="canvas-wrap" id="canvas-wrap">
        <svg id="flow-svg" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="grid" width="24" height="24" patternUnits="userSpaceOnUse">
              <path d="M 24 0 L 0 0 0 24" fill="none" stroke="#d8d6ea" stroke-width="1"/>
            </pattern>
            <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0 0 L10 5 L0 10 z" fill="#7367f0"/>
            </marker>
          </defs>
          <rect width="4000" height="4000" fill="url(#grid)"></rect>
          <g id="world"></g>
        </svg>
        <div class="list-wrap" id="list-wrap" hidden></div>
        <div class="hint">چرخ: زوم · درگ خالی: پن · Shift+کلیک: چندانتخاب · Delete: حذف</div>
      </div>
      <aside class="flow-inspector">
        <h3>ویژگی‌ها</h3>
        <div id="inspector"><p style="color:#a8aaae">یک شکل یا ردیف را انتخاب کنید.</p></div>
      </aside>
    </div>
  </div>
  <script src="~/editor/flow.js"></script>
</body>
</html>
