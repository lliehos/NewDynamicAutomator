@{
    ViewData["Title"] = "فرآیندها";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <h4 class="mb-0">فرآیندها <span class="badge bg-label-secondary">ذخیره محلی مرورگر</span></h4>
  <div class="d-flex gap-2 flex-wrap align-items-center">
    <input class="form-control" id="da-new-title" placeholder="عنوان فرآیند جدید" style="min-width: 200px;" />
    <button class="btn btn-primary" type="button" id="da-create-local">ایجاد فرآیند</button>
  </div>
</div>
<p class="text-muted small" id="da-portal-status">فرآیندها در مرورگر ذخیره می‌شوند (بدون سرور). اجرا و ضبط همیشه در تب جدید خالی انجام می‌شود.</p>

<div class="card">
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>عنوان</th>
          <th>نوع ساخت</th>
          <th>گروه</th>
          <th>اقدام</th>
          <th>منبع</th>
          <th class="text-nowrap">عملیات</th>
        </tr>
      </thead>
      <tbody id="da-task-rows">
        <tr><td colspan="6" class="text-center text-muted py-6">در حال بارگذاری از حافظهٔ محلی...</td></tr>
      </tbody>
    </table>
  </div>
</div>

@section Scripts {
<script src="~/js/local-tasks.js?v=task-actions-4"></script>
}
