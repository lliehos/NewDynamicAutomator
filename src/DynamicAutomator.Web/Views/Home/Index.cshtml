@{
    ViewData["Title"] = "فرآیندها";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <h4 class="mb-0">فرآیندها <span class="badge bg-label-secondary">ذخیره محلی مرورگر</span></h4>
  <div class="d-flex gap-2 flex-wrap">
    <button type="button" class="btn btn-success" id="da-btn-start-record" data-da-action="start-record">
      شروع ضبط
    </button>
    <a class="btn btn-outline-secondary" asp-controller="Extension" asp-action="Install">نصب افزونه</a>
    <div class="d-flex gap-2">
      <input class="form-control" id="da-new-title" placeholder="عنوان فرآیند جدید (دستی)" />
      <button class="btn btn-primary" type="button" id="da-create-local">طراحی دستی</button>
    </div>
  </div>
</div>
<p class="text-muted small" id="da-portal-status">فرآیندها در مرورگر ذخیره می‌شوند (بدون سرور).</p>

<div class="card">
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>عنوان</th>
          <th>نوع ساخت</th>
          <th>گروه</th>
          <th>مرحله</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="da-task-rows">
        <tr><td colspan="5" class="text-center text-muted py-6">در حال بارگذاری از حافظهٔ محلی...</td></tr>
      </tbody>
    </table>
  </div>
</div>

@section Scripts {
<script src="~/js/local-tasks.js"></script>
}
