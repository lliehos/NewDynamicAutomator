@model List<TaskListItemDto>
@{
    ViewData["Title"] = "فرآیندها";
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0">فرآیندها</h4>
  <form asp-controller="Tasks" asp-action="Create" method="post" class="d-flex gap-2">
    @Html.AntiForgeryToken()
    <input class="form-control" name="title" placeholder="عنوان فرآیند جدید" required />
    <button class="btn btn-primary" type="submit">طراحی گردش</button>
  </form>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>عنوان</th>
          <th>گروه</th>
          <th>مرحله</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
      @if (Model.Count == 0)
      {
        <tr><td colspan="4" class="text-center text-muted py-6">فرآیندی نیست. ضبط کنید یا گردش جدید بسازید.</td></tr>
      }
      else
      {
        foreach (var t in Model)
        {
          <tr>
            <td>@t.Title</td>
            <td>@t.GroupCount</td>
            <td>@t.StepCount</td>
            <td><a class="btn btn-sm btn-primary" href="@Url.Action("Editor","Tasks", new { id = t.Id })">نمودار و فهرست</a></td>
          </tr>
        }
      }
      </tbody>
    </table>
  </div>
</div>
