@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "ورود";
}

<div class="card">
  <div class="card-body">
    <div class="app-brand justify-content-center mb-6">
      <span class="app-brand-text demo text-heading fw-bold">اتوماتور پویا</span>
    </div>
    <h4 class="mb-1">ورود فرضی (محلی)</h4>
    <p class="mb-4">فعلاً داده روی سرور ذخیره نمی‌شود؛ همه چیز در مرورگر می‌ماند. هر نام کاربری کافی است.</p>
    <div class="alert alert-info small">پیشنهاد: <code>test</code> / هر رمزی — یا خالی بگذارید و وارد شوید.</div>
    <form method="post" asp-action="Login">
      @Html.AntiForgeryToken()
      <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
      <div class="mb-6">
        <label class="form-label" for="userName">نام کاربری</label>
        <input class="form-control" id="userName" name="userName" value="test" autofocus />
      </div>
      <div class="mb-6">
        <label class="form-label" for="password">رمز عبور</label>
        <input class="form-control" type="password" id="password" name="password" value="test" />
      </div>
      <button class="btn btn-primary d-grid w-100" type="submit">ورود تستی</button>
    </form>
  </div>
</div>
