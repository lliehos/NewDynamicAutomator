<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="VsPrimaryBrush" Color="#0F766E"/>
  <SolidColorBrush x:Key="VsPrimarySoftBrush" Color="#ECFDF5"/>
  <SolidColorBrush x:Key="VsInkBrush" Color="#334155"/>
  <SolidColorBrush x:Key="VsMutedBrush" Color="#64748B"/>
  <SolidColorBrush x:Key="VsRequiredBrush" Color="#B91C1C"/>
  <SolidColorBrush x:Key="VsOptionalBrush" Color="#0369A1"/>
  <SolidColorBrush x:Key="VsBorderBrush" Color="#E2E8F0"/>

  <Style x:Key="VsWindow" TargetType="Window">
    <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Background" Value="#F8FAFC"/>
  </Style>

  <Style x:Key="VsTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource VsPrimaryBrush}"/>
  </Style>

  <Style x:Key="VsSectionTitle" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource VsInkBrush}"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>

  <Style x:Key="VsHint" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource VsMutedBrush}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="28,0,0,6"/>
    <Setter Property="LineHeight" Value="18"/>
  </Style>

  <Style x:Key="VsBadgeRequired" TargetType="Border">
    <Setter Property="Background" Value="#FEE2E2"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="6,0,0,0"/>
  </Style>

  <Style x:Key="VsBadgeOptional" TargetType="Border">
    <Setter Property="Background" Value="#E0F2FE"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="6,0,0,0"/>
  </Style>

  <Style x:Key="VsBadgeText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="VsFieldIcon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Foreground" Value="{StaticResource VsPrimaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Margin" Value="0,2,8,0"/>
    <Setter Property="Width" Value="20"/>
    <Setter Property="TextAlignment" Value="Center"/>
  </Style>

  <Style x:Key="VsHelpIcon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
    <Setter Property="Text" Value="&#xE897;"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource VsMutedBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="4,0,0,0"/>
    <Setter Property="Cursor" Value="Help"/>
  </Style>

  <Style x:Key="VsTextBox" TargetType="TextBox">
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="BorderBrush" Value="{StaticResource VsBorderBrush}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style x:Key="VsButton" TargetType="Button">
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="Background" Value="{StaticResource VsPrimaryBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

  <Style x:Key="VsButtonSecondary" TargetType="Button" BasedOn="{StaticResource VsButton}">
    <Setter Property="Background" Value="#64748B"/>
  </Style>

  <Style x:Key="VsFieldBlock" TargetType="StackPanel">
    <Setter Property="Margin" Value="0,0,0,14"/>
  </Style>

</ResourceDictionary>
