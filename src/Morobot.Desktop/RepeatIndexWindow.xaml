<Window x:Class="Morobot.Desktop.RepeatIndexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DsWindow}"
        Title="انتخاب اندیس تکرار"
        Height="460" Width="420" MinHeight="360" MinWidth="340"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/morobot-icon.png">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Style="{StaticResource DsSectionTitle}" Text="انتخاب اندیس تکرار"/>
    <TextBlock Grid.Row="1" Style="{StaticResource DsHint}" Margin="0,0,0,10"
               Text="این فرآیند بیش از یک تکرار دارد. اندیس‌هایی که باید اجرا شوند را انتخاب کنید."/>

    <DockPanel Grid.Row="2">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
        <Button Content="همه" Style="{StaticResource DsButtonSecondary}" Padding="10,3" Margin="0,0,6,0" Click="All_Click"/>
        <Button Content="هیچ" Style="{StaticResource DsButtonSecondary}" Padding="10,3" Margin="0,0,6,0" Click="None_Click"/>
      </StackPanel>
      <ListBox x:Name="IndexList" SelectionMode="Multiple"/>
    </DockPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
      <Button Content="شروع اجرا" Style="{StaticResource DsButton}" MinWidth="110" Click="Start_Click"/>
      <Button Content="انصراف" Style="{StaticResource DsButtonSecondary}" MinWidth="90" Margin="8,0,0,0" Click="Cancel_Click"/>
    </StackPanel>
  </Grid>
</Window>
