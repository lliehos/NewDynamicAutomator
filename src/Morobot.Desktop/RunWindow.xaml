<Window x:Class="Morobot.Desktop.RunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DsWindow}"
        Title="نتیجهٔ اجرا"
        Height="560" Width="760" MinHeight="420" MinWidth="600"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/morobot-icon.png">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <TextBlock x:Name="TitleText" Style="{StaticResource DsSectionTitle}" DockPanel.Dock="Right"
                 Text="اجرا" VerticalAlignment="Center"/>
      <Border Style="{StaticResource DsBadge}" HorizontalAlignment="Left">
        <TextBlock x:Name="ModeBadge" Text="حالت سرور" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource DsPrimaryBrush}"/>
      </Border>
    </DockPanel>

    <StackPanel Grid.Row="1" Margin="0,6,0,10">
      <TextBlock x:Name="StatusText" Text="{Binding StatusLabel}" FontWeight="SemiBold"/>
      <ProgressBar x:Name="Progress" Height="6" Margin="0,6,0,0" Minimum="0" Maximum="1"/>
      <TextBlock x:Name="StepText" Style="{StaticResource DsHint}" Margin="0,4,0,0"/>
    </StackPanel>

    <ListBox x:Name="LogList" Grid.Row="2" FontFamily="Consolas, Tahoma" FontSize="11.5"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

    <DockPanel Grid.Row="3" Margin="0,10,0,0">
      <Button x:Name="StopButton" DockPanel.Dock="Left" Style="{StaticResource DsButtonDanger}"
              Content="توقف" MinWidth="100" Click="Stop_Click"/>
      <Button x:Name="CloseButton" DockPanel.Dock="Left" Style="{StaticResource DsButtonSecondary}"
              Content="بستن" MinWidth="100" Margin="0,0,8,0" Click="Close_Click"/>
      <TextBlock x:Name="ElapsedText" Style="{StaticResource DsHint}" HorizontalAlignment="Right"
                 VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Window>
