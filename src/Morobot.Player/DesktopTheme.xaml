<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Same palette as the vendor studio, so the two desktop tools read as one product. -->
  <SolidColorBrush x:Key="DsPrimaryBrush" Color="#7367F0"/>
  <SolidColorBrush x:Key="DsPrimarySoftBrush" Color="#ECEBFF"/>
  <SolidColorBrush x:Key="DsInkBrush" Color="#334155"/>
  <SolidColorBrush x:Key="DsMutedBrush" Color="#64748B"/>
  <SolidColorBrush x:Key="DsBorderBrush" Color="#E2E8F0"/>
  <SolidColorBrush x:Key="DsSuccessBrush" Color="#28C76F"/>
  <SolidColorBrush x:Key="DsDangerBrush" Color="#EA5455"/>
  <SolidColorBrush x:Key="DsWarnBrush" Color="#FF9F43"/>
  <SolidColorBrush x:Key="DsSurfaceBrush" Color="#FFFFFF"/>

  <Style x:Key="DsWindow" TargetType="Window">
    <Setter Property="FontFamily" Value="Vazirmatn, Segoe UI, Tahoma"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Background" Value="#F5F4FB"/>
  </Style>

  <Style x:Key="DsTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource DsPrimaryBrush}"/>
  </Style>

  <Style x:Key="DsSectionTitle" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource DsInkBrush}"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>

  <Style x:Key="DsHint" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource DsMutedBrush}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="18"/>
  </Style>

  <Style x:Key="DsFieldBlock" TargetType="StackPanel">
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>

  <Style x:Key="DsTextBox" TargetType="TextBox">
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style x:Key="DsPasswordBox" TargetType="PasswordBox">
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style x:Key="DsButton" TargetType="Button">
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="Background" Value="{StaticResource DsPrimaryBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DsButtonSecondary" TargetType="Button" BasedOn="{StaticResource DsButton}">
    <Setter Property="Background" Value="#E7E6F2"/>
    <Setter Property="Foreground" Value="{StaticResource DsInkBrush}"/>
  </Style>

  <Style x:Key="DsButtonDanger" TargetType="Button" BasedOn="{StaticResource DsButton}">
    <Setter Property="Background" Value="{StaticResource DsDangerBrush}"/>
  </Style>

  <Style x:Key="DsButtonGhost" TargetType="Button" BasedOn="{StaticResource DsButton}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource DsPrimaryBrush}"/>
  </Style>

  <Style x:Key="DsCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource DsSurfaceBrush}"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style x:Key="DsBadge" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource DsPrimarySoftBrush}"/>
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}"/>
    <Setter Property="RowBackground" Value="White"/>
    <Setter Property="AlternatingRowBackground" Value="#FAFAFD"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="#F0EFF7"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="RowHeight" Value="42"/>
  </Style>

  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#F3F2FA"/>
    <Setter Property="Foreground" Value="{StaticResource DsInkBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}"/>
  </Style>

</ResourceDictionary>
