<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!--
    The panel's Persian face, embedded (see the Resource items in the csproj). WPF addresses an
    embedded font as "./path/to/file.ttf#FamilyName"; the family name inside these files is Vazir,
    and the bold file is its own face rather than a synthesised weight — which is why text that
    wants 600 has to ask for the bold family by name instead of relying on FontWeight.
  -->
  <FontFamily x:Key="DsFont">./Assets/Fonts/#Vazir</FontFamily>
  <FontFamily x:Key="DsFontBold">./Assets/Fonts/Vazir-Bold-FD-WOL.ttf#Vazir</FontFamily>

  <!-- Same palette as the vendor studio, so the two desktop tools read as one product. -->
  <SolidColorBrush x:Key="DsPrimaryBrush" Color="#7367F0"/>
  <SolidColorBrush x:Key="DsPrimarySoftBrush" Color="#ECEBFF"/>
  <SolidColorBrush x:Key="DsPrimaryDeepBrush" Color="#5B4FD6"/>
  <SolidColorBrush x:Key="DsInkBrush" Color="#334155"/>
  <SolidColorBrush x:Key="DsMutedBrush" Color="#64748B"/>
  <SolidColorBrush x:Key="DsFaintBrush" Color="#94A3B8"/>
  <SolidColorBrush x:Key="DsBorderBrush" Color="#E2E8F0"/>
  <SolidColorBrush x:Key="DsBorderSoftBrush" Color="#EEF1F6"/>
  <SolidColorBrush x:Key="DsSuccessBrush" Color="#28C76F"/>
  <SolidColorBrush x:Key="DsSuccessSoftBrush" Color="#E7F9EF"/>
  <SolidColorBrush x:Key="DsDangerBrush" Color="#EA5455"/>
  <SolidColorBrush x:Key="DsDangerSoftBrush" Color="#FDECEC"/>
  <SolidColorBrush x:Key="DsWarnBrush" Color="#FF9F43"/>
  <SolidColorBrush x:Key="DsSurfaceBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="DsCanvasBrush" Color="#F5F4FB"/>

  <Style x:Key="DsWindow" TargetType="Window">
    <Setter Property="FontFamily" Value="{StaticResource DsFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Background" Value="{StaticResource DsCanvasBrush}"/>
  </Style>

  <Style x:Key="DsTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DsFontBold}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="Foreground" Value="{StaticResource DsPrimaryBrush}"/>
  </Style>

  <Style x:Key="DsSectionTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DsFontBold}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Foreground" Value="{StaticResource DsInkBrush}"/>
  </Style>

  <Style x:Key="DsHint" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource DsMutedBrush}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="19"/>
  </Style>

  <Style x:Key="DsLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DsFontBold}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{StaticResource DsInkBrush}"/>
    <Setter Property="Margin" Value="2,0,0,6"/>
  </Style>

  <Style x:Key="DsFieldBlock" TargetType="StackPanel">
    <Setter Property="Margin" Value="0,0,0,14"/>
  </Style>

  <!--
    One border, drawn by the template. The default WPF TextBox already draws a border and a focus
    adornment, so styling BorderBrush on top of it produced the double outline this used to show.
    Setting a null template border and drawing our own rounded one is what removes it.
  -->
  <Style x:Key="DsTextBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource DsFont}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="Foreground" Value="{StaticResource DsInkBrush}"/>
    <Setter Property="CaretBrush" Value="{StaticResource DsPrimaryBrush}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Shell" Background="{StaticResource DsSurfaceBrush}"
                  BorderBrush="{StaticResource DsBorderBrush}" BorderThickness="1" CornerRadius="10">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shell" Property="BorderBrush" Value="#CBD5E1"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource DsPrimaryBrush}"/>
              <Setter TargetName="Shell" Property="BorderThickness" Value="1.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DsPasswordBox" TargetType="PasswordBox">
    <Setter Property="FontFamily" Value="{StaticResource DsFont}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="Foreground" Value="{StaticResource DsInkBrush}"/>
    <Setter Property="CaretBrush" Value="{StaticResource DsPrimaryBrush}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Shell" Background="{StaticResource DsSurfaceBrush}"
                  BorderBrush="{StaticResource DsBorderBrush}" BorderThickness="1" CornerRadius="10">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shell" Property="BorderBrush" Value="#CBD5E1"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource DsPrimaryBrush}"/>
              <Setter TargetName="Shell" Property="BorderThickness" Value="1.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DsButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource DsFontBold}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="18,9"/>
    <Setter Property="Background" Value="{StaticResource DsPrimaryBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="10"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shell" Property="Background" Value="{StaticResource DsPrimaryDeepBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Shell" Property="Opacity" Value="0.85"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Shell" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DsButtonSecondary" TargetType="Button" BasedOn="{StaticResource DsButton}">
    <Setter Property="Background" Value="#EDECF6"/>
    <Setter Property="Foreground" Value="{StaticResource DsInkBrush}"/>
  </Style>

  <Style x:Key="DsButtonDanger" TargetType="Button" BasedOn="{StaticResource DsButton}">
    <Setter Property="Background" Value="{StaticResource DsDangerBrush}"/>
  </Style>

  <Style x:Key="DsButtonGhost" TargetType="Button" BasedOn="{StaticResource DsButton}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource DsPrimaryBrush}"/>
  </Style>

  <!--
    The sign-in button under the login form. It opens the browser, so it is styled as a full-width
    Call To Action rather than a form button — it is the only way in, and it should look like it.
  -->
  <Style x:Key="DsBrandButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource DsFontBold}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="20,13"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Shell" CornerRadius="12" Padding="{TemplateBinding Padding}">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#7D71F5" Offset="0"/>
                <GradientStop Color="#6155E0" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shell" Property="Opacity" Value="0.92"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Shell" Property="Opacity" Value="0.8"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Shell" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DsCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource DsSurfaceBrush}"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="22"/>
    <Setter Property="BorderBrush" Value="{StaticResource DsBorderSoftBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style x:Key="DsSoftPanel" TargetType="Border">
    <Setter Property="Background" Value="#FAFAFD"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="BorderBrush" Value="{StaticResource DsBorderSoftBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style x:Key="DsBadge" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource DsPrimarySoftBrush}"/>
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!--
    A default TextBlock style, applied by type rather than by key. Without it, anything created
    in code (the grid's cells, message boxes' content) fell back to the system font and the
    Persian text visibly changed face mid-window.
  -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DsFont}"/>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource DsFont}"/>
    <Setter Property="Foreground" Value="{StaticResource DsInkBrush}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style TargetType="DataGrid">
    <Setter Property="FontFamily" Value="{StaticResource DsFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="RowBackground" Value="White"/>
    <Setter Property="AlternatingRowBackground" Value="#FAFAFD"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="#F0EFF7"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="RowHeight" Value="44"/>
  </Style>

  <Style TargetType="DataGridColumnHeader">
    <Setter Property="FontFamily" Value="{StaticResource DsFontBold}"/>
    <Setter Property="Background" Value="#F3F2FA"/>
    <Setter Property="Foreground" Value="{StaticResource DsInkBrush}"/>
    <Setter Property="Padding" Value="10,9"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}"/>
  </Style>

</ResourceDictionary>
