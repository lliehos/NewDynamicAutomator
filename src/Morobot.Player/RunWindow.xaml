<Window x:Class="Morobot.Player.RunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DsWindow}"
        Title="نتیجهٔ اجرا"
        Height="580" Width="800" MinHeight="440" MinWidth="620"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/morobot-icon.jpg">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header: the process, its mode, and the settings it is using. Mirrors the extension HUD's
         title row so the two read the same way. -->
    <DockPanel Grid.Row="0">
      <Border Style="{StaticResource DsBadge}" DockPanel.Dock="Left" Margin="8,0,0,0">
        <TextBlock x:Name="ModeBadge" Text="حالت سرور" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource DsPrimaryBrush}"/>
      </Border>
      <Button x:Name="SettingsButton" DockPanel.Dock="Left" Style="{StaticResource DsButtonGhost}"
              Content="تنظیمات اجرا" Padding="8,3" Click="Settings_Click"/>
      <TextBlock x:Name="TitleText" Style="{StaticResource DsSectionTitle}" HorizontalAlignment="Right"
                 Text="اجرا" VerticalAlignment="Center"/>
    </DockPanel>

    <!-- Status line, exactly the extension HUD's role: the one place that says what is happening. -->
    <Border Grid.Row="1" Background="{StaticResource DsPrimarySoftBrush}" CornerRadius="8" Padding="10,7" Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="ProgressGlyph" Text="▶" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"
                   Foreground="{StaticResource DsPrimaryBrush}"/>
        <TextBlock x:Name="StatusText" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2" Margin="0,8,0,8">
      <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="1"/>
      <TextBlock x:Name="StepText" Style="{StaticResource DsHint}" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- Result list: the same "results + log" idea as the HUD, in one scrollable column. -->
    <Border Grid.Row="3" Style="{StaticResource DsCard}" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="12,8,12,4">
          <TextBlock Text="نتایج اجرا" FontWeight="SemiBold" HorizontalAlignment="Right"/>
          <TextBlock x:Name="ElapsedText" Style="{StaticResource DsHint}" HorizontalAlignment="Left"/>
        </DockPanel>
        <ListBox x:Name="LogList" Grid.Row="1" BorderThickness="0" FontFamily="Consolas, Tahoma" FontSize="11.5"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" Margin="6,0,6,6"/>
      </Grid>
    </Border>

    <!-- Controls: the HUD's play/pause, stop and clear, in the same order. -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
      <Button x:Name="PlayPauseButton" Style="{StaticResource DsButton}" Content="توقف موقت"
              MinWidth="110" Click="PlayPause_Click"/>
      <Button x:Name="StopButton" Style="{StaticResource DsButtonDanger}" Content="توقف"
              MinWidth="100" Margin="8,0,0,0" Click="Stop_Click"/>
      <Button x:Name="ClearButton" Style="{StaticResource DsButtonSecondary}" Content="پاک‌کردن نتایج"
              MinWidth="110" Margin="8,0,0,0" Click="Clear_Click"/>
      <Button x:Name="CloseButton" Style="{StaticResource DsButtonGhost}" Content="بستن"
              MinWidth="90" Margin="8,0,0,0" Click="Close_Click"/>
    </StackPanel>
  </Grid>
</Window>
