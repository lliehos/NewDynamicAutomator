<Window x:Class="Morobot.Player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DsWindow}"
        Title="Morobot Player"
        Height="720" Width="1120" MinHeight="560" MinWidth="900"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/morobot-icon.png">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header. The name is set from branding after sign-in, so it shows the deployment's product
         name rather than the shipped one. -->
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal">
        <Image Source="pack://application:,,,/Assets/morobot-icon.png" Width="34" Height="34" Margin="0,0,10,0"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock x:Name="ProductNameText" Style="{StaticResource DsTitle}" Text="Morobot Player"
                   VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Style="{StaticResource DsHint}" Margin="44,4,0,0"
                 Text="اجرای فرآیندها روی همین سیستم با فایرفاکس — نتیجهٔ اجرا مثل افزونه نمایش داده می‌شود."/>
    </StackPanel>

    <!-- Login panel -->
    <Border x:Name="LoginPanel" Grid.Row="1" Style="{StaticResource DsCard}" VerticalAlignment="Top"
            MaxWidth="560" HorizontalAlignment="Center">
      <StackPanel>
        <TextBlock Style="{StaticResource DsSectionTitle}" Text="ورود به سرور"/>

        <StackPanel Style="{StaticResource DsFieldBlock}">
          <TextBlock Text="آدرس سرور" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBox x:Name="ServerUrlBox" Style="{StaticResource DsTextBox}"
                   Text="https://"/>
          <TextBlock Style="{StaticResource DsHint}" Margin="0,4,0,0"
                     Text="مثلاً https://panel.example.com — همان آدرسی که در مرورگر باز می‌کنید."/>
        </StackPanel>

        <StackPanel Style="{StaticResource DsFieldBlock}">
          <TextBlock Text="نام کاربری" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBox x:Name="UserBox" Style="{StaticResource DsTextBox}"/>
        </StackPanel>

        <StackPanel Style="{StaticResource DsFieldBlock}">
          <TextBlock Text="رمز عبور" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <PasswordBox x:Name="PassBox" Style="{StaticResource DsPasswordBox}"/>
        </StackPanel>

        <CheckBox x:Name="RememberBox" Content="ذخیرهٔ ورود در این سیستم (توکن)" Margin="0,4,0,12"/>

        <Button x:Name="LoginButton" Style="{StaticResource DsButton}" Content="ورود"
                HorizontalAlignment="Right" MinWidth="120" Click="Login_Click"/>

        <TextBlock x:Name="LoginStatus" Style="{StaticResource DsHint}" Margin="0,10,0,0"
                   Foreground="{StaticResource DsDangerBrush}"/>
      </StackPanel>
    </Border>

    <!-- Process list -->
    <Border x:Name="ProcessPanel" Grid.Row="1" Style="{StaticResource DsCard}" Visibility="Collapsed">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
          <Button x:Name="LogoutButton" DockPanel.Dock="Left" Style="{StaticResource DsButtonGhost}"
                  Content="خروج" Click="Logout_Click"/>
          <Button x:Name="RefreshButton" DockPanel.Dock="Left" Style="{StaticResource DsButtonSecondary}"
                  Content="بازخوانی" Margin="0,0,8,0" Click="Refresh_Click"/>
          <TextBlock x:Name="WhoamiText" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Foreground="{StaticResource DsMutedBrush}" Text=""/>
        </DockPanel>

        <TextBlock x:Name="ListStatus" Grid.Row="1" Style="{StaticResource DsHint}" Margin="0,0,0,8"/>

        <DataGrid x:Name="ProcessGrid" Grid.Row="2" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="2*"/>
            <DataGridTextColumn Header="گروه" Binding="{Binding GroupsLabel}" Width="60"/>
            <DataGridTextColumn Header="مرحله" Binding="{Binding StepsLabel}" Width="60"/>
            <DataGridTextColumn Header="منبع" Binding="{Binding SourcesLabel}" Width="60"/>
            <DataGridTextColumn Header="آخرین اجرا" Binding="{Binding LastRunLabel}" Width="140"/>
            <DataGridTemplateColumn Header="اجرا" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding RunOnServer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Content="روی سرور" VerticalAlignment="Center" Margin="6,0"
                            ToolTip="روشن: اجرا روی سرور ثبت می‌شود. خاموش: اجرا کامل روی همین سیستم."/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="عملیات" Width="230">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="اجرا" Style="{StaticResource DsButton}" Padding="10,4" Margin="2,0"
                            Click="RowRun_Click"/>
                    <Button Content="ویرایش" Style="{StaticResource DsButtonSecondary}" Padding="10,4" Margin="2,0"
                            Click="RowEdit_Click"/>
                    <Button Content="سینک" Style="{StaticResource DsButtonSecondary}" Padding="10,4" Margin="2,0"
                            Visibility="{Binding SyncVisibility}" Click="RowSync_Click"
                            ToolTip="نتیجهٔ اجرای محلی را روی سرور بنویس"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <!-- Footer: licence state + updates -->
    <StackPanel Grid.Row="2" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="LicenseText" Style="{StaticResource DsHint}" VerticalAlignment="Center"/>
        <Button x:Name="DriverCheckButton" Style="{StaticResource DsButtonGhost}" Content="بررسی پیش‌نیازها"
                Margin="12,0,0,0" Click="DriverCheck_Click"/>
        <Button x:Name="UpdateButton" Style="{StaticResource DsButtonGhost}" Content="بررسی به‌روزرسانی"
                Margin="8,0,0,0" Click="CheckUpdate_Click"/>
      </StackPanel>
      <TextBlock x:Name="UpdateStatus" Style="{StaticResource DsHint}" Margin="0,6,0,0"/>
    </StackPanel>
  </Grid>
</Window>
