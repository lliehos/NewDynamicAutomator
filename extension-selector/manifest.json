{
  "manifest_version": 3,
  "name": "Morobot Selector",
  "version": "1.1.0",
  "description": "۶ حالت کپی سلکتور (یونیک/نسبی) + سایدبار DevTools — مروبات",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "activeTab",
    "webNavigation",
    "contextMenus",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "devtools_page": "devtools.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "سلکتور — مروبات",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/selector.js", "content/frames.js", "content/context-selector.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/portal-bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
