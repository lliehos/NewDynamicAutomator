{
  "manifest_version": 3,
  "name": "Morobot Recorder",
  "version": "0.9.1",
  "description": "ضبط و اجرای فرآیند مروبات روی صفحات فریم‌تو‌فریم",
  "permissions": ["storage", "cookies", "scripting", "webNavigation", "tabs", "activeTab", "windows", "contextMenus", "clipboardWrite"],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "مروبات",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/selector.js", "content/frames.js", "content/context-selector.js", "content/recorder.js", "content/player.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/fab.js"],
      "css": ["styles/fab.css"],
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": ["content/portal-bridge.js", "content/portal-ui.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
