{
  "manifest_version": 3,
  "name": "Dynamic Automator Recorder",
  "version": "1.0.1",
  "description": "ضبط فرآیند روی صفحات — جدا از افزونهٔ اجرا",
  "permissions": ["storage", "cookies", "scripting", "webNavigation", "tabs", "activeTab", "windows"],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ضبط — اتوماتور پویا"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/selector.js", "content/frames.js", "content/recorder.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/fab.js"],
      "css": ["styles/fab.css"],
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": ["content/portal-bridge.js", "content/portal-ui.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
